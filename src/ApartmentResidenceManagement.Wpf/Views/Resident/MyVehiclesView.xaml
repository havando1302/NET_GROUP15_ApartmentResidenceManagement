<UserControl x:Class="ApartmentResidenceManagement.Wpf.Views.MyVehiclesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ApartmentResidenceManagement.Wpf.Controls"
             xmlns:behaviors="clr-namespace:ApartmentResidenceManagement.Wpf.Behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:enums="clr-namespace:ApartmentResidenceManagement.Domain.Enums;assembly=ApartmentResidenceManagement.Domain"
             xmlns:converters="clr-namespace:ApartmentResidenceManagement.Wpf.Converters"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="950"
             Background="{StaticResource PageBgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:StringToVisibilityConverter x:Key="StringToVis"/>
        <converters:InverseStringToVisibilityConverter x:Key="InverseStringToVis"/>
        <!-- DataGrid Header — Blue Resident -->
        <Style x:Key="ResidentGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E3F2FD"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimarySoftBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- DataGrid Row -->
        <Style x:Key="ResidentGridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#F1F1F1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="42"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Form TextBox -->
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource PrimarySoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource PrimaryBlueBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Form ComboBox -->
        <Style x:Key="FormComboBox" TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="ResidentPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBlueBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#ECEFF1"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CFD8DC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- GridActionBtn -->
        <Style x:Key="GridActionBtn" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="4" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ===== CỘT TRÁI: DANH SÁCH ===== -->
        <Grid Grid.Column="0" Margin="24,20,12,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Header -->
                <RowDefinition Height="Auto"/>  <!-- Toolbar -->
                <RowDefinition Height="Auto"/>  <!-- Error -->
                <RowDefinition Height="*"/>     <!-- DataGrid -->
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Phương tiện của tôi" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryDarkBrush}"/>
                    <TextBlock Text="Đăng ký và quản lý các phương tiện cá nhân được phép sử dụng bãi xe."
                               FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="20" Padding="12,4"
                        Background="#E3F2FD" VerticalAlignment="Center">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}">
                        <Run Text="Tổng: "/>
                        <Run Text="{Binding Vehicles.Count, Mode=OneWay}"/>
                        <Run Text=" phương tiện"/>
                    </TextBlock>
                </Border>
            </Grid>

            <!-- TOOLBAR: Tìm kiếm | Lọc loại | Nút -->
            <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" Direction="0" ShadowDepth="0" Color="#000000" Opacity="0.04"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tìm kiếm -->
                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                        <TextBlock Text="Tìm kiếm xe" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <Border Background="#F8FAFC" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Height="38">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconMaterial Grid.Column="0" Kind="Magnify" Width="15" Height="15" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0" VerticalAlignment="Center" FontSize="13"
                                         Foreground="{StaticResource TextDarkBrush}" Padding="0,0,4,0"/>
                                <TextBlock Grid.Column="1" Text="Tìm theo biển số, hãng xe, màu xe..." FontSize="12.5" Foreground="#94A3B8"
                                           VerticalAlignment="Center" IsHitTestVisible="False" Margin="4,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="2" Command="{Binding ClearSearchCommand}"
                                        Cursor="Hand" VerticalAlignment="Center" HorizontalAlignment="Right"
                                        Margin="0,0,8,0" Width="20" Height="20" Background="Transparent"
                                        BorderThickness="0" ToolTip="Xóa tìm kiếm">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Width="18" Height="18">
                                                            <iconPacks:PackIconMaterial Kind="CloseCircle" Width="13" Height="13" Foreground="#94A3B8"
                                                                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Lọc Loại xe -->
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Loại phương tiện" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <ComboBox Style="{StaticResource FormComboBox}"
                                  ItemsSource="{Binding TypeFilterOptions}"
                                  SelectedItem="{Binding SelectedTypeFilter}"/>
                    </StackPanel>

                    <!-- Nút Làm mới -->
                    <Button Grid.Column="2" Style="{StaticResource SecondaryBtn}"
                            Content="↻  Làm mới" VerticalAlignment="Bottom"
                            Command="{Binding LoadVehiclesCommand}" Margin="0,0,8,0"/>

                    <!-- Nút Đăng ký xe -->
                    <Button Grid.Column="3" Style="{StaticResource ResidentPrimaryBtn}"
                            Content="＋  Đăng ký xe mới" VerticalAlignment="Bottom"
                            Command="{Binding OpenAddFormCommand}"/>
                </Grid>
            </Border>

            <!-- ERROR ALERT -->


            <!-- DATA GRID CONTAINER -->
            <Border Grid.Row="3" Background="White" CornerRadius="10" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" Direction="0" ShadowDepth="0" Color="#000000" Opacity="0.04"/>
                </Border.Effect>
                <Grid>
                    <!-- Loading State -->
                    <Border Background="White" CornerRadius="10" Panel.ZIndex="10"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="⏳" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Đang tải danh sách phương tiện..." FontSize="14"
                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Empty State (Chưa có căn hộ) -->
                    <Border Background="White" CornerRadius="10" Panel.ZIndex="7">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasApartment}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="450">
                            <TextBlock Text="⚠️" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Chưa có căn hộ đăng ký" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryDarkBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Vui lòng liên hệ Ban Quản Lý để được cập nhật thông tin căn hộ trước khi quản lý phương tiện cá nhân."
                                       FontSize="13" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Empty State (Chưa có xe) -->
                    <Border Background="White" CornerRadius="10" Panel.ZIndex="5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsLoading}" Value="False"/>
                                            <Condition Binding="{Binding HasApartment}" Value="True"/>
                                            <Condition Binding="{Binding Vehicles.Count}" Value="0"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🏍" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Chưa đăng ký phương tiện nào" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Hãy bấm Đăng ký xe mới ở trên." FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid behaviors:DataGridRowNumbers.IsEnabled="True" ItemsSource="{Binding Vehicles}"
                              SelectedItem="{Binding SelectedVehicle}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              ColumnHeaderStyle="{StaticResource ResidentGridHeader}"
                              RowStyle="{StaticResource ResidentGridRow}"
                              GridLinesVisibility="None"
                              BorderThickness="0"
                              Background="Transparent"
                              SelectionMode="Single"
                              VirtualizingPanel.IsVirtualizing="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>

                            <!-- STT -->
                            <DataGridTemplateColumn Header="#" Width="50">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ResidentGridHeader}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Path=(behaviors:DataGridRowNumbers.RowNumber), RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Hình ảnh xe -->
                            <DataGridTemplateColumn Header="Hình ảnh" Width="70">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ResidentGridHeader}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="38" Height="38" CornerRadius="8" Background="#F8FAFC"
                                                BorderBrush="#CBD5E1" BorderThickness="1" ClipToBounds="True"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"
                                                ToolTip="Bấm để xem ảnh phương tiện phóng to rõ nét">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.OpenImageZoomCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <Grid>
                                                <Image Source="{Binding ImagePath}" Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       RenderOptions.EdgeMode="Aliased"
                                                       Visibility="{Binding ImagePath, Converter={StaticResource StringToVis}}"/>
                                                <TextBlock FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding ImagePath, Converter={StaticResource InverseStringToVis}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="🏍"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding VehicleType}" Value="{x:Static enums:VehicleType.Car}">
                                                                    <Setter Property="Text" Value="🚗"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding VehicleType}" Value="{x:Static enums:VehicleType.Bicycle}">
                                                                    <Setter Property="Text" Value="🚲"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Biển Số Xe (Căn giữa, in đậm) -->
                            <DataGridTextColumn Header="Biển số xe" Binding="{Binding LicensePlate}" Width="2*">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ResidentGridHeader}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Loại Xe (Căn giữa - Badge) -->
                            <DataGridTemplateColumn Header="Loại xe" Width="1.8*">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ResidentGridHeader}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding VehicleType}" Value="{x:Static enums:VehicleType.Car}">
                                                            <Setter Property="Background" Value="#E8F5E9"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding VehicleType}" Value="{x:Static enums:VehicleType.Moto}">
                                                            <Setter Property="Background" Value="#E3F2FD"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding VehicleType}" Value="{x:Static enums:VehicleType.Bicycle}">
                                                            <Setter Property="Background" Value="#FFF3E0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontWeight="SemiBold" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding VehicleType}" Value="{x:Static enums:VehicleType.Car}">
                                                                <Setter Property="Text" Value="🚗 Ô tô"/>
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding VehicleType}" Value="{x:Static enums:VehicleType.Moto}">
                                                                <Setter Property="Text" Value="🏍 Xe máy"/>
                                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBlueBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding VehicleType}" Value="{x:Static enums:VehicleType.Bicycle}">
                                                                <Setter Property="Text" Value="🚲 Xe đạp"/>
                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Hiệu Xe (Căn trái, padding 12px) -->
                            <DataGridTextColumn Header="Nhãn hiệu" Binding="{Binding Brand}" Width="1.5*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="12,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Màu xe -->
                            <DataGridTextColumn Header="Màu xe" Binding="{Binding Color}" Width="1.2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="12,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Trạng thái" Width="1.6*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Border CornerRadius="12" Padding="8,3" HorizontalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#FFF3E0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RegistrationStatus}" Value="{x:Static enums:VehicleRegistrationStatus.Approved}">
                                                                <Setter Property="Background" Value="#E8F5E9"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RegistrationStatus}" Value="{x:Static enums:VehicleRegistrationStatus.Rejected}">
                                                                <Setter Property="Background" Value="#FFEBEE"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="12" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Chờ duyệt"/>
                                                            <Setter Property="Foreground" Value="#E65100"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RegistrationStatus}" Value="{x:Static enums:VehicleRegistrationStatus.Approved}">
                                                                    <Setter Property="Text" Value="Đã duyệt"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RegistrationStatus}" Value="{x:Static enums:VehicleRegistrationStatus.Rejected}">
                                                                    <Setter Property="Text" Value="Từ chối"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <!-- Hiển thị lý do từ chối nếu có -->
                                            <TextBlock Text="{Binding RejectReason, StringFormat='Lý do: {0}'}"
                                                       FontSize="11" Foreground="#DC2626" TextTrimming="CharacterEllipsis"
                                                       MaxWidth="130" HorizontalAlignment="Center" Margin="0,2,0,0"
                                                       ToolTip="{Binding RejectReason}"
                                                       Visibility="{Binding RejectReason, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Thao tác (Căn giữa) -->
                            <DataGridTemplateColumn Header="Thao tác" Width="2*">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ResidentGridHeader}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- Sửa -->
                                            <Button Style="{StaticResource GridActionBtn}"
                                                    Background="#FFF3E0" Foreground="#E65100"
                                                    Content="Sửa" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.OpenEditFormCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <!-- Hủy đăng ký -->
                                            <Button Style="{StaticResource GridActionBtn}"
                                                    Background="#FFEBEE" Foreground="{StaticResource ErrorBrush}"
                                                    Content="Hủy đăng ký"
                                                    Command="{Binding DataContext.DeleteVehicleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== CỘT PHẢI: FORM ĐĂNG KÝ MODAL OVERLAY ===== -->
        <Grid x:Name="VehicleFormOverlay" Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="200"
              Visibility="{Binding IsFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}">

            <!-- Lớp phủ mờ -->
            <Border Background="#66000000">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CancelFormCommand}"/>
                </Border.InputBindings>
            </Border>

            <!-- Card Dialog nổi ở trung tâm -->
            <Border MaxWidth="410" Background="White" CornerRadius="10" Padding="24" Margin="16,24"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Direction="0" ShadowDepth="0" Color="#000000" Opacity="0.15"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <Border Width="40" Height="4" CornerRadius="2"
                                Background="{StaticResource PrimaryBlueBrush}"
                                HorizontalAlignment="Left" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding FormTitle}" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryDarkBrush}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Cảnh báo lý do từ chối trước đó nếu có -->
                        <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8"
                                Padding="12,8" Margin="0,0,0,14"
                                Visibility="{Binding EditingVehicle.RejectReason, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="⚠️ Lý do bị từ chối duyệt trước đó:" FontSize="11.5" FontWeight="Bold" Foreground="#DC2626"/>
                                <TextBlock Text="{Binding EditingVehicle.RejectReason}" FontSize="12" Foreground="#991B1B"
                                           Margin="0,3,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="Vui lòng kiểm tra lại thông tin và bấm Lưu để gửi duyệt lại."
                                           FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Biển số xe -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Biển số xe (Ví dụ: 30A-12345)" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                            <TextBox Style="{StaticResource FormTextBox}"
                                     Text="{Binding EditingVehicle.LicensePlate, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Loại xe -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Loại phương tiện" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                            <ComboBox Style="{StaticResource FormComboBox}"
                                      ItemsSource="{Binding VehicleTypes}"
                                      SelectedItem="{Binding EditingVehicle.VehicleType}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="{x:Static enums:VehicleType.Car}">
                                                            <Setter Property="Text" Value="🚗 Ô tô"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding}" Value="{x:Static enums:VehicleType.Moto}">
                                                            <Setter Property="Text" Value="🏍 Xe máy"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding}" Value="{x:Static enums:VehicleType.Bicycle}">
                                                            <Setter Property="Text" Value="🚲 Xe đạp"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Hiệu xe -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Hiệu xe / Hãng sản xuất" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                            <TextBox Style="{StaticResource FormTextBox}"
                                     Text="{Binding EditingVehicle.Brand, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Màu xe -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Màu xe (Ví dụ: Đen, Trắng, Đỏ...)" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                            <TextBox Style="{StaticResource FormTextBox}"
                                     Text="{Binding EditingVehicle.Color, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Hình ảnh xe (Bắt buộc, xem trước sắc nét cạnh nút tải lên) -->
                        <StackPanel Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Hình ảnh phương tiện" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0"/>
                                <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Text="(Bắt buộc tải ảnh thật)" Foreground="#64748B" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="📁 Tải ảnh lên..." Style="{StaticResource SecondaryBtn}"
                                            Command="{Binding SelectImageCommand}" Height="36" Padding="12,0" Margin="0,0,12,0"/>

                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <!-- Khi đã chọn ảnh -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                    Visibility="{Binding HasSelectedImage, Converter={StaticResource BoolToVis}}">
                                            <Border Width="50" Height="50" CornerRadius="8" Background="White"
                                                    BorderBrush="#CBD5E1" BorderThickness="1" ClipToBounds="True"
                                                    Cursor="Hand" ToolTip="Nhấn vào ảnh để xem phóng to rõ nét">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding OpenImageZoomCommand}"
                                                                  CommandParameter="{Binding SelectedImagePath}"/>
                                                </Border.InputBindings>
                                                <Image Source="{Binding SelectedImagePath}" Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       RenderOptions.EdgeMode="Aliased"/>
                                            </Border>

                                            <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                                <TextBlock Text="Đã chọn ảnh xe" FontSize="11.5" FontWeight="SemiBold" Foreground="#16A34A"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <Button Command="{Binding OpenImageZoomCommand}" CommandParameter="{Binding SelectedImagePath}"
                                                            Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Margin="0,0,8,0">
                                                        <TextBlock Text="👁️ Phóng to" FontSize="11" Foreground="#2563EB" TextDecorations="Underline"/>
                                                    </Button>
                                                    <Button Command="{Binding ClearSelectedImageCommand}"
                                                            Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                                        <TextBlock Text="✕ Xóa" FontSize="11" Foreground="#DC2626"/>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Khi chưa có ảnh -->
                                        <TextBlock Text="Chưa chọn tệp ảnh nào (Bắt buộc)" FontSize="11.5" Foreground="#DC2626" FontStyle="Italic" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasSelectedImage}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <controls:NotificationBanner Kind="Information"
                                                     Message="Mọi phương tiện sẽ được Văn Phòng Quản Lý phê duyệt trước khi cấp thẻ vào bãi."/>
                    </StackPanel>
                    </ScrollViewer>

                    <!-- Validation stays inside the active dialog, above its actions. -->
                    <Grid Grid.Row="2" Margin="0,20,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Hủy" Style="{StaticResource SecondaryBtn}" Margin="0,0,6,0"
                                    Command="{Binding CancelFormCommand}"/>
                            <Button Grid.Column="1" Content="Lưu" Style="{StaticResource ResidentPrimaryBtn}" Margin="6,0,0,0"
                                    Command="{Binding SaveVehicleCommand}"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <!-- ════════ MODAL PHÓNG TO ẢNH PHƯƠNG TIỆN (LIGHTBOX) ════════ -->
        <Grid Visibility="{Binding IsImageZoomOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="99990">
            <!-- Backdrop -->
            <Border Background="#80000000">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseImageZoomCommand}"/>
                </Border.InputBindings>
            </Border>

            <!-- Modal Card -->
            <Border Width="640" MaxHeight="600" Background="White" CornerRadius="16" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📷" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ZoomedImageTitle}" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                        </StackPanel>
                        <Button Command="{Binding CloseImageZoomCommand}" HorizontalAlignment="Right"
                                Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Hand">
                            <TextBlock Text="✕" FontSize="16" FontWeight="Bold" Foreground="#64748B"/>
                        </Button>
                    </Grid>

                    <!-- Zoomed Image Container -->
                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="12" ClipToBounds="True" MaxHeight="440" Padding="6">
                        <Image Source="{Binding ZoomedImagePath}" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               RenderOptions.EdgeMode="Aliased"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Footer Button -->
                    <Button Grid.Row="2" Command="{Binding CloseImageZoomCommand}" Content="Đóng"
                            HorizontalAlignment="Right" Margin="0,14,0,0" Width="90" Height="36"
                            Background="#F1F5F9" Foreground="#334155" FontSize="13" FontWeight="SemiBold"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- FLOATING TOAST NOTIFICATIONS (GÓC DƯỚI BÊN PHẢI - 3S) -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,28,24" Panel.ZIndex="99999" IsHitTestVisible="True">
            <controls:NotificationBanner Message="{Binding ErrorMessage}" Kind="Error"/>
        </StackPanel>
    </Grid>
</UserControl>
