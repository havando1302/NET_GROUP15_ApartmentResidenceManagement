<UserControl x:Class="ApartmentResidenceManagement.Wpf.Views.FamilyMembersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ApartmentResidenceManagement.Wpf.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="1100"
             FontFamily="Segoe UI"
             Background="#F8FAFC">

    <UserControl.Resources>
        <!-- Modern Card Style -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="3" Color="#0F172A" Opacity="0.04"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Detail Field Title -->
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Detail Field Value -->
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="32,24,32,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Page Header -->
                    <RowDefinition Height="Auto"/> <!-- Success Banner -->
                    <RowDefinition Height="Auto"/> <!-- Top Apartment Summary Banner -->
                    <RowDefinition Height="18"/>   <!-- Spacer -->
                    <RowDefinition Height="*"/>    <!-- Members List Accordion Card -->
                </Grid.RowDefinitions>

                <!-- ══════════════════════════════════════════════════════════
                     1. TIÊU ĐỀ TRANG
                ══════════════════════════════════════════════════════════ -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="👥" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Thành viên cùng căn hộ" FontSize="22" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Quản lý và cập nhật thông tin các thành viên đang cư trú tại căn hộ của bạn."
                               FontSize="13" Foreground="#64748B" Margin="32,3,0,0"/>
                </StackPanel>

                <!-- THÔNG BÁO CẬP NHẬT THÀNH CÔNG -->
                <Border Grid.Row="1" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10"
                        Padding="14,10" Margin="0,0,0,16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EditSuccessMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding EditSuccessMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓" FontSize="14" FontWeight="Bold" Foreground="#16A34A" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding EditSuccessMessage}" FontSize="13" Foreground="#15803D" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ══════════════════════════════════════════════════════════
                     2. BANNER TÓM TẮT THÔNG TIN CĂN HỘ
                ══════════════════════════════════════════════════════════ -->
                <Border Grid.Row="2" CornerRadius="16" Padding="20,16" BorderBrush="#DBEAFE" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#EFF6FF" Offset="0.0"/>
                        <GradientStop Color="#F0FDF4" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Ảnh tòa nhà bo góc -->
                    <Border Grid.Column="0" CornerRadius="12" ClipToBounds="True" Width="80" Height="80" VerticalAlignment="Center">
                        <Image Source="/Assets/apartment_building.jpg" Stretch="UniformToFill"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Thông tin căn hộ -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Thông tin căn hộ" FontSize="12" Foreground="#64748B"/>
                        <TextBlock Text="{Binding ApartmentNumber, StringFormat='Căn hộ {0}'}"
                                   FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏢 Tòa " FontSize="12.5" Foreground="#64748B"/>
                            <TextBlock Text="{Binding BuildingBlock}" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="   |   📶 Tầng " FontSize="12.5" Foreground="#64748B"/>
                            <TextBlock Text="{Binding FloorNumber}" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="   |   📐 Diện tích: " FontSize="12.5" Foreground="#64748B"/>
                            <TextBlock Text="{Binding ApartmentArea}" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Thống kê bên phải: Số nhân khẩu & Badge trạng thái -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                            <Border Width="38" Height="38" CornerRadius="19" Background="#EFF6FF" Margin="0,0,8,0">
                                <TextBlock Text="👥" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding TotalMembers}" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Thành viên đang cư trú" FontSize="11.5" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Badge xanh lá -->
                        <Border Background="#DCFCE7" CornerRadius="12" Padding="12,6" VerticalAlignment="Center">
                            <TextBlock Text="✓  Đang cư trú" FontSize="12" FontWeight="Bold" Foreground="#16A34A"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 4. DANH SÁCH THÀNH VIÊN KIỂU ACCORDION CÓ TÌM KIẾM
            ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="4" Style="{StaticResource ModernCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header + Search Box -->
                        <RowDefinition Height="18"/>   <!-- Spacer -->
                        <RowDefinition Height="*"/>    <!-- Accordion Items -->
                    </Grid.RowDefinitions>

                    <!-- Header card & Search Box -->
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👥" FontSize="17" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Danh sách thành viên (" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalMembers}" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <TextBlock Text=")" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Ô tìm kiếm thời gian thực -->
                        <Border HorizontalAlignment="Right" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5"
                                CornerRadius="10" Width="260" Height="38" Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent" FontSize="13" VerticalAlignment="Center"
                                         VerticalContentAlignment="Center"/>
                                <!-- Placeholder -->
                                <TextBlock Grid.Column="1" Text="Tìm kiếm thành viên..." FontSize="13" Foreground="#94A3B8"
                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Danh sách các thẻ thành viên Accordion -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding FilteredMembers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14"
                                        Margin="0,0,0,12" Padding="16,14">
                                    <StackPanel>
                                        <!-- Header Accordion: Click để mở rộng/thu gọn -->
                                        <Grid Cursor="Hand">
                                            <Grid.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleExpandCommand}"/>
                                            </Grid.InputBindings>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Avatar Icon / Real Photo -->
                                            <Border Grid.Column="0" Width="46" Height="46" CornerRadius="23" Background="#EFF6FF"
                                                    BorderBrush="#BFDBFE" BorderThickness="1.5" VerticalAlignment="Center" ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding AvatarImagePath}" Stretch="UniformToFill"
                                                           Visibility="{Binding HasAvatarImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <TextBlock Text="{Binding AvatarIcon}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasAvatarImage}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>

                                            <!-- Tên + Quan hệ + Badge Chủ hộ -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding FullName}" FontSize="15" FontWeight="Bold" Foreground="#0F172A"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <!-- Badge Chủ hộ nếu là Owner -->
                                                    <Border Margin="10,0,0,0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                                            CornerRadius="6" Padding="6,2" VerticalAlignment="Center"
                                                            Visibility="{Binding IsOwner, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="👑 Chủ hộ" FontSize="11" FontWeight="Bold" Foreground="#2563EB"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Relationship, StringFormat='Quan hệ: {0}'}"
                                                           FontSize="12.5" Foreground="#64748B" Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <!-- Badge Trạng thái + Nút Sửa (icon bút) -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#DCFCE7" CornerRadius="10" Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="#16A34A"/>
                                                </Border>

                                            </StackPanel>

                                            <!-- Mũi tên mở rộng / thu gọn ᐯ / ᐱ -->
                                            <Border Grid.Column="5" Width="30" Height="30" CornerRadius="15" Background="#F8FAFC"
                                                    BorderBrush="#E2E8F0" BorderThickness="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ExpandIcon}" FontSize="11" FontWeight="Bold" Foreground="#64748B"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <!-- Nội dung chi tiết mở rộng (Accordion Body) -->
                                        <Border Margin="0,14,0,0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                                CornerRadius="10" Padding="18,14"
                                                Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <!-- Tiêu đề nhỏ -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <TextBlock Text="📋" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Thông tin chi tiết" FontSize="12.5" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Lưới thông tin 2 cột -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="24"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="10"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="10"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Hàng 0: Ngày sinh | Giới tính -->
                                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                                        <TextBlock Text="📅 Ngày sinh: " Style="{StaticResource DetailLabel}"/>
                                                        <TextBlock Text="{Binding BirthDate}" Style="{StaticResource DetailValue}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                                                        <TextBlock Text="⚧ Giới tính: " Style="{StaticResource DetailLabel}"/>
                                                        <TextBlock Text="{Binding Gender}" Style="{StaticResource DetailValue}"/>
                                                    </StackPanel>

                                                    <!-- Hàng 2: Số CCCD | Quê quán -->
                                                    <DockPanel Grid.Row="2" Grid.Column="0">
                                                        <TextBlock Text="🪪 Số CCCD: " Style="{StaticResource DetailLabel}" DockPanel.Dock="Left"/>
                                                        <TextBlock Text="{Binding IdentityCard}" Style="{StaticResource DetailValue}"/>
                                                    </DockPanel>
                                                    <DockPanel Grid.Row="2" Grid.Column="2">
                                                        <TextBlock Text="🏠 Quê quán: " Style="{StaticResource DetailLabel}" DockPanel.Dock="Left"/>
                                                        <TextBlock Text="{Binding Hometown}" Style="{StaticResource DetailValue}" TextWrapping="Wrap"/>
                                                    </DockPanel>

                                                    <!-- Hàng 4: Số điện thoại | Quan hệ -->
                                                    <DockPanel Grid.Row="4" Grid.Column="0">
                                                        <TextBlock Text="📞 Số điện thoại: " Style="{StaticResource DetailLabel}" DockPanel.Dock="Left"/>
                                                        <TextBlock Text="{Binding PhoneNumber}" Style="{StaticResource DetailValue}"/>
                                                    </DockPanel>
                                                    <DockPanel Grid.Row="4" Grid.Column="2">
                                                        <TextBlock Text="👥 Quan hệ: " Style="{StaticResource DetailLabel}" DockPanel.Dock="Left"/>
                                                        <TextBlock Text="{Binding Relationship}" Style="{StaticResource DetailValue}" TextWrapping="Wrap"/>
                                                    </DockPanel>
                                                </Grid>

                                                <!-- Nút mở modal chỉnh sửa trong accordion body -->
                                                <Button HorizontalAlignment="Right" Margin="0,14,0,0"
                                                        Command="{Binding DataContext.OpenEditMemberModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                                        Padding="14,6" Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="✏️" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="Chỉnh sửa thông tin thành viên này" FontSize="12.5" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>

    <!-- ══════════════════════════════════════════════════════════════════
         MODAL OVERLAY: DIALOG CHỈNH SỬA THÔNG TIN THÀNH VIÊN GIA ĐÌNH
    ══════════════════════════════════════════════════════════════════ -->
    <Grid Visibility="{Binding IsEditMemberModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
          Panel.ZIndex="200">
        <!-- Backdrop tối mờ -->
        <Border Background="#88000000">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding CloseEditMemberModalCommand}"/>
            </Border.InputBindings>
        </Border>

        <!-- Hộp Modal màu trắng nổi bật -->
        <Border Width="480" Background="White" CornerRadius="18" Padding="28"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="8" Color="#000000" Opacity="0.28"/>
            </Border.Effect>

            <StackPanel>
                <!-- Modal Header -->
                <Grid Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="18" Background="#EFF6FF" Margin="0,0,10,0">
                            <TextBlock Text="✏️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Chỉnh sửa thông tin thành viên" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="{Binding EditMemberFullName, StringFormat='Cập nhật thông tin cho {0}'}" FontSize="12" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>

                    <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                            Command="{Binding CloseEditMemberModalCommand}"
                            Background="#F1F5F9" BorderThickness="0" Width="30" Height="30" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="15" Background="{TemplateBinding Background}">
                                    <TextBlock Text="✕" FontSize="13" FontWeight="Bold" Foreground="#64748B"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <Rectangle Height="1" Fill="#F1F5F9" Margin="0,0,0,16"/>

                <!-- Banner thành viên và quan hệ -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,16">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding EditMemberFullName}" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Background="#EFF6FF" CornerRadius="6" Padding="8,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding EditMemberRelationship, StringFormat='Quan hệ: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Lỗi nếu có -->
                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8"
                        Padding="12,8" Margin="0,0,0,14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EditErrorMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding EditErrorMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding EditErrorMessage}" Foreground="#DC2626" FontSize="12.5" FontWeight="SemiBold"/>
                </Border>

                <!-- Trường 1: Số điện thoại -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Số điện thoại liên lạc" FontSize="12.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="9" Height="42" Padding="10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📞" FontSize="14" Foreground="#64748B" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding EditMemberPhone, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent" FontSize="13.5" FontWeight="SemiBold"
                                     VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Trường 2: Trạng thái cư trú -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Trạng thái cư trú" FontSize="12.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding AvailableStatuses}" SelectedItem="{Binding EditMemberStatus}"
                              Height="42" FontSize="13.5" FontWeight="SemiBold" VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Ghi chú định danh cố định -->
                <Border Background="#F1F5F9" CornerRadius="8" Padding="10,8" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔒" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="CCCD, Ngày sinh, Giới tính và Quê quán là định danh pháp lý cố định." FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Action Buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding CloseEditMemberModalCommand}"
                            Height="42" Background="#F1F5F9" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="9" Background="{TemplateBinding Background}">
                                    <TextBlock Text="Hủy bỏ" FontSize="13.5" FontWeight="SemiBold" Foreground="#475569"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="2" Command="{Binding SaveMemberEditCommand}"
                            Height="42" Background="#2563EB" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="9" Background="{TemplateBinding Background}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="💾" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Lưu thay đổi" FontSize="13.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Grid>
</UserControl>
