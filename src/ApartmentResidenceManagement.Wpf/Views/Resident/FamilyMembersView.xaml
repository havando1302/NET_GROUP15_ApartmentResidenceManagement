<UserControl x:Class="ApartmentResidenceManagement.Wpf.Views.FamilyMembersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200"
             FontFamily="Segoe UI"
             Background="#F8FAFC">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Error Text Helper Style -->
        <Style x:Key="FieldErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EF4444"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="2,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modal Form Input Label -->
        <Style x:Key="ModalFormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="32,24,32,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Page Title -->
                    <RowDefinition Height="Auto"/> <!-- Notification Banner -->
                    <RowDefinition Height="Auto"/> <!-- Top Apartment Summary Banner -->
                    <RowDefinition Height="*"/>    <!-- 2 Columns Container -->
                </Grid.RowDefinitions>

                <!-- ══════════════════════════════════════════════════════════
                     1. TIÊU ĐỀ TRANG
                ══════════════════════════════════════════════════════════ -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="👥" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Thành viên cùng căn hộ" FontSize="22" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Quản lý và theo dõi thông tin các thành viên đang cư trú tại căn hộ của bạn."
                               FontSize="13" Foreground="#64748B" Margin="30,3,0,0"/>
                </StackPanel>

                <!-- ══════════════════════════════════════════════════════════
                     THÔNG BÁO THÀNH CÔNG / THÔNG ĐIỆP
                ══════════════════════════════════════════════════════════ -->
                <StackPanel Grid.Row="1" Margin="0,0,0,14">
                    <!-- Sửa thành viên thành công -->
                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10"
                            Padding="14,10" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EditSuccessMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EditSuccessMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" FontSize="14" FontWeight="Bold" Foreground="#16A34A" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding EditSuccessMessage}" FontSize="13" Foreground="#15803D" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Gửi yêu cầu thêm thành viên thành công -->
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10"
                            Padding="14,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AddRequestSuccessMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AddRequestSuccessMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" FontSize="14" FontWeight="Bold" Foreground="#2563EB" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AddRequestSuccessMessage}" FontSize="13" Foreground="#1D4ED8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ══════════════════════════════════════════════════════════
                     2. BANNER TÓM TẮT THÔNG TIN CĂN HỘ (Chuẩn 100% Mockup)
                ══════════════════════════════════════════════════════════ -->
                <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="20,16" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#000000" Opacity="0.04"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Thumbnail Căn Hộ -->
                        <Border Grid.Column="0" Width="120" Height="84" CornerRadius="12" ClipToBounds="True" Margin="0,0,18,0">
                            <Image Source="/Assets/apartment_interior.jpg" Stretch="UniformToFill"/>
                        </Border>

                        <!-- Thông tin Căn Hộ -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Thông tin căn hộ" FontSize="12" Foreground="#64748B" Margin="0,0,0,2"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Căn hộ " FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="{Binding ApartmentNumber}" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏢 Tòa " FontSize="12.5" Foreground="#64748B"/>
                                <TextBlock Text="{Binding BuildingBlock}" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                                <TextBlock Text="   |   📶 Tầng " FontSize="12.5" Foreground="#64748B"/>
                                <TextBlock Text="{Binding FloorNumber}" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                                <TextBlock Text="   |   📐 Diện tích: " FontSize="12.5" Foreground="#64748B"/>
                                <TextBlock Text="{Binding ApartmentArea}" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Đường kẻ ngăn cách -->
                        <Rectangle Grid.Column="2" Width="1" Fill="#E2E8F0" Height="54" Margin="24,0,28,0" VerticalAlignment="Center"/>

                        <!-- Số lượng thành viên & Trạng thái -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👥" FontSize="20" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="{Binding TotalMembers}" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Thành viên đang cư trú" FontSize="11.5" Foreground="#64748B"/>
                            </StackPanel>
                            <Border Background="#DCFCE7" CornerRadius="12" Padding="12,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✓ " FontSize="12" FontWeight="Bold" Foreground="#16A34A"/>
                                    <TextBlock Text="Đang cư trú" FontSize="12" FontWeight="Bold" Foreground="#16A34A"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════════════════════
                     3. KHUNG 2 CỘT: DANH SÁCH THÀNH VIÊN VÀ YÊU CẦU CỦA TÔI
                ══════════════════════════════════════════════════════════ -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="0.85*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ══════════════════════════════════════════════════════════
                         CỘT TRÁI: DANH SÁCH THÀNH VIÊN HIỆN TẠI
                    ══════════════════════════════════════════════════════════ -->
                    <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#000000" Opacity="0.04"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Header -->
                                <RowDefinition Height="16"/>   <!-- Spacer -->
                                <RowDefinition Height="*"/>    <!-- Cards List -->
                            </Grid.RowDefinitions>

                            <!-- Header: Tiêu đề bên trái, nút "+ Yêu cầu thêm thành viên" bên phải -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="👥" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Danh sách thành viên (" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalMembers}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    <TextBlock Text=")" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Nút "+ Yêu cầu thêm thành viên" theo đúng mockup -->
                                <Button Grid.Column="1" Command="{Binding OpenAddRequestModalCommand}"
                                        Background="#2563EB" Foreground="White" BorderThickness="0"
                                        FontWeight="SemiBold" FontSize="13" Height="36" Padding="14,0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="⊕ " FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Yêu cầu thêm thành viên" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#1D4ED8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- Danh sách thẻ thành viên -->
                            <ItemsControl Grid.Row="2" ItemsSource="{Binding FilteredMembers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12"
                                                Padding="14,12" Margin="0,0,0,10" Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" 
                                                              Command="{Binding DataContext.OpenEditMemberModalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="#BFDBFE"/>
                                                            <Setter Property="Background" Value="#F8FAFC"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Avatar tròn -->
                                                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="#F1F5F9"
                                                        ClipToBounds="True" Margin="0,0,14,0" VerticalAlignment="Center">
                                                    <Image Source="{Binding AvatarImagePath}" Stretch="UniformToFill"/>
                                                </Border>

                                                <!-- Tên & Quan hệ -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FullName}" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                        <!-- Huy hiệu Chủ hộ -->
                                                        <Border Background="#EFF6FF" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding IsOwner, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="👑 " FontSize="10" Foreground="#2563EB"/>
                                                                <TextBlock Text="Chủ hộ" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Relationship, StringFormat='Quan hệ: {0}'}"
                                                               FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
                                                </StackPanel>

                                                <!-- Trạng thái cư trú & Icon mũi tên -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="#DCFCE7" CornerRadius="10" Padding="8,4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold" Foreground="#16A34A"/>
                                                    </Border>
                                                    <TextBlock Text="›" FontSize="18" FontWeight="Bold" Foreground="#94A3B8" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- ══════════════════════════════════════════════════════════
                         CỘT PHẢI: YÊU CẦU CỦA TÔI
                    ══════════════════════════════════════════════════════════ -->
                    <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="2" Color="#000000" Opacity="0.04"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Header -->
                                <RowDefinition Height="14"/>   <!-- Spacer -->
                                <RowDefinition Height="Auto"/> <!-- 4 Filter Tabs -->
                                <RowDefinition Height="14"/>   <!-- Spacer -->
                                <RowDefinition Height="*"/>    <!-- Cards List -->
                            </Grid.RowDefinitions>

                            <!-- Header: Tiêu đề + Xem tất cả -->
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📄" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Yêu cầu của tôi" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="Xem tất cả ➔" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" Cursor="Hand"/>
                            </Grid>

                            <!-- 4 Filter Tabs (Pills) -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <!-- Tất cả -->
                                <Button Command="{Binding SelectRequestFilterCommand}" CommandParameter="Tất cả"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="pill" CornerRadius="14" Padding="10,5" Background="Transparent">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Tất cả (" FontSize="12"/>
                                                    <TextBlock Text="{Binding TotalRequestsCount}" FontSize="12"/>
                                                    <TextBlock Text=")" FontSize="12"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding SelectedRequestFilter}" Value="Tất cả">
                                                    <Setter TargetName="pill" Property="Background" Value="#DBEAFE"/>
                                                    <Setter Property="Foreground" Value="#2563EB"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Chờ duyệt -->
                                <Button Command="{Binding SelectRequestFilterCommand}" CommandParameter="Chờ duyệt"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="pill" CornerRadius="14" Padding="10,5" Background="Transparent">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Chờ duyệt (" FontSize="12"/>
                                                    <TextBlock Text="{Binding PendingRequestsCount}" FontSize="12"/>
                                                    <TextBlock Text=")" FontSize="12"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding SelectedRequestFilter}" Value="Chờ duyệt">
                                                    <Setter TargetName="pill" Property="Background" Value="#DBEAFE"/>
                                                    <Setter Property="Foreground" Value="#2563EB"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Đã duyệt -->
                                <Button Command="{Binding SelectRequestFilterCommand}" CommandParameter="Đã duyệt"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="pill" CornerRadius="14" Padding="10,5" Background="Transparent">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Đã duyệt (" FontSize="12"/>
                                                    <TextBlock Text="{Binding ApprovedRequestsCount}" FontSize="12"/>
                                                    <TextBlock Text=")" FontSize="12"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding SelectedRequestFilter}" Value="Đã duyệt">
                                                    <Setter TargetName="pill" Property="Background" Value="#DBEAFE"/>
                                                    <Setter Property="Foreground" Value="#2563EB"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Từ chối -->
                                <Button Command="{Binding SelectRequestFilterCommand}" CommandParameter="Từ chối"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="pill" CornerRadius="14" Padding="10,5" Background="Transparent">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Từ chối (" FontSize="12"/>
                                                    <TextBlock Text="{Binding RejectedRequestsCount}" FontSize="12"/>
                                                    <TextBlock Text=")" FontSize="12"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding SelectedRequestFilter}" Value="Từ chối">
                                                    <Setter TargetName="pill" Property="Background" Value="#DBEAFE"/>
                                                    <Setter Property="Foreground" Value="#2563EB"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <!-- Danh sách thẻ yêu cầu -->
                            <ItemsControl Grid.Row="4" ItemsSource="{Binding FilteredRequests}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12"
                                                Padding="14,12" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Avatar tròn -->
                                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#F1F5F9"
                                                        ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <Image Source="/Assets/avatar_son.png" Stretch="UniformToFill"/>
                                                </Border>

                                                <!-- Thông tin yêu cầu -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FullName}" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="Quan hệ: " FontSize="12" Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding RelationshipText}" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                                                        <TextBlock Text="   |   Ngày gửi: " FontSize="12" Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding CreatedAtText}" FontSize="12" Foreground="#64748B"/>
                                                    </StackPanel>
                                                    <!-- Lý do từ chối nếu có -->
                                                    <TextBlock Text="{Binding RejectReason, StringFormat='Lý do từ chối: {0}'}"
                                                               FontSize="11.5" Foreground="#DC2626" Margin="0,3,0,0"
                                                               Visibility="{Binding HasRejectReason, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </StackPanel>

                                                <!-- Badge trạng thái & Icon mũi tên -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="{Binding StatusBadgeBg}" BorderBrush="{Binding StatusBadgeBorder}"
                                                            BorderThickness="1" CornerRadius="10" Padding="8,4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding StatusBadgeFg}"/>
                                                    </Border>
                                                    <TextBlock Text="›" FontSize="18" FontWeight="Bold" Foreground="#94A3B8" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- ══════════════════════════════════════════════════════════
             4. MODAL POPUP: YÊU CẦU THÊM THÀNH VIÊN
             (Chuẩn hóa giao diện & hiển thị lỗi ngay dưới ô nhập)
        ══════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsAddRequestModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#990F172A"/>

            <Border Background="White" CornerRadius="16" Width="520" Padding="28,24"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="#CBD5E1" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Color="#000000" Opacity="0.2"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Modal Header -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="➕" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Yêu cầu thêm thành viên" FontSize="17" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                                FontSize="16" FontWeight="Bold" Foreground="#94A3B8" Cursor="Hand"
                                Command="{Binding CloseAddRequestModalCommand}"/>
                    </Grid>

                    <TextBlock Text="Gửi yêu cầu đăng ký thêm thành viên vào căn hộ đến Ban quản lý toà nhà để phê duyệt."
                               FontSize="12.5" Foreground="#64748B" Margin="0,0,0,16" TextWrapping="Wrap"/>

                    <!-- Báo lỗi chung từ Server/CSDL nếu có -->
                    <Border Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8"
                            Padding="12,8" Margin="0,0,0,14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AddRequestErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AddRequestErrorMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding AddRequestErrorMessage}" FontSize="12.5" Foreground="#DC2626" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>

                    <!-- 1. Họ và tên thành viên -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Họ và tên thành viên (*)" Style="{StaticResource ModalFormLabel}"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding NewMemberFullName, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{Binding FullNameError}" Style="{StaticResource FieldErrorText}"/>
                    </StackPanel>

                    <!-- 2. Ngày sinh & Quan hệ -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ngày sinh -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ngày sinh (*)" Style="{StaticResource ModalFormLabel}"/>
                            <DatePicker Style="{StaticResource ModernDatePicker}" SelectedDate="{Binding NewMemberDateOfBirth, Mode=TwoWay}"/>
                            <TextBlock Text="{Binding BirthDateError}" Style="{StaticResource FieldErrorText}"/>
                        </StackPanel>

                        <!-- Quan hệ -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Quan hệ cư trú (*)" Style="{StaticResource ModalFormLabel}"/>
                            <ComboBox Style="{StaticResource ModernComboBox}"
                                      ItemsSource="{Binding AvailableRelationships}"
                                      SelectedValuePath="Value"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValue="{Binding SelectedRelationshipType, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 3. Số CCCD / Mã định danh -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Số CCCD / Mã định danh (12 số)" Style="{StaticResource ModalFormLabel}"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding NewMemberIdentityCard, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{Binding IdentityCardError}" Style="{StaticResource FieldErrorText}"/>
                    </StackPanel>

                    <!-- 4. SĐT & Email -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Số điện thoại -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Số điện thoại" Style="{StaticResource ModalFormLabel}"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding NewMemberPhoneNumber, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{Binding PhoneNumberError}" Style="{StaticResource FieldErrorText}"/>
                        </StackPanel>

                        <!-- Email -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Email" Style="{StaticResource ModalFormLabel}"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding NewMemberEmail, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{Binding EmailError}" Style="{StaticResource FieldErrorText}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Nút Hủy & Gửi -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Hủy bỏ" Height="40" Background="#F1F5F9" Foreground="#475569"
                                FontWeight="SemiBold" FontSize="13" BorderThickness="0" Cursor="Hand"
                                Command="{Binding CloseAddRequestModalCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="2" Content="Gửi yêu cầu phê duyệt" Height="40" Background="#2563EB" Foreground="White"
                                FontWeight="SemiBold" FontSize="13" BorderThickness="0" Cursor="Hand"
                                Command="{Binding SubmitAddRequestCommand}"
                                IsEnabled="{Binding IsSubmittingRequest, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=invert}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════
             5. MODAL: CHỈNH SỬA THÔNG TIN THÀNH VIÊN
        ══════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsEditMemberModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#990F172A"/>

            <Border Background="White" CornerRadius="16" Width="460" Padding="28,24"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="#CBD5E1" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Color="#000000" Opacity="0.2"/>
                </Border.Effect>

                <StackPanel>
                    <Grid Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✏️" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Chỉnh sửa thông tin thành viên" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                                FontSize="16" FontWeight="Bold" Foreground="#94A3B8" Cursor="Hand"
                                Command="{Binding CloseEditMemberModalCommand}"/>
                    </Grid>

                    <!-- Báo lỗi nếu có -->
                    <Border Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8"
                            Padding="12,8" Margin="0,0,0,14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EditErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EditErrorMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding EditErrorMessage}" FontSize="12.5" Foreground="#DC2626" FontWeight="SemiBold"/>
                    </Border>

                    <!-- Họ và tên (Readonly) -->
                    <TextBlock Text="Họ và tên" Style="{StaticResource ModalFormLabel}"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding EditMemberFullName}" IsReadOnly="True" Background="#F1F5F9" Margin="0,0,0,12"/>

                    <!-- Quan hệ (Readonly) -->
                    <TextBlock Text="Quan hệ với chủ hộ" Style="{StaticResource ModalFormLabel}"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding EditMemberRelationship}" IsReadOnly="True" Background="#F1F5F9" Margin="0,0,0,12"/>

                    <!-- Số điện thoại -->
                    <TextBlock Text="Số điện thoại liên hệ" Style="{StaticResource ModalFormLabel}"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding EditMemberPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                    <!-- Trạng thái cư trú -->
                    <TextBlock Text="Trạng thái cư trú" Style="{StaticResource ModalFormLabel}"/>
                    <ComboBox Style="{StaticResource ModernComboBox}" ItemsSource="{Binding AvailableStatuses}" SelectedItem="{Binding EditMemberStatus}" Margin="0,0,0,20"/>

                    <!-- Nút Hủy & Lưu -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Hủy" Height="40" Background="#F1F5F9" Foreground="#475569"
                                FontWeight="SemiBold" FontSize="13" BorderThickness="0" Cursor="Hand"
                                Command="{Binding CloseEditMemberModalCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="2" Content="Lưu thay đổi" Height="40" Background="#16A34A" Foreground="White"
                                FontWeight="SemiBold" FontSize="13" BorderThickness="0" Cursor="Hand"
                                Command="{Binding SaveMemberEditCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
