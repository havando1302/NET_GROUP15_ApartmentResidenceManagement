<UserControl x:Class="ApartmentResidenceManagement.Wpf.Views.MyApartmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ApartmentResidenceManagement.Wpf.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="1100"
             FontFamily="Segoe UI"
             Background="#F8FAFC">

    <UserControl.Resources>
        <!-- Modern Card Style -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="3" Color="#0F172A" Opacity="0.04"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Table Header Style -->
        <Style x:Key="TableHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,24,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Page Header -->
                <RowDefinition Height="Auto"/> <!-- Top Row: 2 Cards (Căn hộ & Thông tin tòa nhà) -->
                <RowDefinition Height="18"/>   <!-- Spacer -->
                <RowDefinition Height="Auto"/> <!-- Bottom Row: 2 Cards (Danh sách cư dân & Tình trạng cư trú) -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════════
                 1. TIÊU ĐỀ TRANG
            ══════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏢" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Căn hộ của tôi" FontSize="22" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Xem thông tin căn hộ và tình trạng cư trú hiện tại của bạn."
                           FontSize="13" Foreground="#64748B" Margin="32,3,0,0"/>
            </StackPanel>

            <!-- ══════════════════════════════════════════════════════════
                 2. HÀNG TRÊN: CARD CĂN HỘ & CARD THÔNG TIN TÒA NHÀ
            ══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- CARD TRÁI: ẢNH VÀ THÔNG SỐ CĂN HỘ -->
                <Border Grid.Column="0" Style="{StaticResource ModernCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ảnh phòng khách bo tròn 14px -->
                        <Border Grid.Column="0" CornerRadius="14" ClipToBounds="True" Height="145" VerticalAlignment="Center">
                            <Image Source="/Assets/apartment_interior.jpg" Stretch="UniformToFill"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Thông tin căn hộ -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <!-- Badge Đang cư trú -->
                            <Border HorizontalAlignment="Left" Background="#DCFCE7" CornerRadius="10" Padding="8,3" Margin="0,0,0,8">
                                <TextBlock Text="✓  Đang cư trú" FontSize="11" FontWeight="Bold" Foreground="#16A34A"/>
                            </Border>

                            <!-- Tiêu đề Căn hộ A-1203 -->
                            <TextBlock Text="{Binding ApartmentNumber, StringFormat='Căn hộ {0}'}"
                                       FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>

                            <!-- Dòng 1: Tòa & Tầng -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="🏢" Margin="0,0,6,0" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="Tòa: " FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BuildingBlock}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="📶" Margin="0,0,6,0" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="Tầng: " FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding FloorNumber}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Dòng 2: Diện tích & Số nhân khẩu -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="📐" Margin="0,0,6,0" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="Diện tích: " FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ApartmentArea}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="👥" Margin="0,0,6,0" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="Số nhân khẩu: " FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding FamilyCount}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARD PHẢI: THÔNG TIN TÒA NHÀ -->
                <Border Grid.Column="2" Style="{StaticResource ModernCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="🏠" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Thông tin tòa nhà" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Thân card: Thông số bên trái, ảnh tòa nhà bên phải -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <!-- Danh sách thông số tòa nhà -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <!-- Tòa -->
                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🏢" Margin="0,0,6,0" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="Tòa" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding BuildingBlock}" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Số tầng -->
                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📶" Margin="0,0,6,0" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="Số tầng" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding BuildingFloors}" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Thang máy -->
                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🛗" Margin="0,0,6,0" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="Thang máy" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding BuildingElevators}" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Tổng số căn hộ -->
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🚪" Margin="0,0,6,0" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="Tổng số căn hộ" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding BuildingTotalApartments}" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>

                            <!-- Ảnh tòa nhà bo góc tròn bên phải -->
                            <Border Grid.Column="2" CornerRadius="12" ClipToBounds="True" Height="110" VerticalAlignment="Center">
                                <Image Source="/Assets/apartment_building.jpg" Stretch="UniformToFill"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 4. HÀNG DƯỚI: DANH SÁCH CƯ DÂN & TÌNH TRẠNG CƯ TRÚ
            ══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- CARD TRÁI: DANH SÁCH CƯ DÂN ĐANG Ở TẠI CĂN HỘ -->
                <Border Grid.Column="0" Style="{StaticResource ModernCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header Card -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="👥" FontSize="17" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Danh sách cư dân đang ở tại căn hộ" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Header Hàng Cột Bảng -->
                        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="1.8*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="STT" Style="{StaticResource TableHeaderText}"/>
                                <TextBlock Grid.Column="1" Text="Họ và tên" Style="{StaticResource TableHeaderText}"/>
                                <TextBlock Grid.Column="2" Text="Quan hệ" Style="{StaticResource TableHeaderText}"/>
                                <TextBlock Grid.Column="3" Text="Ngày sinh" Style="{StaticResource TableHeaderText}"/>
                                <TextBlock Grid.Column="4" Text="Trạng thái cư trú" Style="{StaticResource TableHeaderText}"/>
                            </Grid>
                        </Border>

                        <!-- Danh sách thành viên -->
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding ResidentMembers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="12,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="1.8*"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- STT -->
                                            <TextBlock Grid.Column="0" Text="{Binding STT}" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>

                                            <!-- Avatar + Họ tên -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="28" Height="28" CornerRadius="14" Background="#EFF6FF" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding AvatarIcon}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding FullName}" FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Quan hệ -->
                                            <TextBlock Grid.Column="2" Text="{Binding Relationship}" FontSize="13" Foreground="#475569" VerticalAlignment="Center"/>

                                            <!-- Ngày sinh -->
                                            <TextBlock Grid.Column="3" Text="{Binding BirthDate}" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>

                                            <!-- Badge Trạng thái -->
                                            <Border Grid.Column="4" Background="{Binding StatusBackground}" CornerRadius="10" Padding="8,3"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusForeground}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- CARD PHẢI: TÌNH TRẠNG CƯ TRÚ -->
                <Border Grid.Column="2" Style="{StaticResource ModernCard}">
                    <StackPanel>
                        <!-- Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="📅" FontSize="17" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Tình trạng cư trú" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Khung Badge lớn Đang cư trú -->
                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="12"
                                Padding="16,12" Margin="0,0,0,18">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✓" FontSize="15" FontWeight="Bold" Foreground="#16A34A" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ResidencyStatus}" FontSize="14" FontWeight="Bold" Foreground="#16A34A" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Chi tiết ngày & hình thức -->
                        <StackPanel>
                            <!-- Ngày bắt đầu -->
                            <Grid Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📅" Margin="0,0,8,0" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Ngày bắt đầu:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ResidencyStartDate}" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Thời gian cư trú -->
                            <Grid Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔄" Margin="0,0,8,0" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Thời gian cư trú:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ResidencyDuration}" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Hình thức -->
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📄" Margin="0,0,8,0" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Hình thức:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ResidencyForm}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
