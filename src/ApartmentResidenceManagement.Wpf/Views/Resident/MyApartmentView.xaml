<UserControl x:Class="ApartmentResidenceManagement.Wpf.Views.MyApartmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ApartmentResidenceManagement.Wpf.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="1100"
             FontFamily="Segoe UI"
             Background="#F8FAFC">

    <UserControl.Resources>
        <!-- Modern Card Style -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="3" Color="#0F172A" Opacity="0.05"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header Cột của Bảng dữ liệu -->
        <Style x:Key="TableHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,24,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Page Header -->
                <RowDefinition Height="Auto"/> <!-- Status / Error Alerts -->
                <RowDefinition Height="Auto"/> <!-- Top Row: 2 Cards (Cư trú & Thành viên) -->
                <RowDefinition Height="18"/>   <!-- Spacer -->
                <RowDefinition Height="Auto"/> <!-- Bottom Row: Card Lịch sử biến động -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════════
                 1. TIÊU ĐỀ TRANG & NÚT TẢI GIẤY XÁC NHẬN CƯ TRÚ
            ══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="46" Height="46" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                            CornerRadius="12" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="📄" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Hồ sơ cư trú" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Quản lý thông tin đăng ký cư trú, các thành viên trong hộ và lịch sử thay đổi."
                                   FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Nút Tải giấy xác nhận cư trú góc phải -->
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{Binding DownloadCertificateCommand}"
                        Background="White" BorderBrush="#BFDBFE" BorderThickness="1.5"
                        Foreground="#2563EB" FontWeight="SemiBold" FontSize="13"
                        Height="38" Padding="16,0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="8" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📥" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Tải giấy xác nhận cư trú" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 2. THÔNG BÁO TRẠNG THÁI (STATUS ALERTS)
            ══════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                <controls:NotificationBanner Message="{Binding StatusMessage}" Kind="Success" Margin="0,0,0,8"/>
                <controls:NotificationBanner Message="{Binding ErrorMessage}" Kind="Error" Margin="0,0,0,8"/>
            </StackPanel>

            <!-- ══════════════════════════════════════════════════════════
                 3. HÀNG TRÊN: THÔNG TIN CƯ TRÚ HIỆN TẠI & DANH SÁCH THÀNH VIÊN
            ══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="1.85*"/>
                </Grid.ColumnDefinitions>

                <!-- ──────────────────────────────────────────────────────────
                     CARD TRÁI: THÔNG TIN CƯ TRÚ HIỆN TẠI
                ────────────────────────────────────────────────────────── -->
                <Border Grid.Column="0" Style="{StaticResource ModernCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header Card Cư trú -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
                            <TextBlock Text="📄" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Thông tin cư trú hiện tại" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Nội dung 2 cột: Ảnh thumbnail & Các thông số -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Ảnh toà nhà bo tròn góc -->
                            <Border Grid.Column="0" CornerRadius="12" ClipToBounds="True" Height="150" VerticalAlignment="Center">
                                <Image Source="/Assets/login_background_hero.jpg" Stretch="UniformToFill"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Danh sách thông số cư trú -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <!-- Căn hộ -->
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🏢" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Căn hộ:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ApartmentNumber}" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Tòa -->
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🏢" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Tòa:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding BuildingBlock}" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Tầng -->
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📶" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Tầng:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FloorNumber}" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Loại cư trú -->
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="👤" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Loại cư trú:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Background="#DCFCE7" CornerRadius="10" Padding="8,3">
                                        <TextBlock Text="{Binding ResidencyType}" FontSize="11" FontWeight="Bold" Foreground="#16A34A"/>
                                    </Border>
                                </Grid>

                                <!-- Ngày đăng ký -->
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📅" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Ngày đăng ký:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding RegisteredDate}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Trạng thái -->
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔄" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Trạng thái:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Background="#EFF6FF" CornerRadius="10" Padding="8,3">
                                        <TextBlock Text="{Binding ResidencyStatus}" FontSize="11" FontWeight="Bold" Foreground="#2563EB"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ──────────────────────────────────────────────────────────
                     CARD PHẢI: DANH SÁCH THÀNH VIÊN TRONG HỘ
                ────────────────────────────────────────────────────────── -->
                <Border Grid.Column="2" Style="{StaticResource ModernCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header & Button + Đăng ký bổ sung -->
                            <RowDefinition Height="Auto"/> <!-- Bảng danh sách thành viên Header -->
                            <RowDefinition Height="*"/>    <!-- Bảng danh sách thành viên Rows -->
                        </Grid.RowDefinitions>

                        <!-- Header Card Thành viên -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="👥" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Danh sách thành viên trong hộ" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Nút + Đăng ký bổ sung -->
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Command="{Binding AddMemberCommand}"
                                    Background="#2563EB" BorderThickness="0"
                                    Foreground="White" FontWeight="Bold" FontSize="12.5"
                                    Height="34" Padding="14,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="8" Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="+ " FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <TextBlock Text="Đăng ký bổ sung" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Header hàng tiêu đề cột của Bảng Thành viên -->
                        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>    <!-- STT -->
                                    <ColumnDefinition Width="1.5*"/>  <!-- Họ và tên -->
                                    <ColumnDefinition Width="70"/>    <!-- Quan hệ -->
                                    <ColumnDefinition Width="90"/>    <!-- Ngày sinh -->
                                    <ColumnDefinition Width="120"/>   <!-- CCCD/Định danh -->
                                    <ColumnDefinition Width="95"/>    <!-- Trạng thái -->
                                    <ColumnDefinition Width="60"/>    <!-- Thao tác -->
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="STT" Style="{StaticResource TableHeaderText}"/>
                                <TextBlock Grid.Column="1" Text="Họ và tên" Style="{StaticResource TableHeaderText}"/>
                                <TextBlock Grid.Column="2" Text="Quan hệ" Style="{StaticResource TableHeaderText}"/>
                                <TextBlock Grid.Column="3" Text="Ngày sinh" Style="{StaticResource TableHeaderText}"/>
                                <TextBlock Grid.Column="4" Text="CCCD/Định danh" Style="{StaticResource TableHeaderText}"/>
                                <TextBlock Grid.Column="5" Text="Trạng thái" Style="{StaticResource TableHeaderText}"/>
                                <TextBlock Grid.Column="6" Text="Thao tác" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Dữ liệu danh sách Thành viên -->
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding HouseholdMembers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="10,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>    <!-- STT -->
                                                <ColumnDefinition Width="1.5*"/>  <!-- Họ và tên -->
                                                <ColumnDefinition Width="70"/>    <!-- Quan hệ -->
                                                <ColumnDefinition Width="90"/>    <!-- Ngày sinh -->
                                                <ColumnDefinition Width="120"/>   <!-- CCCD/Định danh -->
                                                <ColumnDefinition Width="95"/>    <!-- Trạng thái -->
                                                <ColumnDefinition Width="60"/>    <!-- Thao tác -->
                                            </Grid.ColumnDefinitions>

                                            <!-- STT -->
                                            <TextBlock Grid.Column="0" Text="{Binding STT}" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>

                                            <!-- Họ và tên -->
                                            <TextBlock Grid.Column="1" Text="{Binding FullName}" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>

                                            <!-- Quan hệ -->
                                            <TextBlock Grid.Column="2" Text="{Binding Relationship}" FontSize="13" Foreground="#475569" VerticalAlignment="Center"/>

                                            <!-- Ngày sinh -->
                                            <TextBlock Grid.Column="3" Text="{Binding BirthDate}" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>

                                            <!-- CCCD/Định danh -->
                                            <TextBlock Grid.Column="4" Text="{Binding IdentityCard}" FontSize="13" Foreground="#475569" VerticalAlignment="Center"/>

                                            <!-- Trạng thái Badge -->
                                            <Border Grid.Column="5" Background="{Binding StatusBackground}" CornerRadius="10"
                                                    Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusForeground}"/>
                                            </Border>

                                            <!-- Thao tác Sửa (Pencil Icon) -->
                                            <Button Grid.Column="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.EditMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                <TextBlock Text="✏️" FontSize="14" Foreground="#2563EB"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 4. HÀNG DƯỚI: CARD LỊCH SỬ BIẾN ĐỘNG CƯ TRÚ (FULL WIDTH)
            ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="4" Style="{StaticResource ModernCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header Card -->
                        <RowDefinition Height="Auto"/> <!-- Header Cột Bảng -->
                        <RowDefinition Height="*"/>    <!-- Rows Bảng -->
                    </Grid.RowDefinitions>

                    <!-- Header Card Lịch sử -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="🕒" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Lịch sử biến động cư trú" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Header Cột Bảng Lịch sử -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>   <!-- Thời gian -->
                                <ColumnDefinition Width="*"/>     <!-- Nội dung -->
                                <ColumnDefinition Width="110"/>   <!-- Trạng thái -->
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Thời gian" Style="{StaticResource TableHeaderText}"/>
                            <TextBlock Grid.Column="1" Text="Nội dung" Style="{StaticResource TableHeaderText}"/>
                            <TextBlock Grid.Column="2" Text="Trạng thái" Style="{StaticResource TableHeaderText}"/>
                        </Grid>
                    </Border>

                    <!-- Rows Bảng Lịch sử -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding HistoryRecords}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="12,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>   <!-- Thời gian -->
                                            <ColumnDefinition Width="*"/>     <!-- Nội dung -->
                                            <ColumnDefinition Width="110"/>   <!-- Trạng thái -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Thời gian -->
                                        <TextBlock Grid.Column="0" Text="{Binding EventTime}" FontSize="13" Foreground="#475569" VerticalAlignment="Center"/>

                                        <!-- Nội dung -->
                                        <TextBlock Grid.Column="1" Text="{Binding Content}" FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>

                                        <!-- Trạng thái Badge -->
                                        <Border Grid.Column="2" Background="{Binding StatusBackground}" CornerRadius="10"
                                                Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusForeground}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
