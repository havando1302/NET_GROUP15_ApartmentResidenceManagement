<UserControl x:Class="ApartmentResidenceManagement.Wpf.Views.MyApartmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ApartmentResidenceManagement.Wpf.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="950"
             FontFamily="Segoe UI"
             Background="{StaticResource PageBgBrush}">

    <UserControl.Resources>
        <!-- Apartment Card Style (Padding card: 20px, Bo góc: 8px) -->
        <Style x:Key="ApartmentCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" Direction="0" ShadowDepth="0" Color="#000000" Opacity="0.04"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nhãn tiêu đề trường thông tin (Khoảng cách nhãn - ô/giá trị: 8px) -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Giá trị trường thông tin (Nội dung: 14px, Khoảng cách trường: 16px) -->
        <Style x:Key="ValueLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </UserControl.Resources>

    <!-- Lề trang: 24 px -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Nội dung -->
        </Grid.RowDefinitions>

        <!-- HEADER (Khoảng cách nhóm: 24 px) -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <!-- Tiêu đề trang: 24 px -->
                <TextBlock Text="CĂN HỘ CỦA TÔI" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryDarkBrush}"/>
                <!-- Chú thích: 12 px -->
                <TextBlock Text="Thông tin căn hộ và hợp đồng cư trú hiện tại của bạn tại tòa nhà."
                           FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Chiều cao nút: 40 px -->
            <Button Grid.Column="1" Command="{Binding RefreshCommand}" VerticalAlignment="Center"
                    Style="{StaticResource OutlineButton}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔄" Margin="0,0,6,0" FontSize="14"/>
                    <TextBlock Text="Làm mới"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- NỘI DUNG CHÍNH -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <!-- TH1: CHƯA CÓ CĂN HỘ (Bo góc: 8px, Padding: 20px) -->
                <Border Background="{StaticResource CardBgBrush}" CornerRadius="{StaticResource RadiusMedium}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="20" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasApartment}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" Direction="0" ShadowDepth="0" Color="#000000" Opacity="0.04"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⚠️" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <!-- Tiêu đề khung: 18 px -->
                        <TextBlock Text="Chưa có căn hộ đăng ký" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <!-- Nội dung: 14 px -->
                        <TextBlock Text="Tài khoản của bạn hiện tại chưa được Ban Quản Lý liên kết với căn hộ nào trong tòa nhà. Vui lòng liên hệ Văn Phòng Ban Quản Lý để được đăng ký cư trú." 
                                   FontSize="14" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="20"/>
                    </StackPanel>
                </Border>

                <!-- TH2: ĐÃ CÓ CĂN HỘ -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasApartment}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <!-- Khoảng cách giữa 2 nhóm: 24 px -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cột trái: Thông tin Căn hộ -->
                    <Border Grid.Column="0" Style="{StaticResource ApartmentCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Tiêu đề khung: 18 px (Khoảng cách nhóm: 24 px) -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                                <TextBlock Text="THÔNG TIN CĂN HỘ" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                                <Border Height="3" Width="40" Background="{StaticResource PrimaryBrush}"
                                        CornerRadius="2" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <!-- Số căn hộ (Khoảng cách trường: 16 px) -->
                                <TextBlock Text="Số căn hộ" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="🚪" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding ApartmentNumber}" FontSize="26" FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryDarkBrush}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Số tầng (Khoảng cách trường: 16 px) -->
                                <TextBlock Text="Vị trí tầng" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="🏢" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <!-- Nội dung: 14 px -->
                                    <TextBlock Text="{Binding FloorText}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Diện tích (Khoảng cách trường: 16 px) -->
                                <TextBlock Text="Diện tích sử dụng" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="📐" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <!-- Nội dung: 14 px -->
                                    <TextBlock Text="{Binding AreaText}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Trạng thái -->
                                <TextBlock Text="Trạng thái căn hộ" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛡" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <!-- Bo góc: 4 px -->
                                    <Border Background="{StaticResource SuccessBgBrush}" CornerRadius="{StaticResource RadiusSmall}" Padding="8,4" VerticalAlignment="Center">
                                        <!-- Chú thích / Badge: 12 px -->
                                        <TextBlock Text="{Binding ApartmentStatusText}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource SuccessBrush}"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Cột phải: Thông tin Hợp đồng / Cư trú -->
                    <Border Grid.Column="2" Style="{StaticResource ApartmentCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Tiêu đề khung: 18 px (Khoảng cách nhóm: 24 px) -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                                <TextBlock Text="HỢP ĐỒNG CƯ TRÚ" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                                <Border Height="3" Width="40" Background="{StaticResource PrimaryBrush}"
                                        CornerRadius="2" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <!-- Quan hệ cư trú (Khoảng cách trường: 16 px) -->
                                <TextBlock Text="Vai trò / Quan hệ cư trú" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="🔑" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <!-- Bo góc: 4 px -->
                                    <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="{StaticResource RadiusSmall}" Padding="10,4" VerticalAlignment="Center">
                                        <!-- Nội dung: 14 px -->
                                        <TextBlock Text="{Binding RelationshipText}" FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryDarkBrush}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Ngày bắt đầu (Khoảng cách trường: 16 px) -->
                                <TextBlock Text="Ngày bắt đầu cư trú" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="📅" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <!-- Nội dung: 14 px -->
                                    <TextBlock Text="{Binding StartDateText}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Trạng thái cư trú (Khoảng cách trường: 16 px) -->
                                <TextBlock Text="Trạng thái hợp đồng" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="🟢" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <!-- Nội dung: 14 px -->
                                    <TextBlock Text="Đang hoạt động" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Ghi chú lưu ý -->
                                <controls:NotificationBanner Kind="Information" Margin="0,8,0,0"
                                                             Message="Nếu có thay đổi nhân khẩu hoặc đăng ký xe mới, vui lòng khai báo bổ sung ở các phân mục tương ứng hoặc liên hệ Ban Quản Lý."/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
