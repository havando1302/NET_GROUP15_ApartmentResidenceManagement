<UserControl x:Class="ApartmentResidenceManagement.Wpf.Views.ResidencyHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ApartmentResidenceManagement.Wpf.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1050"
             FontFamily="Segoe UI"
             Background="#F8FAFC">

    <UserControl.Resources>
        <!-- Modern Card Style -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="3" Color="#0F172A" Opacity="0.05"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header Cột của Bảng -->
        <Style x:Key="TableHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,24,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Page Header -->
                <RowDefinition Height="Auto"/> <!-- Summary Info Bar -->
                <RowDefinition Height="*"/>    <!-- History Events Card -->
            </Grid.RowDefinitions>

            <!-- 1. TIÊU ĐỀ TRANG -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="46" Height="46" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                            CornerRadius="12" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="🕒" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Lịch sử cư trú" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Theo dõi các mốc biến động cư trú, đăng ký thường trú và cập nhật hộ khẩu."
                                   FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Nút Làm mới góc phải -->
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{Binding RefreshCommand}"
                        Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                        Foreground="#475569" FontWeight="SemiBold" FontSize="13"
                        Height="36" Padding="14,0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="8" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔄" Margin="0,0,6,0" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="Làm mới" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 2. THANH THÔNG TIN TÓM TẮT CƯ DÂN -->
            <Border Grid.Row="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                    CornerRadius="12" Padding="18,14" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="👤 Cư dân: " FontSize="13.5" Foreground="#64748B"/>
                        <TextBlock Text="{Binding ResidentName}" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="🆔 Mã cư dân: " FontSize="13.5" Foreground="#64748B"/>
                        <TextBlock Text="{Binding ResidentCode}" FontSize="14" FontWeight="Bold" Foreground="#64748B"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="🏢 Căn hộ hiện tại: " FontSize="13.5" Foreground="#64748B"/>
                        <TextBlock Text="{Binding CurrentApartment}" FontSize="14" FontWeight="Bold" Foreground="#2563EB"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="📜 Tổng số bản ghi: " FontSize="13.5" Foreground="#64748B"/>
                        <TextBlock Text="{Binding TotalEvents}" FontSize="14" FontWeight="Bold" Foreground="#16A34A"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. DANH SÁCH LỊCH SỬ BIẾN ĐỘNG CƯ TRÚ -->
            <Border Grid.Row="2" Style="{StaticResource ModernCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header Card -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="📅" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Chi tiết các mốc biến động" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Header Cột Bảng -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="STT" Style="{StaticResource TableHeaderText}"/>
                            <TextBlock Grid.Column="1" Text="Thời gian" Style="{StaticResource TableHeaderText}"/>
                            <TextBlock Grid.Column="2" Text="Nội dung biến động" Style="{StaticResource TableHeaderText}"/>
                            <TextBlock Grid.Column="3" Text="Căn hộ liên quan" Style="{StaticResource TableHeaderText}"/>
                            <TextBlock Grid.Column="4" Text="Trạng thái" Style="{StaticResource TableHeaderText}"/>
                        </Grid>
                    </Border>

                    <!-- Dữ liệu lịch sử -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding HistoryEvents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="12,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- STT -->
                                        <TextBlock Grid.Column="0" Text="{Binding STT}" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>

                                        <!-- Thời gian -->
                                        <TextBlock Grid.Column="1" Text="{Binding EventTime}" FontSize="13" Foreground="#475569" VerticalAlignment="Center"/>

                                        <!-- Nội dung -->
                                        <TextBlock Grid.Column="2" Text="{Binding Content}" FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>

                                        <!-- Căn hộ liên quan -->
                                        <TextBlock Grid.Column="3" Text="{Binding ApartmentInfo}" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>

                                        <!-- Trạng thái Badge -->
                                        <Border Grid.Column="4" Background="{Binding StatusBackground}" CornerRadius="10"
                                                Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusForeground}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
