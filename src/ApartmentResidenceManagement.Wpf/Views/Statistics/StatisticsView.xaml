                                                     CenterSubText="Phương tiện" Width="145" Height="145"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Border Background="#F8FAFC" CornerRadius="8" Padding="8,6" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="10" Height="10" CornerRadius="3" Background="#2563EB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Grid.Column="1" Text="Đã duyệt" FontSize="12" Foreground="#0F172A"/>
                                            <TextBlock Grid.Column="2" Text="{Binding VehApprovedRateDisplay}" FontSize="12" FontWeight="Bold" Foreground="#2563EB"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="#F8FAFC" CornerRadius="8" Padding="8,6" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="10" Height="10" CornerRadius="3" Background="#FACC15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Grid.Column="1" Text="Chờ duyệt" FontSize="12" Foreground="#0F172A"/>
                                            <TextBlock Grid.Column="2" Text="{Binding VehPendingRateDisplay}" FontSize="12" FontWeight="Bold" Foreground="#D97706"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="#F8FAFC" CornerRadius="8" Padding="8,6" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="10" Height="10" CornerRadius="3" Background="#F87171" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Grid.Column="1" Text="Từ chối" FontSize="12" Foreground="#0F172A"/>
                                            <TextBlock Grid.Column="2" Text="{Binding VehRejectedRateDisplay}" FontSize="12" FontWeight="Bold" Foreground="#DC2626"/>
                                        </Grid>
                                    </Border>
                                    <Image Source="/Assets/sidebar_buildings.png" Height="40" HorizontalAlignment="Right" Opacity="0.8" Stretch="Uniform"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Bảng chi tiết phương tiện -->
                <Border Style="{StaticResource ModernStatCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="FormatListBulleted" Width="16" Height="16" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Chi tiết phương tiện" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Command="{Binding ExportReportCommand}"
                                    Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,5" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <iconPacks:PackIconMaterial Kind="DownloadOutline" Width="13" Height="13" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Xuất báo cáo" FontSize="12.5" FontWeight="SemiBold" Foreground="#2563EB"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding VehDetailsTable}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                                  RowStyle="{StaticResource StatDataGridRow}" ColumnHeaderStyle="{StaticResource StatDataGridHeader}"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" BorderThickness="0" Background="White">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="50"/>
                                <DataGridTextColumn Header="Biển số" Binding="{Binding LicensePlate}" FontWeight="Bold" Width="1.5*"/>
                                <DataGridTextColumn Header="Loại phương tiện" Binding="{Binding VehicleTypeLabel}" Width="1.5*"/>
                                <DataGridTextColumn Header="Căn hộ" Binding="{Binding ApartmentNumber}" Width="1.2*"/>
                                <DataGridTextColumn Header="Chủ sở hữu" Binding="{Binding OwnerName}" Width="1.8*"/>
                                
                                <!-- Trạng thái: Pill badge -->
                                <DataGridTemplateColumn Header="Trạng thái" Width="1.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="12" Padding="8,3" HorizontalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F1F5F9"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RegistrationStatus}" Value="Approved">
                                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RegistrationStatus}" Value="Pending">
                                                                <Setter Property="Background" Value="#FEF3C7"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RegistrationStatus}" Value="Rejected">
                                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#475569"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RegistrationStatus}" Value="Approved">
                                                                    <Setter Property="Foreground" Value="#16A34A"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RegistrationStatus}" Value="Pending">
                                                                    <Setter Property="Foreground" Value="#D97706"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RegistrationStatus}" Value="Rejected">
                                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Ngày đăng ký" Binding="{Binding RegistrationDateDisplay}" Width="1.5*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
