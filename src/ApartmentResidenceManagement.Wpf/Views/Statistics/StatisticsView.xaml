<UserControl x:Class="ApartmentResidenceManagement.Wpf.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ApartmentResidenceManagement.Wpf.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="1100"
             Background="#F8FAFC">

    <UserControl.Resources>
        <!-- Card Style chuẩn hiện đại -->
        <Style x:Key="ModernStatCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.04"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- KPI Card Style -->
        <Style x:Key="StatKpiCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="2" Color="#0F172A" Opacity="0.03"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab Button Style -->
        <Style x:Key="ModernTabButton" TargetType="RadioButton">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#EFF6FF"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Row Style giống trang Quản lý căn hộ -->
        <Style x:Key="StatDataGridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="BorderBrush" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E0F2FE"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatDataGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Cell centered text style -->
        <Style x:Key="CenteredTextElement" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>

        <!-- Nút phân trang (Pagination Button) giống Quản lý căn hộ -->
        <Style x:Key="PageNumButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,20,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 1. Tiêu đề trang -->
                <RowDefinition Height="Auto"/>  <!-- 2. Thanh 3 Tab chức năng -->
                <RowDefinition Height="0"/>  <!-- 3. Thanh thông báo chuyển thành Floating Toast -->
                <RowDefinition Height="Auto"/>  <!-- 4. Nội dung Tab 1: Biến động cư trú -->
                <RowDefinition Height="Auto"/>  <!-- 5. Nội dung Tab 2: Thống kê căn hộ -->
                <RowDefinition Height="Auto"/>  <!-- 6. Nội dung Tab 3: Thống kê phương tiện -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════════
                 1. TIÊU ĐỀ TRANG
            ══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#EFF6FF" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="ChartBoxOutline" Width="22" Height="22" Foreground="#2563EB"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Báo cáo &amp; Thống kê" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Thống kê, phân tích dữ liệu cư trú, căn hộ và phương tiện theo thời gian."
                               FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 2. THANH 3 TAB CHỨC NĂNG (RP01)
            ══════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,18">
                <RadioButton Content="Biến động cư trú" Style="{StaticResource ModernTabButton}" Margin="0,0,12,0"
                             IsChecked="{Binding IsTab1Active, Mode=OneWay}"
                             Command="{Binding SwitchTabCommand}" CommandParameter="0"/>

                <RadioButton Content="Thống kê căn hộ" Style="{StaticResource ModernTabButton}" Margin="0,0,12,0"
                             IsChecked="{Binding IsTab2Active, Mode=OneWay}"
                             Command="{Binding SwitchTabCommand}" CommandParameter="1"/>

                <RadioButton Content="Thống kê phương tiện" Style="{StaticResource ModernTabButton}"
                             IsChecked="{Binding IsTab3Active, Mode=OneWay}"
                             Command="{Binding SwitchTabCommand}" CommandParameter="2"/>
            </StackPanel>



            <!-- ══════════════════════════════════════════════════════════
                 4. NỘI DUNG TAB 1: BIẾN ĐỘNG CƯ TRÚ (Mockup 2)
            ══════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="3" Visibility="{Binding IsTab1Active, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!-- Thanh bộ lọc Tab 1 (giãn cách đều ra) -->
                <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16,12" Margin="0,0,0,18">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Thời gian -->
                        <Grid Grid.Column="0" Margin="0,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                <iconPacks:PackIconMaterial Kind="CalendarBlankOutline" Width="15" Height="15" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Thời gian:" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding TimeModeOptions}" SelectedItem="{Binding SelectedTimeMode}" Height="34" HorizontalAlignment="Stretch"/>
                        </Grid>

                        <!-- Tháng -->
                        <Grid Grid.Column="1" Margin="0,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tháng:" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding MonthOptions}" SelectedItem="{Binding SelectedMonth}" Height="34" HorizontalAlignment="Stretch"/>
                        </Grid>

                        <!-- Năm -->
                        <Grid Grid.Column="2" Margin="0,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Năm:" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding YearOptions}" SelectedItem="{Binding SelectedYear}" Height="34" HorizontalAlignment="Stretch"/>
                        </Grid>

                        <!-- Tầng -->
                        <Grid Grid.Column="3" Margin="0,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tầng:" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableFloors}" SelectedItem="{Binding SelectedFloor}" Height="34" HorizontalAlignment="Stretch"/>
                        </Grid>

                        <!-- Căn hộ -->
                        <Grid Grid.Column="4" Margin="0,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Căn hộ:" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableApartments}" SelectedValue="{Binding SelectedApartmentId}" SelectedValuePath="Id" DisplayMemberPath="ApartmentNumber" Height="34" HorizontalAlignment="Stretch"/>
                        </Grid>

                        <!-- Nút Thống kê -->
                        <Button Grid.Column="5" Command="{Binding FilterCommand}" Height="34" Padding="14,0" Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <iconPacks:PackIconMaterial Kind="Magnify" Width="13" Height="13" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Thống kê" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Nút Bỏ lọc (Reset) -->
                        <Button Grid.Column="6" Command="{Binding ResetFilterCommand}" Height="34" Padding="14,0" Background="White" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <iconPacks:PackIconMaterial Kind="FilterRemoveOutline" Width="13" Height="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Bỏ lọc" FontSize="13" FontWeight="SemiBold" Foreground="#475569"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- 4 Thẻ KPI Biến động cư trú -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StatKpiCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#DCFCE7" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="AccountPlusOutline" Width="22" Height="22" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ResidenceNewRegs}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Đăng ký mới" FontSize="12.5" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="#DCFCE7" CornerRadius="6" Padding="6,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ResidenceNewRegsChangeDisplay}" FontSize="11.5" FontWeight="Bold" Foreground="#16A34A"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource StatKpiCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#FEE2E2" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="AccountMinusOutline" Width="22" Height="22" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ResidenceEnded}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Kết thúc cư trú" FontSize="12.5" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="#FEE2E2" CornerRadius="6" Padding="6,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ResidenceEndedChangeDisplay}" FontSize="11.5" FontWeight="Bold" Foreground="#DC2626"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource StatKpiCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#EFF6FF" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="SwapHorizontal" Width="22" Height="22" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ResidenceTransfers}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Chuyển căn hộ" FontSize="12.5" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource StatKpiCard}" Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#F3E8FF" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="AccountGroupOutline" Width="22" Height="22" Foreground="#7C3AED" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ResidenceCurrent}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Cư dân hiện tại" FontSize="12.5" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 2 Biểu đồ Tab 1 -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Biểu đồ cột 6 tháng -->
                    <Border Grid.Column="0" Style="{StaticResource ModernStatCard}" Margin="0,0,14,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="ChartBar" Width="16" Height="16" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Biến động cư trú 6 tháng gần đây" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Width="10" Height="10" CornerRadius="2" Background="#3B82F6" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Đăng ký mới" FontSize="12" Foreground="#64748B" Margin="0,0,14,0"/>
                                    <Border Width="10" Height="10" CornerRadius="2" Background="#A855F7" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Kết thúc cư trú" FontSize="12" Foreground="#64748B"/>
                                </StackPanel>
                            </Grid>
                            <controls:ModernBarChart Grid.Row="1" Categories="{Binding ResidenceFluctuationBars}" Height="200"/>
                        </Grid>
                    </Border>

                    <!-- Biểu đồ hình tròn đặc (Pie Chart) Cơ cấu cư trú -->
                    <Border Grid.Column="1" Style="{StaticResource ModernStatCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                                <iconPacks:PackIconMaterial Kind="ChartArc" Width="16" Height="16" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Cơ cấu cư trú hiện tại" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Pie Chart tròn đặc (HoleRatio = 0) -->
                                <controls:DonutChart Grid.Column="0" Slices="{Binding ResidenceStructureSlices}"
                                                     HoleRatio="0" Width="145" Height="145"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="10" Height="10" CornerRadius="3" Background="#2563EB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="Cư dân thường trú" FontSize="12.5" Foreground="#0F172A"/>
                                            <TextBlock Grid.Column="2" Text="{Binding PermanentRateDisplay}" FontSize="12.5" FontWeight="Bold" Foreground="#2563EB"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="10" Height="10" CornerRadius="3" Background="#A855F7" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="Cư dân tạm trú" FontSize="12.5" Foreground="#0F172A"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TemporaryRateDisplay}" FontSize="12.5" FontWeight="Bold" Foreground="#A855F7"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Bảng chi tiết biến động cư trú (Căn giữa nội dung + Phân trang) -->
                <Border Style="{StaticResource ModernStatCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>  <!-- Thanh phân trang -->
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="FormatListBulleted" Width="16" Height="16" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Chi tiết biến động cư trú" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Command="{Binding ExportReportCommand}"
                                    Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,5" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <iconPacks:PackIconMaterial Kind="DownloadOutline" Width="13" Height="13" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Xuất báo cáo" FontSize="12.5" FontWeight="SemiBold" Foreground="#2563EB"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding PagedResidenceTrendTable}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                                  RowStyle="{StaticResource StatDataGridRow}" ColumnHeaderStyle="{StaticResource StatDataGridHeader}"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" BorderThickness="0" Background="White">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tháng/Năm" Binding="{Binding MonthYearLabel}" ElementStyle="{StaticResource CenteredTextElement}" Width="1.5*"/>
                                <DataGridTextColumn Header="Đăng ký mới" Binding="{Binding NewRegistrations}" ElementStyle="{StaticResource CenteredTextElement}" Width="1.5*"/>
                                <DataGridTextColumn Header="Kết thúc cư trú" Binding="{Binding EndedResidences}" ElementStyle="{StaticResource CenteredTextElement}" Width="1.5*"/>
                                <DataGridTextColumn Header="Chuyển căn hộ" Binding="{Binding ApartmentTransfers}" ElementStyle="{StaticResource CenteredTextElement}" Width="1.5*"/>
                                <DataGridTextColumn Header="Tổng biến động" Binding="{Binding TotalFluctuations}" ElementStyle="{StaticResource CenteredTextElement}" Width="1.5*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Thanh phân trang ở đáy bảng -->
                        <Grid Grid.Row="2" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding PaginationSummary}" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Style="{StaticResource PageNumButton}" Command="{Binding PreviousPageCommand}" ToolTip="Trang trước">
                                    <iconPacks:PackIconMaterial Kind="ChevronLeft" Width="14" Height="14" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <ItemsControl ItemsSource="{Binding PageNumbers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" Style="{StaticResource PageNumButton}"
                                                    Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource PageNumButton}" Command="{Binding NextPageCommand}" ToolTip="Trang sau">
                                    <iconPacks:PackIconMaterial Kind="ChevronRight" Width="14" Height="14" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Số dòng/trang: " FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}" Width="65" Height="30" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ══════════════════════════════════════════════════════════
                 5. NỘI DUNG TAB 2: THỐNG KÊ CĂN HỘ (Mockup 3)
            ══════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="4" Visibility="{Binding IsTab2Active, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!-- Thanh bộ lọc Tab 2 (giãn cách đều ra) -->
                <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16,12" Margin="0,0,0,18">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Thời gian -->
                        <Grid Grid.Column="0" Margin="0,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                <iconPacks:PackIconMaterial Kind="CalendarBlankOutline" Width="15" Height="15" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Thời gian:" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding TimeModeOptions}" SelectedItem="{Binding SelectedTimeMode}" Height="34" HorizontalAlignment="Stretch"/>
                        </Grid>

                        <!-- Năm -->
                        <Grid Grid.Column="1" Margin="0,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Năm:" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding YearOptions}" SelectedItem="{Binding SelectedYear}" Height="34" HorizontalAlignment="Stretch"/>
                        </Grid>

                        <!-- Tầng -->
                        <Grid Grid.Column="2" Margin="0,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tầng:" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableFloors}" SelectedItem="{Binding SelectedFloor}" Height="34" HorizontalAlignment="Stretch"/>
                        </Grid>

                        <!-- Trạng thái -->
                        <Grid Grid.Column="3" Margin="0,0,14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Trạng thái:" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ApartmentStatusFilterOptions}" SelectedItem="{Binding SelectedApartmentStatusFilter}" Height="34" HorizontalAlignment="Stretch"/>
                        </Grid>

                        <!-- Nút Thống kê -->
                        <Button Grid.Column="4" Command="{Binding FilterCommand}" Height="34" Padding="14,0" Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <iconPacks:PackIconMaterial Kind="Magnify" Width="13" Height="13" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Thống kê" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Nút Bỏ lọc (Reset) -->
                        <Button Grid.Column="5" Command="{Binding ResetFilterCommand}" Height="34" Padding="14,0" Background="White" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <iconPacks:PackIconMaterial Kind="FilterRemoveOutline" Width="13" Height="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Bỏ lọc" FontSize="13" FontWeight="SemiBold" Foreground="#475569"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- 4 Thẻ KPI Căn hộ -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StatKpiCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#EFF6FF" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="OfficeBuildingOutline" Width="22" Height="22" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AptTotal}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Tổng căn hộ" FontSize="12.5" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource StatKpiCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#DCFCE7" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="HomeAccount" Width="22" Height="22" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AptOccupied}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Căn hộ đang ở" FontSize="12.5" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource StatKpiCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#F1F5F9" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="HomeOutline" Width="22" Height="22" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AptVacant}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Căn hộ trống" FontSize="12.5" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource StatKpiCard}" Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#F3E8FF" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="LayersOutline" Width="22" Height="22" Foreground="#7C3AED" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AptOccupancyRateDisplay}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Tỷ lệ sử dụng" FontSize="12.5" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 2 Biểu đồ Tab 2 -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Phân bố căn hộ theo tầng -->
                    <Border Grid.Column="0" Style="{StaticResource ModernStatCard}" Margin="0,0,14,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="ChartBar" Width="16" Height="16" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Phân bố căn hộ theo tầng" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Width="10" Height="10" CornerRadius="2" Background="#3B82F6" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Đang ở" FontSize="12" Foreground="#64748B" Margin="0,0,14,0"/>
                                    <Border Width="10" Height="10" CornerRadius="2" Background="#C084FC" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Trống" FontSize="12" Foreground="#64748B"/>
                                </StackPanel>
                            </Grid>
                            <controls:ModernBarChart Grid.Row="1" Categories="{Binding AptFloorDistributionBars}" Height="200"/>
                        </Grid>
                    </Border>

                    <!-- Biểu đồ hình tròn đặc (Pie Chart) Tình trạng căn hộ toàn tòa -->
                    <Border Grid.Column="1" Style="{StaticResource ModernStatCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                                <iconPacks:PackIconMaterial Kind="ChartArc" Width="16" Height="16" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Tình trạng căn hộ toàn tòa" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Pie Chart tròn đặc (HoleRatio = 0) -->
                                <controls:DonutChart Grid.Column="0" Slices="{Binding AptOccupancySlices}"
                                                     HoleRatio="0" Width="145" Height="145"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="10" Height="10" CornerRadius="3" Background="#2563EB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="Đang ở" FontSize="12.5" Foreground="#0F172A"/>
                                            <TextBlock Grid.Column="2" Text="{Binding AptOccupancyRateDisplay}" FontSize="12.5" FontWeight="Bold" Foreground="#2563EB"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="10" Height="10" CornerRadius="3" Background="#C084FC" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="Trống" FontSize="12.5" Foreground="#0F172A"/>
                                            <TextBlock Grid.Column="2" Text="{Binding AptVacantRateDisplay}" FontSize="12.5" FontWeight="Bold" Foreground="#64748B"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Bảng chi tiết tình trạng căn hộ theo từng tầng (Căn giữa nội dung + Phân trang) -->
                <Border Style="{StaticResource ModernStatCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>  <!-- Dòng Tổng -->
                            <RowDefinition Height="Auto"/>  <!-- Thanh phân trang -->
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="FormatListBulleted" Width="16" Height="16" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Chi tiết tình trạng căn hộ theo từng tầng" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Command="{Binding ExportReportCommand}"
                                    Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,5" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <iconPacks:PackIconMaterial Kind="DownloadOutline" Width="13" Height="13" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Xuất báo cáo" FontSize="12.5" FontWeight="SemiBold" Foreground="#2563EB"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding PagedAptFloorTable}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                                  RowStyle="{StaticResource StatDataGridRow}" ColumnHeaderStyle="{StaticResource StatDataGridHeader}"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" BorderThickness="0" Background="White">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tầng" Binding="{Binding FloorLabel}" ElementStyle="{StaticResource CenteredTextElement}" Width="1.5*"/>
                                <DataGridTextColumn Header="Tổng căn hộ" Binding="{Binding TotalApartments}" ElementStyle="{StaticResource CenteredTextElement}" Width="1.5*"/>
                                <DataGridTextColumn Header="Đang ở" Binding="{Binding OccupiedApartments}" ElementStyle="{StaticResource CenteredTextElement}" Width="1.5*"/>
                                <DataGridTextColumn Header="Trống" Binding="{Binding VacantApartments}" ElementStyle="{StaticResource CenteredTextElement}" Width="1.5*"/>
                                <DataGridTemplateColumn Header="Tỷ lệ sử dụng" Width="1.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding OccupancyRate, StringFormat='{}{0:N1}%'}" FontWeight="SemiBold" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Dòng Tổng (Mockup 3) -->
                        <Border Grid.Row="2" Background="#EFF6FF" CornerRadius="0,0,8,8" Padding="10,12" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Tổng" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding AptTotal}" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding AptOccupied}" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding AptVacant}" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding AptOccupancyRateDisplay}" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Thanh phân trang ở đáy bảng -->
                        <Grid Grid.Row="3" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding PaginationSummary}" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Style="{StaticResource PageNumButton}" Command="{Binding PreviousPageCommand}" ToolTip="Trang trước">
                                    <iconPacks:PackIconMaterial Kind="ChevronLeft" Width="14" Height="14" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <ItemsControl ItemsSource="{Binding PageNumbers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" Style="{StaticResource PageNumButton}"
                                                    Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource PageNumButton}" Command="{Binding NextPageCommand}" ToolTip="Trang sau">
                                    <iconPacks:PackIconMaterial Kind="ChevronRight" Width="14" Height="14" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Số dòng/trang: " FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}" Width="65" Height="30" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ══════════════════════════════════════════════════════════
                 6. NỘI DUNG TAB 3: THỐNG KÊ PHƯƠNG TIỆN (Mockup 4)
            ══════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="5" Visibility="{Binding IsTab3Active, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!-- Thanh bộ lọc Tab 3 (giãn cách đều ra) -->
                <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16,12" Margin="0,0,0,18">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Thời gian -->
                        <Grid Grid.Column="0" Margin="0,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                <iconPacks:PackIconMaterial Kind="CalendarBlankOutline" Width="15" Height="15" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Thời gian:" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding TimeModeOptions}" SelectedItem="{Binding SelectedTimeMode}" Height="34" HorizontalAlignment="Stretch"/>
                        </Grid>

                        <!-- Tháng -->
                        <Grid Grid.Column="1" Margin="0,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tháng:" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding MonthOptions}" SelectedItem="{Binding SelectedMonth}" Height="34" HorizontalAlignment="Stretch"/>
                        </Grid>

                        <!-- Năm -->
                        <Grid Grid.Column="2" Margin="0,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Năm:" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding YearOptions}" SelectedItem="{Binding SelectedYear}" Height="34" HorizontalAlignment="Stretch"/>
                        </Grid>

                        <!-- Loại phương tiện -->
                        <Grid Grid.Column="3" Margin="0,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Loại xe:" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding VehicleTypeFilterOptions}" SelectedItem="{Binding SelectedVehicleTypeFilter}" Height="34" HorizontalAlignment="Stretch"/>
                        </Grid>

                        <!-- Trạng thái -->
                        <Grid Grid.Column="4" Margin="0,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Trạng thái:" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding VehicleStatusFilterOptions}" SelectedItem="{Binding SelectedVehicleStatusFilter}" Height="34" HorizontalAlignment="Stretch"/>
                        </Grid>

                        <!-- Nút Thống kê -->
                        <Button Grid.Column="5" Command="{Binding FilterCommand}" Height="34" Padding="14,0" Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <iconPacks:PackIconMaterial Kind="Magnify" Width="13" Height="13" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Thống kê" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Nút Bỏ lọc (Reset) -->
                        <Button Grid.Column="6" Command="{Binding ResetFilterCommand}" Height="34" Padding="14,0" Background="White" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <iconPacks:PackIconMaterial Kind="FilterRemoveOutline" Width="13" Height="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Bỏ lọc" FontSize="13" FontWeight="SemiBold" Foreground="#475569"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- 4 Thẻ KPI Phương tiện -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StatKpiCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#EFF6FF" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="CarOutline" Width="22" Height="22" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding VehTotal}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Tổng phương tiện" FontSize="12.5" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource StatKpiCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#DCFCE7" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="Check" Width="22" Height="22" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding VehApproved}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Đã duyệt" FontSize="12.5" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource StatKpiCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#FEF3C7" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="ClockOutline" Width="22" Height="22" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding VehPending}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Chờ duyệt" FontSize="12.5" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource StatKpiCard}" Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#FEE2E2" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="CloseCircleOutline" Width="22" Height="22" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding VehRejected}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Từ chối" FontSize="12.5" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 2 Biểu đồ Tab 3 -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Số lượng phương tiện theo loại -->
                    <Border Grid.Column="0" Style="{StaticResource ModernStatCard}" Margin="0,0,14,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="ChartBar" Width="16" Height="16" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Số lượng phương tiện theo loại" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Width="10" Height="10" CornerRadius="2" Background="#3B82F6" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Đã duyệt" FontSize="12" Foreground="#64748B" Margin="0,0,14,0"/>
                                    <Border Width="10" Height="10" CornerRadius="2" Background="#FACC15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Chờ duyệt" FontSize="12" Foreground="#64748B" Margin="0,0,14,0"/>
                                    <Border Width="10" Height="10" CornerRadius="2" Background="#F87171" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Từ chối" FontSize="12" Foreground="#64748B"/>
                                </StackPanel>
                            </Grid>
                            <controls:ModernBarChart Grid.Row="1" Categories="{Binding VehTypeDistributionBars}" Height="200"/>
                        </Grid>
                    </Border>

                    <!-- Biểu đồ hình tròn đặc (Pie Chart) Tỷ lệ phương tiện theo trạng thái -->
                    <Border Grid.Column="1" Style="{StaticResource ModernStatCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                                <iconPacks:PackIconMaterial Kind="ChartArc" Width="16" Height="16" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Tỷ lệ phương tiện theo trạng thái" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Pie Chart tròn đặc (HoleRatio = 0) -->
                                <controls:DonutChart Grid.Column="0" Slices="{Binding VehStatusSlices}"
                                                     HoleRatio="0" Width="145" Height="145"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Border Background="#F8FAFC" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="10" Height="10" CornerRadius="3" Background="#2563EB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="Đã duyệt" FontSize="12" Foreground="#0F172A"/>
                                            <TextBlock Grid.Column="2" Text="{Binding VehApprovedRateDisplay}" FontSize="12" FontWeight="Bold" Foreground="#2563EB"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="#F8FAFC" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="10" Height="10" CornerRadius="3" Background="#FACC15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="Chờ duyệt" FontSize="12" Foreground="#0F172A"/>
                                            <TextBlock Grid.Column="2" Text="{Binding VehPendingRateDisplay}" FontSize="12" FontWeight="Bold" Foreground="#D97706"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="#F8FAFC" CornerRadius="8" Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="10" Height="10" CornerRadius="3" Background="#F87171" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="Từ chối" FontSize="12" Foreground="#0F172A"/>
                                            <TextBlock Grid.Column="2" Text="{Binding VehRejectedRateDisplay}" FontSize="12" FontWeight="Bold" Foreground="#DC2626"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Bảng chi tiết phương tiện (Căn giữa nội dung + Phân trang) -->
                <Border Style="{StaticResource ModernStatCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>  <!-- Thanh phân trang -->
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="FormatListBulleted" Width="16" Height="16" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Chi tiết phương tiện" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Command="{Binding ExportReportCommand}"
                                    Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,5" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <iconPacks:PackIconMaterial Kind="DownloadOutline" Width="13" Height="13" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Xuất báo cáo" FontSize="12.5" FontWeight="SemiBold" Foreground="#2563EB"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding PagedVehDetailsTable}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                                  RowStyle="{StaticResource StatDataGridRow}" ColumnHeaderStyle="{StaticResource StatDataGridHeader}"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" BorderThickness="0" Background="White">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" ElementStyle="{StaticResource CenteredTextElement}" Width="50"/>
                                <DataGridTextColumn Header="Biển số" Binding="{Binding LicensePlate}" ElementStyle="{StaticResource CenteredTextElement}" Width="1.5*"/>
                                <DataGridTextColumn Header="Loại phương tiện" Binding="{Binding VehicleTypeLabel}" ElementStyle="{StaticResource CenteredTextElement}" Width="1.5*"/>
                                <DataGridTextColumn Header="Căn hộ" Binding="{Binding ApartmentNumber}" ElementStyle="{StaticResource CenteredTextElement}" Width="1.2*"/>
                                <DataGridTextColumn Header="Chủ sở hữu" Binding="{Binding OwnerName}" ElementStyle="{StaticResource CenteredTextElement}" Width="1.8*"/>
                                
                                <!-- Trạng thái: Pill badge căn giữa -->
                                <DataGridTemplateColumn Header="Trạng thái" Width="1.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F1F5F9"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RegistrationStatus}" Value="Approved">
                                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RegistrationStatus}" Value="Pending">
                                                                <Setter Property="Background" Value="#FEF3C7"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RegistrationStatus}" Value="Rejected">
                                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#475569"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RegistrationStatus}" Value="Approved">
                                                                    <Setter Property="Foreground" Value="#16A34A"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RegistrationStatus}" Value="Pending">
                                                                    <Setter Property="Foreground" Value="#D97706"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RegistrationStatus}" Value="Rejected">
                                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Ngày đăng ký" Binding="{Binding RegistrationDateDisplay}" ElementStyle="{StaticResource CenteredTextElement}" Width="1.5*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Thanh phân trang ở đáy bảng -->
                        <Grid Grid.Row="2" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding PaginationSummary}" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Style="{StaticResource PageNumButton}" Command="{Binding PreviousPageCommand}" ToolTip="Trang trước">
                                    <iconPacks:PackIconMaterial Kind="ChevronLeft" Width="14" Height="14" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <ItemsControl ItemsSource="{Binding PageNumbers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" Style="{StaticResource PageNumButton}"
                                                    Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource PageNumButton}" Command="{Binding NextPageCommand}" ToolTip="Trang sau">
                                    <iconPacks:PackIconMaterial Kind="ChevronRight" Width="14" Height="14" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Số dòng/trang: " FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}" Width="65" Height="30" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
        <!-- FLOATING TOAST NOTIFICATIONS (GÓC DƯỚI BÊN PHẢI - 3S) -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,28,24" Panel.ZIndex="9999" IsHitTestVisible="True">
            <controls:NotificationBanner Message="{Binding SuccessMessage}" Kind="Success" Margin="0,0,0,8"/>
            <controls:NotificationBanner Message="{Binding ErrorMessage}" Kind="Error"/>
        </StackPanel>
    </Grid>
</UserControl>
