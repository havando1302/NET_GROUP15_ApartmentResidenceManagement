<UserControl x:Class="ApartmentResidenceManagement.Wpf.Views.ResidentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:ApartmentResidenceManagement.Wpf.Controls"
             xmlns:enums="clr-namespace:ApartmentResidenceManagement.Domain.Enums;assembly=ApartmentResidenceManagement.Domain"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200"
             Background="#F8FAFC">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Override System Highlight để loại bỏ viền đen mặc định của WPF DataGrid -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E0F2FE"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E0F2FE"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A"/>

        <!-- Modern DataGrid Cell -->
        <Style x:Key="ModernDataGridCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell" BasedOn="{StaticResource ModernDataGridCell}"/>

        <!-- Modern DataGrid Row -->
        <Style x:Key="ModernResidentDataGridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#F1F5F9"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnResidentRowPreviewMouseLeftButtonUp"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E0F2FE"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Column Header -->
        <Style x:Key="ModernDataGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- Pagination Page Button -->
        <Style x:Key="PageNavBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="Background" Value="#2563EB"/>
                                <Setter Property="BorderBrush" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEllipsis}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- TOÀN BỘ NỘI DUNG CHÍNH (SCROLLVIEWER ĐẢM BẢO KHÔNG BỊ TRÀN MÀN HÌNH NHỎ) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28,24,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0. Header -->
                    <RowDefinition Height="Auto"/> <!-- 1. 4 KPI Cards -->
                    <RowDefinition Height="Auto"/> <!-- 2. Notification Banner -->
                    <RowDefinition Height="*"/>    <!-- 3. Main Split (Danh sách cư dân + Chi tiết) -->
                </Grid.RowDefinitions>

                <!-- ================= 0. HEADER ================= -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12"
                            Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1"
                            Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="👥" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Quản lý Cư dân" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Quản lý hồ sơ cư dân, thông tin định danh và tình trạng cư trú."
                                   FontSize="13" Foreground="#64748B" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- ================= 1. 4 THẺ KPI ================= -->
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- KPI 1: Tổng hồ sơ cư dân -->
                    <Border Grid.Column="0" Background="White" CornerRadius="14" BorderBrush="#F1F5F9" BorderThickness="1" Padding="18,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="#000000" Opacity="0.03"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#EEF2FF" BorderBrush="#E0E7FF" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="👥" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TotalResidentsCount}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Tổng hồ sơ cư dân" FontSize="12.5" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- KPI 2: Đang cư trú -->
                    <Border Grid.Column="2" Background="White" CornerRadius="14" BorderBrush="#F1F5F9" BorderThickness="1" Padding="18,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="#000000" Opacity="0.03"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#DCFCE7" BorderBrush="#BBF7D0" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="🏠" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActiveResidentsCount}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Đang cư trú" FontSize="12.5" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- KPI 3: Đã chuyển đi -->
                    <Border Grid.Column="4" Background="White" CornerRadius="14" BorderBrush="#F1F5F9" BorderThickness="1" Padding="18,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="#000000" Opacity="0.03"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#FFEDD5" BorderBrush="#FED7AA" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="🚪" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MovedOutResidentsCount}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Đã chuyển đi" FontSize="12.5" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- KPI 4: Chưa đăng ký cư trú -->
                    <Border Grid.Column="6" Background="White" CornerRadius="14" BorderBrush="#F1F5F9" BorderThickness="1" Padding="18,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="#000000" Opacity="0.03"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#F3E8FF" BorderBrush="#E9D5FF" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="👤⁺" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UnregisteredResidentsCount}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Chưa đăng ký cư trú" FontSize="12.5" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ================= 2. THÔNG BÁO LỖI / THÀNH CÔNG ================= -->
                <StackPanel Grid.Row="2" Margin="0,0,0,16">
                    <controls:NotificationBanner Message="{Binding ErrorMessage}" Kind="Error"/>
                    <controls:NotificationBanner Message="{Binding SuccessMessage}" Kind="Success" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- ================= 3. KHỐI CHÍNH (CỘT TRÁI: BẢNG + CỘT PHẢI: CHI TIẾT) ================= -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.3*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="1.1*" MinWidth="340" MaxWidth="440"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===== CỘT TRÁI: DANH SÁCH CƯ DÂN ===== -->
                    <Border Grid.Column="0" Background="White" CornerRadius="16" BorderBrush="#F1F5F9" BorderThickness="1" Padding="20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Color="#000000" Opacity="0.03"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Tiêu đề Card + Nút Thêm cư dân -->
                                <RowDefinition Height="Auto"/> <!-- Thanh công cụ tìm kiếm & bộ lọc -->
                                <RowDefinition Height="*"/>    <!-- DataGrid -->
                                <RowDefinition Height="Auto"/> <!-- Thanh phân trang -->
                            </Grid.RowDefinitions>

                            <!-- Tiêu đề card + Nút Thêm cư dân -->
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📑" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Danh sách cư dân" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Nút + Thêm cư dân xanh dương nổi bật -->
                                <Button Grid.Column="1" Height="36" Padding="16,0"
                                        Background="#2563EB" Foreground="White"
                                        FontWeight="SemiBold" FontSize="13"
                                        BorderThickness="0" Cursor="Hand"
                                        Command="{Binding OpenAddFormCommand}">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="＋" FontSize="14" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Thêm cư dân" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Thanh công cụ tìm kiếm & lọc -->
                            <Grid Grid.Row="1" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Ô Tìm kiếm -->
                                <Grid Grid.Column="0" Margin="0,0,10,0">
                                    <TextBox Style="{StaticResource ModernTextBox}"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Height="38"
                                             Padding="36,0,12,0"
                                             Tag="Tìm theo mã, họ tên, số định danh..."/>
                                    <TextBlock Text="🔍" FontSize="13" Foreground="#94A3B8"
                                               VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                                </Grid>

                                <!-- Dropdown Lọc Trạng thái -->
                                <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Height="38" Padding="10,0" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Trạng thái: " FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                                                  SelectedItem="{Binding SelectedStatusFilter}"
                                                  BorderThickness="0"
                                                  Background="Transparent"
                                                  FontSize="13"
                                                  FontWeight="SemiBold"
                                                  Foreground="#0F172A"
                                                  VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Dropdown Lọc Căn hộ -->
                                <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Height="38" Padding="10,0" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Căn hộ: " FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <ComboBox ItemsSource="{Binding ApartmentFilterOptions}"
                                                  SelectedItem="{Binding SelectedApartmentFilter}"
                                                  BorderThickness="0"
                                                  Background="Transparent"
                                                  FontSize="13"
                                                  FontWeight="SemiBold"
                                                  Foreground="#0F172A"
                                                  VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Nút Làm mới -->
                                <Button Grid.Column="3" Content="↻ Làm mới"
                                        Style="{StaticResource OutlineButton}"
                                        Height="38"
                                        Padding="14,0"
                                        FontWeight="Medium"
                                        FontSize="13"
                                        Command="{Binding RefreshCommand}"/>
                            </Grid>

                            <!-- BẢNG DỮ LIỆU DATAGRID -->
                            <Grid Grid.Row="2" MinHeight="360">
                                <!-- Loading Indicator -->
                                <Border Background="#80FFFFFF" CornerRadius="8" Panel.ZIndex="10"
                                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="⏳" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                        <TextBlock Text="Đang đồng bộ dữ liệu cư dân..." FontSize="14" Foreground="#64748B"/>
                                    </StackPanel>
                                </Border>

                                <!-- Empty State -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Panel.ZIndex="5">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsLoading}" Value="False"/>
                                                        <Condition Binding="{Binding PagedResidents.Count}" Value="0"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="👤" FontSize="48" HorizontalAlignment="Center" Opacity="0.3" Margin="0,0,0,8"/>
                                    <TextBlock Text="Không tìm thấy cư dân phù hợp" FontSize="15" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Vui lòng thử tìm từ khóa khác hoặc xóa bộ lọc." FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- DataGrid cư dân -->
                                <DataGrid x:Name="ResidentsDataGrid"
                                          ItemsSource="{Binding PagedResidents}"
                                          SelectedItem="{Binding SelectedResidentItem, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserResizeRows="False"
                                          CanUserSortColumns="True"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          GridLinesVisibility="None"
                                          HeadersVisibility="Column"
                                          Background="White"
                                          BorderThickness="0"
                                          RowHeaderWidth="0"
                                          RowStyle="{StaticResource ModernResidentDataGridRow}"
                                          ColumnHeaderStyle="{StaticResource ModernDataGridHeader}"
                                          PreviewMouseWheel="OnResidentsDataGridPreviewMouseWheel">

                                    <DataGrid.Columns>
                                        <!-- Cột 1: STT -->
                                        <DataGridTextColumn Header="#" Binding="{Binding Stt}" Width="45">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Foreground" Value="#64748B"/>
                                                    <Setter Property="FontSize" Value="12.5"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Cột 2: Mã cư dân (CD001) -->
                                        <DataGridTextColumn Header="Mã cư dân" Binding="{Binding ResidentCode}" Width="90">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="#1D4ED8"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                    <Setter Property="Margin" Value="4,0,0,0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Cột 3: Họ và tên -->
                                        <DataGridTextColumn Header="Họ và tên" Binding="{Binding FullName}" Width="1.3*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Foreground" Value="#1E293B"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Cột 4: Ngày sinh -->
                                        <DataGridTextColumn Header="Ngày sinh" Binding="{Binding DateOfBirthFormatted}" Width="100">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Foreground" Value="#334155"/>
                                                    <Setter Property="FontSize" Value="12.5"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Cột 5: Số định danh (CCCD) -->
                                        <DataGridTextColumn Header="Số định danh" Binding="{Binding IdentityCard}" Width="125">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Foreground" Value="#334155"/>
                                                    <Setter Property="FontSize" Value="12.5"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Cột 6: Căn hộ -->
                                        <DataGridTextColumn Header="Căn hộ" Binding="{Binding ApartmentNumber}" Width="85">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Foreground" Value="#1E293B"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Cột 7: Trạng thái (Badge bo tròn kèm chấm tròn màu) -->
                                        <DataGridTemplateColumn Header="Trạng thái" Width="125">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="12" Padding="8,4"
                                                            Background="{Binding StatusBgColor}"
                                                            BorderBrush="{Binding StatusBorderColor}"
                                                            BorderThickness="1"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="●" FontSize="9"
                                                                       Foreground="{Binding StatusDotColor}"
                                                                       Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding StatusText}" FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{Binding StatusFgColor}"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Cột 8: Thao tác (3 nút tròn: 👁 Xem, ✏️ Sửa, 🗑️ Xóa) -->
                                        <DataGridTemplateColumn Header="Thao tác" Width="125">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <!-- Nút 1: Xem chi tiết (👁 Xanh dương) -->
                                                        <Button Width="28" Height="28" Margin="2,0"
                                                                ToolTip="Xem chi tiết cư dân"
                                                                Command="{Binding DataContext.ViewResidentDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="14" x:Name="btnBorder">
                                                                        <TextBlock Text="👁" FontSize="13" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="btnBorder" Property="Background" Value="#DBEAFE"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>

                                                        <!-- Nút 2: Sửa thông tin (✏️ Vàng hổ phách) -->
                                                        <Button Width="28" Height="28" Margin="2,0"
                                                                ToolTip="Sửa thông tin cư dân"
                                                                Command="{Binding DataContext.OpenEditFormCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="14" x:Name="btnBorder">
                                                                        <TextBlock Text="✏️" FontSize="12" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="btnBorder" Property="Background" Value="#FDE68A"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>

                                                        <!-- Nút 3: Xóa cư dân (🗑️ Đỏ) -->
                                                        <Button Width="28" Height="28" Margin="2,0"
                                                                ToolTip="Xóa hồ sơ cư dân"
                                                                Command="{Binding DataContext.DeleteResidentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="14" x:Name="btnBorder">
                                                                        <TextBlock Text="🗑️" FontSize="12" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="btnBorder" Property="Background" Value="#FECACA"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>

                            <!-- THANH PHÂN TRANG -->
                            <Grid Grid.Row="3" Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Text hiển thị số dòng: Hiển thị 8 / 82 cư dân -->
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="13" Foreground="#64748B">
                                    <Run Text="Hiển thị "/>
                                    <Run Text="{Binding PagedResidents.Count, Mode=OneWay}" FontWeight="SemiBold" Foreground="#0F172A"/>
                                    <Run Text=" / "/>
                                    <Run Text="{Binding TotalItems, Mode=OneWay}" FontWeight="SemiBold" Foreground="#0F172A"/>
                                    <Run Text=" cư dân"/>
                                </TextBlock>

                                <!-- Dãy nút chuyển trang: < 1 2 3 ... 11 > -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Nút Previous < -->
                                    <Button Style="{StaticResource PageNavBtnStyle}" Content="‹"
                                            Command="{Binding PreviousPageCommand}"
                                            ToolTip="Trang trước"/>

                                    <!-- Danh sách các số trang -->
                                    <ItemsControl ItemsSource="{Binding PaginationPages}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource PageNavBtnStyle}"
                                                        Content="{Binding DisplayText}"
                                                        Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Nút Next > -->
                                    <Button Style="{StaticResource PageNavBtnStyle}" Content="›"
                                            Command="{Binding NextPageCommand}"
                                            ToolTip="Trang kế tiếp"/>
                                </StackPanel>

                                <!-- Chọn số dòng mỗi trang: Số dòng/trang: [ 8 ▾ ] -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Số dòng/trang:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox ItemsSource="{Binding PageSizeOptions}"
                                              SelectedItem="{Binding PageSize}"
                                              Width="68" Height="32"
                                              FontSize="13"
                                              FontWeight="SemiBold"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ===== CỘT PHẢI: CHI TIẾT CƯ DÂN ===== -->
                    <Border Grid.Column="2" Background="White" CornerRadius="16" BorderBrush="#F1F5F9" BorderThickness="1" Padding="20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Color="#000000" Opacity="0.03"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Tiêu đề Card Chi tiết cư dân -->
                                <RowDefinition Height="*"/>    <!-- Thông tin chi tiết -->
                            </Grid.RowDefinitions>

                            <!-- Tiêu đề Card Chi tiết cư dân -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock Text="🪪" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Chi tiết cư dân" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Body chi tiết -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <!-- Khối Avatar + Tên + Mã cư dân + Badge trạng thái -->
                                    <StackPanel HorizontalAlignment="Center" Margin="0,8,0,18">
                                        <!-- Avatar tròn viền xám mềm -->
                                        <Border Width="76" Height="76" CornerRadius="38" BorderBrush="#E2E8F0" BorderThickness="2" HorizontalAlignment="Center">
                                            <Image Source="{Binding SelectedResidentItem.AvatarPath, FallbackValue='/Assets/resident_avatar.png'}" Stretch="UniformToFill">
                                                <Image.Clip>
                                                    <EllipseGeometry Center="38,38" RadiusX="36" RadiusY="36"/>
                                                </Image.Clip>
                                            </Image>
                                        </Border>

                                        <!-- Họ và tên cư dân -->
                                        <TextBlock Text="{Binding SelectedResidentItem.FullName, FallbackValue='Chưa chọn cư dân'}"
                                                   FontSize="18" FontWeight="Bold" Foreground="#0F172A"
                                                   HorizontalAlignment="Center" Margin="0,10,0,2"/>

                                        <!-- Mã cư dân: CD001 -->
                                        <TextBlock Text="{Binding SelectedResidentItem.ResidentCode, StringFormat='Mã cư dân: {0}', FallbackValue='Mã cư dân: ---'}"
                                                   FontSize="12.5" Foreground="#64748B" HorizontalAlignment="Center"/>

                                        <!-- Badge trạng thái: ● Đang cư trú -->
                                        <Border CornerRadius="12" Padding="10,4"
                                                Background="{Binding SelectedResidentItem.StatusBgColor, FallbackValue='#F1F5F9'}"
                                                BorderBrush="{Binding SelectedResidentItem.StatusBorderColor, FallbackValue='#E2E8F0'}"
                                                BorderThickness="1"
                                                HorizontalAlignment="Center" Margin="0,8,0,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="●" FontSize="9"
                                                           Foreground="{Binding SelectedResidentItem.StatusDotColor, FallbackValue='#64748B'}"
                                                           Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SelectedResidentItem.StatusText, FallbackValue='Chưa xác định'}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{Binding SelectedResidentItem.StatusFgColor, FallbackValue='#475569'}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- NHÓM 1: Thông tin cá nhân -->
                                    <TextBlock Text="Thông tin cá nhân" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,10"/>

                                    <Border Background="#F8FAFC" CornerRadius="10" Padding="14,10" Margin="0,0,0,16">
                                        <StackPanel>
                                            <!-- Ngày sinh -->
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                                    <TextBlock Text="📅" FontSize="13" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Ngày sinh" FontSize="13" Foreground="#64748B"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding SelectedResidentItem.DateOfBirthFormatted, FallbackValue='-'}"
                                                           FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <!-- Giới tính -->
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                                    <TextBlock Text="🚻" FontSize="13" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Giới tính" FontSize="13" Foreground="#64748B"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding SelectedResidentItem.GenderText, FallbackValue='-'}"
                                                           FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <!-- Số định danh (CCCD) -->
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                                    <TextBlock Text="🪪" FontSize="13" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Số định danh" FontSize="13" Foreground="#64748B"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding SelectedResidentItem.IdentityCard, FallbackValue='-'}"
                                                           FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <!-- Số điện thoại -->
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                                    <TextBlock Text="📞" FontSize="13" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Số điện thoại" FontSize="13" Foreground="#64748B"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding SelectedResidentItem.PhoneNumber, FallbackValue='-'}"
                                                           FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <!-- Quê quán -->
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                                    <TextBlock Text="📍" FontSize="13" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Quê quán" FontSize="13" Foreground="#64748B"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding SelectedResidentItem.HomeTown, FallbackValue='-'}"
                                                           FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- NHÓM 2: Thông tin cư trú hiện tại -->
                                    <TextBlock Text="Thông tin cư trú hiện tại" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>

                                    <Border CornerRadius="10" Padding="14,12" Background="#F0FDF4" BorderBrush="#DCFCE7" BorderThickness="1">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🏠" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock FontSize="13.5" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center">
                                                    <Run Text="Căn hộ: "/>
                                                    <Run Text="{Binding SelectedResidentItem.ApartmentNumber, FallbackValue='-'}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="📅" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock FontSize="12.5" Foreground="#475569" VerticalAlignment="Center">
                                                    <Run Text="Bắt đầu cư trú: "/>
                                                    <Run Text="{Binding SelectedResidentItem.ResidencyStartDateFormatted, FallbackValue='-'}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- NÚT: Xem lịch sử cư trú -->
                                    <Button Content="🕒  Xem lịch sử cư trú"
                                            Height="40"
                                            Margin="0,18,0,0"
                                            Style="{StaticResource OutlineButton}"
                                            BorderBrush="#E2E8F0"
                                            Foreground="#0F172A"
                                            FontWeight="SemiBold"
                                            FontSize="13"
                                            Cursor="Hand"
                                            Command="{Binding OpenResidencyHistoryModalCommand}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- ================= MODAL 1: FORM THÊM / CẬP NHẬT CƯ DÂN ================= -->
        <Grid Panel.ZIndex="200" Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#80000000">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CancelFormCommand}"/>
                </Border.InputBindings>
            </Border>

            <Border MaxWidth="520" Margin="16,24"
                    Background="White" CornerRadius="16" Padding="28"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="10" Color="#000000" Opacity="0.15"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title -->
                        <RowDefinition Height="*"/>    <!-- Fields -->
                        <RowDefinition Height="Auto"/> <!-- Error message -->
                        <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="{Binding FormTitle}" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Vui lòng kiểm tra và điền đầy đủ các trường thông tin bên dưới."
                                   FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="520">
                        <StackPanel Margin="0,0,0,8">
                            <!-- Họ và tên -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Họ và tên *" FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Height="40"
                                         Text="{Binding EditingResident.FullName, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Ví dụ: Nguyễn Văn A"/>
                            </StackPanel>

                            <!-- Ngày sinh & Giới tính -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Ngày sinh *" FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,6"/>
                                    <DatePicker SelectedDate="{Binding EditingResident.DateOfBirth}" Height="40" FontSize="13" Background="White"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Giới tính *" FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,6"/>
                                    <ComboBox Height="40" ItemsSource="{Binding GenderOptions}" SelectedItem="{Binding EditingResident.Gender}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding}" Value="{x:Static enums:GenderType.Male}">
                                                                    <Setter Property="Text" Value="Nam"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding}" Value="{x:Static enums:GenderType.Female}">
                                                                    <Setter Property="Text" Value="Nữ"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding}" Value="{x:Static enums:GenderType.Other}">
                                                                    <Setter Property="Text" Value="Khác"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- CCCD & Số điện thoại -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Số CCCD / CMND" FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,6"/>
                                    <TextBox Style="{StaticResource ModernTextBox}" Height="40"
                                             Text="{Binding EditingResident.IdentityCard, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="12 số căn cước"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Số điện thoại" FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,6"/>
                                    <TextBox Style="{StaticResource ModernTextBox}" Height="40"
                                             Text="{Binding EditingResident.PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="0912..."/>
                                </StackPanel>
                            </Grid>

                            <!-- Quê quán -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Quê quán / Hộ khẩu thường trú" FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Height="40"
                                         Text="{Binding EditingResident.HomeTown, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Tỉnh/Thành phố hoặc địa chỉ"/>
                            </StackPanel>

                            <!-- Email -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Email liên hệ" FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Height="40"
                                         Text="{Binding EditingResident.Email, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="example@domain.com"/>
                            </StackPanel>

                            <!-- ĐĂNG KÝ CƯ TRÚ NHANH (Chỉ hiển thị khi thêm mới cư dân) -->
                            <Border CornerRadius="10" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14" Margin="0,4,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EditingResident.Id}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <CheckBox Content="Đăng ký vào căn hộ ngay sau khi tạo"
                                              IsChecked="{Binding IsQuickResidenceRegistration}"
                                              FontSize="13" FontWeight="SemiBold" Foreground="#1D4ED8"/>

                                    <StackPanel Visibility="{Binding IsQuickResidenceRegistration, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Chọn căn hộ" FontSize="12.5" Foreground="#64748B" Margin="0,0,0,4"/>
                                                <ComboBox Height="36" ItemsSource="{Binding AvailableApartments}"
                                                          SelectedItem="{Binding SelectedApartmentForRegistration}"
                                                          DisplayMemberPath="ApartmentNumber"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Quan hệ cư trú" FontSize="12.5" Foreground="#64748B" Margin="0,0,0,4"/>
                                                <ComboBox Height="36" ItemsSource="{Binding RelationshipOptions}"
                                                          SelectedItem="{Binding RegistrationRelationship}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock>
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding}" Value="{x:Static enums:RelationshipType.Owner}">
                                                                                <Setter Property="Text" Value="Chủ hộ"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding}" Value="{x:Static enums:RelationshipType.FamilyMember}">
                                                                                <Setter Property="Text" Value="Thành viên gia đình"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding}" Value="{x:Static enums:RelationshipType.Tenant}">
                                                                                <Setter Property="Text" Value="Khách thuê"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding}" Value="{x:Static enums:RelationshipType.Temporary}">
                                                                                <Setter Property="Text" Value="Tạm trú"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel>
                                            <TextBlock Text="Ngày bắt đầu cư trú" FontSize="12.5" Foreground="#64748B" Margin="0,0,0,4"/>
                                            <DatePicker SelectedDate="{Binding RegistrationStartDate}" Height="36" Background="White"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Error message banner -->
                    <controls:NotificationBanner Grid.Row="2" Message="{Binding ErrorMessage}" Kind="Error" Margin="0,12,0,0"/>

                    <!-- Footer Buttons -->
                    <Grid Grid.Row="3" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Hủy bỏ" Style="{StaticResource OutlineButton}"
                                Height="42" FontSize="13.5" Command="{Binding CancelFormCommand}"/>

                        <Button Grid.Column="2" Content="Lưu thông tin" Style="{StaticResource PrimaryButton}"
                                Height="42" FontSize="13.5" FontWeight="SemiBold" Command="{Binding SaveResidentCommand}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= MODAL 2: POPUP XEM LỊCH SỬ CƯ TRÚ ================= -->
        <Grid Panel.ZIndex="210" Visibility="{Binding IsHistoryDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#80000000">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseResidencyHistoryModalCommand}"/>
                </Border.InputBindings>
            </Border>

            <Border MaxWidth="620" Margin="16,24"
                    Background="White" CornerRadius="16" Padding="26"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="10" Color="#000000" Opacity="0.15"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title -->
                        <RowDefinition Height="*"/>    <!-- Table -->
                        <RowDefinition Height="Auto"/> <!-- Close Button -->
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🕒" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center">
                                <Run Text="Lịch sử cư trú: "/>
                                <Run Text="{Binding SelectedResidentItem.FullName}" Foreground="#1D4ED8"/>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="Danh sách các thời kỳ cư trú tại các căn hộ của cư dân này."
                                   FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1" MaxHeight="380">
                        <!-- Empty history state -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,30">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ResidentHistoryList.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Chưa có dữ liệu lịch sử cư trú nào." FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- History table -->
                        <DataGrid ItemsSource="{Binding ResidentHistoryList}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  Background="White"
                                  BorderThickness="1"
                                  BorderBrush="#F1F5F9"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Stt}" Width="40"/>
                                <DataGridTextColumn Header="Căn hộ" Binding="{Binding ApartmentNumber}" Width="100"/>
                                <DataGridTextColumn Header="Quan hệ" Binding="{Binding RelationshipText}" Width="140"/>
                                <DataGridTextColumn Header="Bắt đầu" Binding="{Binding StartDateFormatted}" Width="100"/>
                                <DataGridTextColumn Header="Kết thúc" Binding="{Binding EndDateFormatted}" Width="100"/>
                                <DataGridTemplateColumn Header="Tình trạng" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="6,2"
                                                    Background="{Binding StatusBg}"
                                                    BorderBrush="{Binding StatusBorder}"
                                                    BorderThickness="1"
                                                    HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                           FontWeight="SemiBold" Foreground="{Binding StatusFg}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Button Grid.Row="2" Content="Đóng" Style="{StaticResource OutlineButton}"
                            Height="40" Margin="0,18,0,0" Command="{Binding CloseResidencyHistoryModalCommand}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= MODAL 3: QUẢN LÝ TÀI KHOẢN (BACKWARD COMPATIBILITY) ================= -->
        <Grid Panel.ZIndex="220" Visibility="{Binding IsAccountPanelOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#80000000">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseAccountPanelCommand}"/>
                </Border.InputBindings>
            </Border>

            <Border MaxWidth="480" Margin="16,24"
                    Background="White" CornerRadius="16" Padding="24"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="10" Color="#000000" Opacity="0.15"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Tài khoản đăng nhập" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock FontSize="13" Foreground="#64748B" Margin="0,4,0,0">
                            <Run Text="Cư dân: "/>
                            <Run Text="{Binding SelectedResident.FullName}" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <Border Background="#F8FAFC" CornerRadius="10" Padding="14" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="Trạng thái tài khoản:" Foreground="#64748B" FontSize="13"/>
                                <TextBlock Text="{Binding AccountStatusText}" FontWeight="Bold" FontSize="14" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedResidentHasAccount}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Tên đăng nhập" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Height="40" Text="{Binding AccountUsername, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Mật khẩu khởi tạo (Từ 6 ký tự)" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource ModernTextBox}" Height="40" Text="{Binding AccountPassword, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Visibility="{Binding SelectedResidentHasAccount, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Username liên kết:" Foreground="#64748B" FontSize="13"/>
                            <TextBlock Text="{Binding AccountUsername}" FontWeight="SemiBold" Foreground="#1D4ED8" FontSize="14" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <controls:NotificationBanner Grid.Row="2" Message="{Binding ErrorMessage}" Kind="Error" Margin="0,12,0,0"/>

                    <StackPanel Grid.Row="3" Margin="0,16,0,0">
                        <Button Content="Cấp tài khoản mới" Height="42" Command="{Binding CreateAccountCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedResidentHasAccount}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Đổi trạng thái (Mở / Khóa)" Height="42" Style="{StaticResource PrimaryButton}"
                                Visibility="{Binding SelectedResidentHasAccount, Converter={StaticResource BoolToVis}}"
                                Command="{Binding ToggleAccountStatusCommand}"/>
                        <Button Content="Đóng" Style="{StaticResource OutlineButton}" Height="40" Margin="0,10,0,0"
                                Command="{Binding CloseAccountPanelCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
