<UserControl x:Class="ApartmentResidenceManagement.Wpf.Views.UnderDevelopmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             FontFamily="Segoe UI"
             Background="{StaticResource PageBgBrush}">

    <Grid Margin="32">
        <!-- Khung bo tròn card chính giữa màn hình -->
        <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1"
                MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="40,36">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" Direction="270" ShadowDepth="4" Color="#0F172A" Opacity="0.06"/>
            </Border.Effect>

            <StackPanel HorizontalAlignment="Center">
                <!-- Icon minh hoạ lớn -->
                <Border Width="80" Height="80" Background="#EFF6FF" CornerRadius="40" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="{Binding FeatureIcon}" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Tiêu đề tính năng -->
                <TextBlock Text="{Binding FeatureTitle}" FontSize="22" FontWeight="Bold" Foreground="#0F172A"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,10"/>

                <!-- Nhãn trạng thái "Đang phát triển" -->
                <Border Background="#FEF3C7" CornerRadius="12" Padding="12,4" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙ " FontSize="12" Foreground="#D97706"/>
                        <TextBlock Text="Đang phát triển" FontSize="12" FontWeight="SemiBold" Foreground="#B45309"/>
                    </StackPanel>
                </Border>

                <!-- Mô tả -->
                <TextBlock Text="{Binding FeatureDescription}" FontSize="14" Foreground="#64748B"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,28"/>

                <!-- Nút quay lại Trang chủ -->
                <Button Content="← Quay lại Trang chủ"
                        Command="{Binding BackToHomeCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Height="42" Padding="24,0"
                        HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
