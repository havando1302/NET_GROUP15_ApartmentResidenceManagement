<UserControl x:Class="ApartmentResidenceManagement.Wpf.Views.VehicleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ApartmentResidenceManagement.Wpf.Behaviors"
             xmlns:controls="clr-namespace:ApartmentResidenceManagement.Wpf.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:enums="clr-namespace:ApartmentResidenceManagement.Domain.Enums;assembly=ApartmentResidenceManagement.Domain"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{StaticResource PageBgBrush}">

    <UserControl.Resources>

        <!-- DataGrid Header — Green Admin -->
        <Style x:Key="AdminGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F5F7FC"/>
            <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="#E7EBF4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- DataGrid Row -->
        <Style x:Key="AdminGridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#F1F1F1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="42"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFF5FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCEAFF"/>
                    <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Form TextBox -->
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource BorderHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Form ComboBox -->
        <Style x:Key="FormComboBox" TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Nút chính Admin Green -->
        <Style x:Key="AdminPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource TextDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút phụ (Refresh, Hủy) -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#ECEFF1"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CFD8DC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút hành động trong DataGrid (nhỏ) -->
        <Style x:Key="GridActionBtn" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="4" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="#F2F5FB">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid Margin="24,20" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="Quản lý Phương tiện" FontSize="25" FontWeight="Bold" Foreground="#15223B"/>
                <TextBlock Text="Theo dõi, đăng ký và phê duyệt phương tiện của cư dân." Foreground="#64748B" FontSize="13" Margin="0,5,0,0"/>
            </StackPanel>
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
                <Border Background="White" CornerRadius="10" Padding="16,13" Margin="0,0,10,0" BorderBrush="#E5EAF3" BorderThickness="1">
                    <StackPanel><TextBlock Text="TỔNG PHƯƠNG TIỆN" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/><TextBlock Text="{Binding TotalCount}" FontSize="26" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0"/></StackPanel>
                </Border>
                <Border Background="White" CornerRadius="10" Padding="16,13" Margin="0,0,10,0" BorderBrush="#E5EAF3" BorderThickness="1">
                    <StackPanel><TextBlock Text="ĐÃ DUYỆT" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/><TextBlock Text="{Binding ApprovedCount}" FontSize="26" FontWeight="Bold" Foreground="#16A34A" Margin="0,4,0,0"/></StackPanel>
                </Border>
                <Border Background="White" CornerRadius="10" Padding="16,13" Margin="0,0,10,0" BorderBrush="#E5EAF3" BorderThickness="1">
                    <StackPanel><TextBlock Text="CHỜ DUYỆT" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/><TextBlock Text="{Binding PendingCount}" FontSize="26" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0"/></StackPanel>
                </Border>
                <Border Background="White" CornerRadius="10" Padding="16,13" BorderBrush="#E5EAF3" BorderThickness="1">
                    <StackPanel><TextBlock Text="TỪ CHỐI" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/><TextBlock Text="{Binding RejectedCount}" FontSize="26" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,0"/></StackPanel>
                </Border>
            </UniformGrid>
            <controls:NotificationBanner Grid.Row="2" Message="{Binding ErrorMessage}" Kind="Error" Margin="0,0,0,10"/>
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="440"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*" MinWidth="260"/></Grid.ColumnDefinitions>
                <Border Background="White" BorderBrush="#E5EAF3" BorderThickness="1" CornerRadius="10" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,14">
                            <Button DockPanel.Dock="Right" Content="＋  Thêm phương tiện" Style="{StaticResource AdminPrimaryBtn}" Command="{Binding OpenAddFormCommand}"/>
                            <TextBlock Text="Danh sách phương tiện" FontSize="17" FontWeight="Bold" Foreground="#15223B" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid Margin="0,0,8,0">
                                <TextBox Style="{StaticResource FormTextBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tìm theo biển số, chủ phương tiện hoặc căn hộ"/>
                                <TextBlock Text="Tìm biển số, chủ xe, căn hộ..." Foreground="#94A3B8" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <ComboBox Grid.Column="1" Style="{StaticResource FormComboBox}" ItemsSource="{Binding TypeFilterOptions}" SelectedItem="{Binding SelectedTypeFilter}" ToolTip="Lọc theo loại xe" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="2" Style="{StaticResource FormComboBox}" ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding SelectedStatusFilter}" ToolTip="Lọc theo trạng thái" Margin="0,0,8,0"/>
                            <Button Grid.Column="3" Content="↻  Làm mới" Style="{StaticResource SecondaryBtn}" Command="{Binding LoadVehiclesCommand}"/>
                        </Grid>
                        <Grid Grid.Row="2">
                            <DataGrid ItemsSource="{Binding Vehicles}" SelectedItem="{Binding SelectedVehicleItem}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF1F6" BorderThickness="0" Background="White" RowStyle="{StaticResource AdminGridRow}" ColumnHeaderStyle="{StaticResource AdminGridHeader}" SelectionMode="Single" SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Biển số" Binding="{Binding LicensePlate}" Width="1.2*"/>
                                    <DataGridTextColumn Header="Loại xe" Binding="{Binding VehicleTypeText}" Width="*"/>
                                    <DataGridTextColumn Header="Hãng xe" Binding="{Binding Brand}" Width="*"/>
                                    <DataGridTextColumn Header="Màu xe" Binding="{Binding Color}" Width="*"/>
                                    <DataGridTextColumn Header="Chủ phương tiện" Binding="{Binding OwnerName}" Width="1.5*"/>
                                    <DataGridTextColumn Header="Căn hộ" Binding="{Binding ApartmentNumber}" Width="*"/>
                                    <DataGridTemplateColumn Header="Trạng thái" Width="1.1*">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <Border CornerRadius="10" Padding="9,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#FFF5DB"/><Style.Triggers><DataTrigger Binding="{Binding RegistrationStatus}" Value="{x:Static enums:VehicleRegistrationStatus.Approved}"><Setter Property="Background" Value="#DCFCE7"/></DataTrigger><DataTrigger Binding="{Binding RegistrationStatus}" Value="{x:Static enums:VehicleRegistrationStatus.Rejected}"><Setter Property="Background" Value="#FEE2E2"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                <TextBlock Text="{Binding RegistrationStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                                            </Border>
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="Không tìm thấy phương tiện phù hợp." Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding FilteredCount}" Value="0"/><Condition Binding="{Binding IsLoading}" Value="False"/><Condition Binding="{Binding HasError}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Đang tải dữ liệu..." HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" Padding="16" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                        <DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="False">
                            <TextBlock Text="{Binding PageSummary}" Foreground="#64748B" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Số dòng:" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}" Width="58" Margin="0,0,12,0"/>
                                <Button Content="‹" Style="{StaticResource SecondaryBtn}" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}"/>
                                <TextBlock Text="{Binding PageIndicator}" VerticalAlignment="Center" Margin="10,0"/>
                                <Button Content="›" Style="{StaticResource SecondaryBtn}" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}"/>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Background="White" BorderBrush="#E5EAF3" BorderThickness="1" CornerRadius="10" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Chi tiết phương tiện" FontSize="17" FontWeight="Bold" Foreground="#15223B"/>
                        <Grid Grid.Row="1" Margin="0,16,0,0">
                            <TextBlock Text="Chọn một phương tiện để xem thông tin." TextWrapping="Wrap" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasSelection}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel>
                                <Border Background="#EFF6FF" CornerRadius="9" Padding="14" Margin="0,0,0,18">
                                    <StackPanel><TextBlock Text="{Binding SelectedVehicleItem.LicensePlate}" FontSize="21" FontWeight="Bold" Foreground="#1D4ED8"/><TextBlock Text="{Binding SelectedVehicleItem.RegistrationStatusText}" FontWeight="SemiBold" Foreground="#475569" Margin="0,5,0,0"/></StackPanel>
                                </Border>
                                <TextBlock Text="THÔNG TIN ĐĂNG KÝ" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,12"/>
                                <TextBlock Text="Chủ phương tiện" Foreground="#64748B"/><TextBlock Text="{Binding SelectedVehicleItem.OwnerName}" FontWeight="SemiBold" Margin="0,3,0,12"/>
                                <TextBlock Text="Căn hộ" Foreground="#64748B"/><TextBlock Text="{Binding SelectedVehicleItem.ApartmentNumber}" FontWeight="SemiBold" Margin="0,3,0,12"/>
                                <TextBlock Text="Loại xe" Foreground="#64748B"/><TextBlock Text="{Binding SelectedVehicleItem.VehicleTypeText}" FontWeight="SemiBold" Margin="0,3,0,12"/>
                                <TextBlock Text="Hãng xe" Foreground="#64748B"/><TextBlock Text="{Binding SelectedVehicleItem.Brand}" FontWeight="SemiBold" Margin="0,3,0,10"/>
                                <TextBlock Text="Màu xe" Foreground="#64748B"/><TextBlock Text="{Binding SelectedVehicleItem.Color}" FontWeight="SemiBold" Margin="0,3,0,10"/>
                                <TextBlock Text="Ngày đăng ký" Foreground="#64748B"/><TextBlock Text="{Binding SelectedVehicleItem.RegisteredDateText}" FontWeight="SemiBold" Margin="0,3,0,12"/>
                                <Border Background="#F5F8FD" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <StackPanel><TextBlock Text="HẠN MỨC CĂN HỘ" Foreground="#475569" FontWeight="Bold" FontSize="11"/>
                                        <TextBlock Text="Xe máy" Foreground="#64748B" Margin="0,8,0,0"/><TextBlock Text="{Binding MotorcycleQuotaText}" FontWeight="SemiBold"/>
                                        <ProgressBar Minimum="0" Maximum="{Binding MotorcycleQuotaLimit}" Value="{Binding MotorcycleQuotaCount}" Height="6" Margin="0,5,0,0" Foreground="#16A34A"/>
                                        <TextBlock Text="Ô tô" Foreground="#64748B" Margin="0,8,0,0"/><TextBlock Text="{Binding CarQuotaText}" FontWeight="SemiBold"/>
                                        <ProgressBar Minimum="0" Maximum="{Binding CarQuotaLimit}" Value="{Binding CarQuotaCount}" Height="6" Margin="0,5,0,0" Foreground="#EAB308"/>
                                        <TextBlock Text="Chỉ tính xe đã duyệt của cư dân đang cư trú." TextWrapping="Wrap" Foreground="#64748B" FontSize="11" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel></ScrollViewer>
                        </Grid>
                        <StackPanel Grid.Row="2" Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <UniformGrid Columns="2" Margin="0,0,0,8">
                                <Button Content="✓  Phê duyệt" Style="{StaticResource GridActionBtn}" Background="#DCFCE7" Foreground="#15803D" Margin="0,0,4,0" IsEnabled="{Binding CanReviewSelected}" Command="{Binding ApproveVehicleCommand}" CommandParameter="{Binding SelectedVehicleItem}"/>
                                <Button Content="×  Từ chối" Style="{StaticResource GridActionBtn}" Background="#FEE2E2" Foreground="#B91C1C" Margin="4,0,0,0" IsEnabled="{Binding CanReviewSelected}" Command="{Binding RejectVehicleCommand}" CommandParameter="{Binding SelectedVehicleItem}"/>
                            </UniformGrid>
                            <UniformGrid Columns="2">
                                <Button Content="Sửa" Style="{StaticResource SecondaryBtn}" Margin="0,0,4,0" Command="{Binding OpenEditFormCommand}" CommandParameter="{Binding SelectedVehicleItem}"/>
                                <Button Content="Xóa" Style="{StaticResource SecondaryBtn}" Margin="4,0,0,0" Command="{Binding DeleteVehicleCommand}" CommandParameter="{Binding SelectedVehicleItem}"/>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <!-- ===== CỘT PHẢI: FORM MODAL OVERLAY ===== -->
        <!-- Đứng đè lên toàn màn hình (Grid ColumnSpan=2) che phủ cả sidebar và content -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="200"
              Visibility="{Binding IsFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}">

            <!-- Lớp phủ mờ xám nhẹ nhạt phía sau -->
            <Border Background="#66000000" InputScope="Default">
                <Border.InputBindings>
                    <!-- Click overlay để cancel đóng modal -->
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CancelFormCommand}"/>
                </Border.InputBindings>
            </Border>

            <!-- Card Dialog nổi ở trung tâm -->
            <Border MaxWidth="440" Margin="16,24"
                    Background="White" CornerRadius="10" Padding="24"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Direction="0" ShadowDepth="0" Color="#000000" Opacity="0.15"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <Border Width="40" Height="4" CornerRadius="2"
                                Background="{StaticResource PrimaryBrush}"
                                HorizontalAlignment="Left" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding FormTitle}" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource TextDarkBrush}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="450">
                        <StackPanel>
                            <!-- Biển số xe -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Biển số xe (Ví dụ: 29A1-12345)" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                                <TextBox Style="{StaticResource FormTextBox}"
                                         Text="{Binding EditingVehicle.LicensePlate, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Loại xe -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Loại phương tiện" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                                <ComboBox Style="{StaticResource FormComboBox}"
                                          ItemsSource="{Binding VehicleTypes}"
                                          SelectedItem="{Binding EditingVehicle.VehicleType}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding}" Value="{x:Static enums:VehicleType.Moto}">
                                                                <Setter Property="Text" Value="Xe Máy"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding}" Value="{x:Static enums:VehicleType.Car}">
                                                                <Setter Property="Text" Value="Ô Tô"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding}" Value="{x:Static enums:VehicleType.Bicycle}">
                                                                <Setter Property="Text" Value="Xe Đạp"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Hiệu xe -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Hiệu xe (Ví dụ: Honda, Yamaha, Toyota)" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                                <TextBox Style="{StaticResource FormTextBox}"
                                         Text="{Binding EditingVehicle.Brand, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Màu xe (không bắt buộc)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                                <TextBox Style="{StaticResource FormTextBox}" MaxLength="50" Text="{Binding EditingVehicle.Color, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Chủ sở hữu xe -->
                            <StackPanel Margin="0,0,0,4">
                                <TextBlock Text="Chủ sở hữu (Cư dân có cư trú)" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                                <ComboBox Style="{StaticResource FormComboBox}"
                                          ItemsSource="{Binding ActiveResidents}"
                                          SelectedValue="{Binding EditingVehicle.OwnerId}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="FullName"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Nút bấm ở chân -->
                    <controls:NotificationBanner Grid.Row="2" Message="{Binding ErrorMessage}" Kind="Error" Margin="0,12,0,0"/>

                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Hủy" Style="{StaticResource SecondaryBtn}" Margin="0,0,6,0"
                                Command="{Binding CancelFormCommand}"/>
                        <Button Grid.Column="1" Content="Lưu" Style="{StaticResource AdminPrimaryBtn}" Margin="6,0,0,0"
                                Command="{Binding SaveVehicleCommand}"/>
                    </Grid>
                </Grid>
