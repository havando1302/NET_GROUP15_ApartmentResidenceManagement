<UserControl x:Class="ApartmentResidenceManagement.Wpf.Views.ResidencyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ApartmentResidenceManagement.Wpf.Controls"
             xmlns:enums="clr-namespace:ApartmentResidenceManagement.Domain.Enums;assembly=ApartmentResidenceManagement.Domain"
             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="1200"
             Background="#F8FAFC">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Tab Button Style -->
        <Style x:Key="ResidenceTabButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0,0,0,3"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Eye Action Button Style -->
        <Style x:Key="EyeActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="EyeBorder" CornerRadius="16" Background="{TemplateBinding Background}">
                            <Path Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zm0 12.5c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                                  Fill="#2563EB"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="EyeBorder" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pagination Page Button Style -->
        <Style x:Key="PageNavBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded Buttons for Forms & Grids -->
        <Style x:Key="RoundedPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedSecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedSuccessBtn" TargetType="Button">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedDangerBtn" TargetType="Button">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Style -->
        <Style x:Key="ModernDataGridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#F1F5F9"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernDataGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- MAIN CONTENT SCROLLVIEWER -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,20,24,24">

                <!-- ══════════════════════════════════════════════════════════
                     1. HEADER CARD (Tiêu đề trang)
                ══════════════════════════════════════════════════════════ -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon Clipboard -->
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#2563EB" VerticalAlignment="Center">
                        <Path Data="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
                              Fill="White" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Title & Subtitle -->
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Quản lý Cư trú" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Quản lý đăng ký, chuyển căn hộ, kết thúc cư trú và tra cứu lịch sử cư trú."
                                   FontSize="13" Foreground="#64748B" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- ══════════════════════════════════════════════════════════
                     2. STATS KPI CARDS (3 Thẻ thống kê: Đang cư trú / Chuyển hộ / Kết thúc)
                ══════════════════════════════════════════════════════════ -->
                <UniformGrid Columns="3" Margin="0,0,0,18">
                    <!-- KPI 1: Cư dân đang cư trú (Green) -->
                    <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18,16" Margin="0,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Opacity="0.04" ShadowDepth="2" Color="#000000"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="10" Background="#DCFCE7" VerticalAlignment="Center">
                                <Path Data="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
                                      Stroke="#16A34A" StrokeThickness="2" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActiveResidentsCount}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Cư dân đang cư trú" FontSize="12.5" FontWeight="Medium" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- KPI 2: Lượt chuyển căn hộ (Blue) -->
                    <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18,16" Margin="5,0,5,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Opacity="0.04" ShadowDepth="2" Color="#000000"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="10" Background="#DBEAFE" VerticalAlignment="Center">
                                <Path Data="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"
                                      Stroke="#2563EB" StrokeThickness="2" StrokeLineJoin="Round" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TransferCount}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Lượt chuyển căn hộ" FontSize="12.5" FontWeight="Medium" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- KPI 3: Lượt kết thúc cư trú (Red) -->
                    <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18,16" Margin="10,0,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Opacity="0.04" ShadowDepth="2" Color="#000000"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="10" Background="#FEE2E2" VerticalAlignment="Center">
                                <Path Data="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6 M10 10l4 4m0-4l-4 4"
                                      Stroke="#DC2626" StrokeThickness="2" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding EndedCount}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Lượt kết thúc cư trú" FontSize="12.5" FontWeight="Medium" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- ══════════════════════════════════════════════════════════
                     3. ACTION BUTTONS (Đăng ký / Chuyển căn / Kết thúc)
                ══════════════════════════════════════════════════════════ -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <!-- Button: + Đăng ký cư trú -->
                    <Button Command="{Binding OpenRegisterFormCommand}"
                            Background="#2563EB" Foreground="White" BorderThickness="0"
                            Padding="20,10" FontSize="13" FontWeight="SemiBold" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="+" FontSize="16" FontWeight="Bold" Margin="0,-2,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Đăng ký cư trú" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1D4ED8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Button: ⇄ Chuyển căn hộ -->
                    <Button Command="{Binding OpenTransferFormCommand}"
                            Background="White" Foreground="#2563EB" BorderBrush="#CBD5E1" BorderThickness="1"
                            Padding="18,10" Margin="12,0,0,0" FontSize="13" FontWeight="SemiBold" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⇄ " FontSize="15" Margin="0,-1,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Chuyển căn hộ" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                        <Setter Property="BorderBrush" Value="#94A3B8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Button: ⌂x Kết thúc cư trú -->
                    <Button Command="{Binding OpenTerminateFormCommand}"
                            Background="White" Foreground="#1E293B" BorderBrush="#CBD5E1" BorderThickness="1"
                            Padding="18,10" Margin="12,0,0,0" FontSize="13" FontWeight="SemiBold" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⌂x " FontSize="14" Margin="0,-1,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Kết thúc cư trú" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                        <Setter Property="BorderBrush" Value="#94A3B8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- ERROR / SUCCESS NOTIFICATIONS -->
                <StackPanel Margin="0,0,0,12">
                    <controls:NotificationBanner Message="{Binding RequestSuccessMessage}" Kind="Success" Margin="0,0,0,8"
                                                 Visibility="{Binding RequestSuccessMessage, Converter={StaticResource BoolToVis}}"/>
                    <controls:NotificationBanner Message="{Binding ErrorMessage}" Kind="Error"
                                                 Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <!-- ══════════════════════════════════════════════════════════
                     4. MAIN CONTENT (Split: Left = Table & Filters | Right = Detail Panel)
                ══════════════════════════════════════════════════════════ -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <!-- ────────────────────────────────────────────────────────
                         LEFT COLUMN: TABS, FILTERS, DATAGRID & PAGINATION
                    ──────────────────────────────────────────────────────── -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">

                        <!-- TABS BAR -->
                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <!-- Tab 1: Đang cư trú -->
                                <RadioButton Content="{Binding ActiveResidentsCount, StringFormat='👥 Đang cư trú ({0})'}"
                                             IsChecked="{Binding IsActiveTab, Mode=TwoWay}"
                                             Style="{StaticResource ResidenceTabButtonStyle}"
                                             Command="{Binding SwitchTabCommand}" CommandParameter="0"/>

                                <!-- Tab 2: Lịch sử cư trú -->
                                <RadioButton Content="{Binding EndedCount, StringFormat='🕒 Lịch sử cư trú ({0})'}"
                                             IsChecked="{Binding IsHistoryTab, Mode=TwoWay}"
                                             Style="{StaticResource ResidenceTabButtonStyle}"
                                             Command="{Binding SwitchTabCommand}" CommandParameter="1"
                                             Margin="16,0,0,0"/>

                                <!-- Tab 3: Yêu cầu thành viên -->
                                <RadioButton IsChecked="{Binding IsRequestsTab, Mode=TwoWay}"
                                             Style="{StaticResource ResidenceTabButtonStyle}"
                                             Command="{Binding SwitchTabCommand}" CommandParameter="2"
                                             Margin="16,0,0,0">
                                    <RadioButton.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔔 Yêu cầu thêm thành viên"/>
                                            <Border Margin="6,0,0,0" Background="#EF4444" CornerRadius="10" Padding="6,1" VerticalAlignment="Center"
                                                    Visibility="{Binding HasPendingRequests, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding PendingRequestsCount}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                    </RadioButton.Content>
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <!-- VIEW: RESIDENCES LIST (TAB 0 & TAB 1) -->
                        <StackPanel Visibility="{Binding IsResidencesTab, Converter={StaticResource BoolToVis}}">

                            <!-- FILTER TOOLBAR -->
                            <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,10" Margin="0,0,0,12">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" Opacity="0.03" ShadowDepth="1" Color="#000000"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Search Box -->
                                    <Grid Grid.Column="0" Margin="0,0,10,0">
                                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="36" FontSize="13" Padding="32,0,10,0" VerticalContentAlignment="Center"/>
                                        <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                              Fill="#94A3B8" Width="15" Height="15" Stretch="Uniform"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                                        <TextBlock Text="Tìm theo mã cư dân, họ tên, căn hộ..."
                                                   FontSize="12.5" Foreground="#94A3B8"
                                                   VerticalAlignment="Center" Margin="32,0,0,0" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Filter Apartment Dropdown -->
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding ApartmentFilterOptions}"
                                              SelectedItem="{Binding SelectedApartmentFilter}"
                                              Height="36" Width="135" Margin="0,0,10,0"/>

                                    <!-- Sort Dropdown -->
                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding SortOrderOptions}"
                                              SelectedItem="{Binding SelectedSortOrder}"
                                              Height="36" Width="195" Margin="0,0,10,0"/>

                                    <!-- Refresh Button -->
                                    <Button Grid.Column="3" Command="{Binding RefreshCommand}"
                                            Height="36" Padding="12,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                            Cursor="Hand" ToolTip="Làm mới dữ liệu">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="rfBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                                              Fill="#475569" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Làm mới" FontSize="12.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="rfBorder" Property="Background" Value="#F8FAFC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- DATAGRID TABLE -->
                            <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" Opacity="0.03" ShadowDepth="1" Color="#000000"/>
                                </Border.Effect>
                                <DataGrid ItemsSource="{Binding PagedResidences}"
                                          SelectedItem="{Binding SelectedResidenceItem, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserResizeRows="False"
                                          IsReadOnly="True"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#F1F5F9"
                                          HeadersVisibility="Column"
                                          BorderThickness="0"
                                          Background="White"
                                          RowStyle="{StaticResource ModernDataGridRow}"
                                          ColumnHeaderStyle="{StaticResource ModernDataGridHeader}">

                                    <DataGrid.Columns>
                                        <!-- Column #: STT -->
                                        <DataGridTextColumn Header="#" Binding="{Binding Stt}" Width="45">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                    <Setter Property="FontWeight" Value="Medium"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Column 2: Mã cư dân -->
                                        <DataGridTextColumn Header="Mã cư dân" Binding="{Binding ResidentCode}" Width="100">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#2563EB"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Margin" Value="10,0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Column 3: Họ và tên -->
                                        <DataGridTextColumn Header="Họ và tên" Binding="{Binding ResidentName}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#0F172A"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Margin" Value="10,0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Column 4: Căn hộ (Pill Badge) -->
                                        <DataGridTemplateColumn Header="Căn hộ" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="#EFF6FF" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ApartmentNumber}" FontWeight="Bold" FontSize="12.5" Foreground="#2563EB"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Column 5: Ngày bắt đầu -->
                                        <DataGridTextColumn Header="Ngày bắt đầu" Binding="{Binding FormattedStartDate}" Width="120">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#334155"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Margin" Value="10,0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Column 6: Thời gian cư trú -->
                                        <DataGridTextColumn Header="Thời gian cư trú" Binding="{Binding ResidenceDuration}" Width="130">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#475569"/>
                                                    <Setter Property="FontWeight" Value="Medium"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Margin" Value="10,0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Column 7: Thao tác (Eye Detail Icon) -->
                                        <DataGridTemplateColumn Header="Thao tác" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource EyeActionButtonStyle}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            ToolTip="Xem chi tiết cư trú"
                                                            Command="{Binding DataContext.SelectResidenceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <!-- PAGINATION FOOTER -->
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Summary text -->
                                <TextBlock Grid.Column="0" Text="{Binding PaginationSummary}"
                                           FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>

                                <!-- Page Nav Buttons -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="‹" Command="{Binding PreviousPageCommand}"
                                            Style="{StaticResource PageNavBtnStyle}" IsEnabled="{Binding CanPreviousPage}"/>

                                    <ItemsControl ItemsSource="{Binding PageNumbers}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding}"
                                                        Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource PageNavBtnStyle}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Content="›" Command="{Binding NextPageCommand}"
                                            Style="{StaticResource PageNavBtnStyle}" IsEnabled="{Binding CanNextPage}"/>
                                </StackPanel>

                                <!-- Page Size Selector -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Số dòng/trang:" FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox ItemsSource="{Binding PageSizeOptions}"
                                              SelectedItem="{Binding PageSize}"
                                              Height="32" Width="65" VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- VIEW: MEMBER REQUESTS LIST (TAB 2) -->
                        <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1"
                                Visibility="{Binding IsRequestsTab, Converter={StaticResource BoolToVis}}">
                            <DataGrid ItemsSource="{Binding Requests}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F1F5F9"
                                      HeadersVisibility="Column"
                                      BorderThickness="0"
                                      Background="White"
                                      RowStyle="{StaticResource ModernDataGridRow}"
                                      ColumnHeaderStyle="{StaticResource ModernDataGridHeader}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Căn hộ" Binding="{Binding ApartmentNumber}" Width="90"/>
                                    <DataGridTextColumn Header="Người gửi" Binding="{Binding RequesterName}" Width="140"/>
                                    <DataGridTextColumn Header="Người cần thêm" Binding="{Binding FullName}" Width="150"/>
                                    <DataGridTextColumn Header="CCCD/CMND" Binding="{Binding IdentityCard}" Width="120"/>
                                    <DataGridTextColumn Header="Quan hệ" Binding="{Binding RelationshipText}" Width="110"/>
                                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="100"/>
                                    <DataGridTemplateColumn Header="Thao tác" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Content="Duyệt" Style="{StaticResource RoundedSuccessBtn}"
                                                            Margin="0,0,6,0"
                                                            Command="{Binding DataContext.ApproveRequestCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding CanApprove, Converter={StaticResource BoolToVis}}"/>
                                                    <Button Content="Từ chối" Style="{StaticResource RoundedDangerBtn}"
                                                            Command="{Binding DataContext.OpenRejectDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding CanApprove, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                    </StackPanel>

                    <!-- ────────────────────────────────────────────────────────
                         RIGHT COLUMN: "CHI TIẾT CƯ TRÚ" (DETAIL PANEL & TIMELINE)
                    ──────────────────────────────────────────────────────── -->
                    <Border Grid.Column="1" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Opacity="0.04" ShadowDepth="2" Color="#000000"/>
                        </Border.Effect>

                        <StackPanel>
                            <!-- Panel Header -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Width="22" Height="22" CornerRadius="11" Background="#DBEAFE" Margin="0,0,8,0">
                                    <TextBlock Text="ℹ" FontWeight="Bold" FontSize="13" Foreground="#2563EB"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Chi tiết cư trú" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- CONTENT KHI CÓ CƯ DÂN ĐƯỢC CHỌN -->
                            <StackPanel Visibility="{Binding HasSelectedResidence, Converter={StaticResource BoolToVis}}">

                                <!-- Avatar & Profile -->
                                <StackPanel HorizontalAlignment="Center" Margin="0,4,0,16">
                                    <!-- Avatar Round Circle -->
                                    <Border Width="72" Height="72" CornerRadius="36" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="2" HorizontalAlignment="Center">
                                        <Path Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                              Fill="#3B82F6" Width="36" Height="36" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Full Name -->
                                    <TextBlock Text="{Binding SelectedResidenceItem.ResidentName}"
                                               FontSize="18" FontWeight="Bold" Foreground="#0F172A"
                                               HorizontalAlignment="Center" Margin="0,10,0,2"/>

                                    <!-- Resident Code -->
                                    <TextBlock Text="{Binding SelectedResidenceItem.ResidentCode, StringFormat='Mã cư dân: {0}'}"
                                               FontSize="12.5" Foreground="#64748B" HorizontalAlignment="Center"/>

                                    <!-- Status Badge (Đang cư trú vs Đã kết thúc) -->
                                    <Border Margin="0,8,0,0" CornerRadius="12" Padding="10,4" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#DEF7EC"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedResidenceItem.IsActive}" Value="False">
                                                        <Setter Property="Background" Value="#F1F5F9"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="● " FontSize="9" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#059669"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedResidenceItem.IsActive}" Value="False">
                                                                <Setter Property="Foreground" Value="#64748B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock FontWeight="SemiBold" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Đang cư trú"/>
                                                        <Setter Property="Foreground" Value="#03543F"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedResidenceItem.IsActive}" Value="False">
                                                                <Setter Property="Text" Value="Đã kết thúc"/>
                                                                <Setter Property="Foreground" Value="#475569"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Divider -->
                                <Rectangle Height="1" Fill="#F1F5F9" Margin="0,0,0,14"/>

                                <!-- SECTION: THÔNG TIN CƯ TRÚ HIỆN TẠI -->
                                <TextBlock Text="Thông tin cư trú hiện tại" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="⌂ " FontSize="14" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <TextBlock Text="Căn hộ:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedResidenceItem.ApartmentNumber}"
                                               FontSize="13.5" FontWeight="Bold" Foreground="#0F172A"/>
                                </Grid>

                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="📅 " FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <TextBlock Text="Ngày bắt đầu:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedResidenceItem.FormattedStartDate}"
                                               FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                                </Grid>

                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="⌛ " FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <TextBlock Text="Thời gian cư trú:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedResidenceItem.ResidenceDuration}"
                                               FontSize="13.5" FontWeight="Bold" Foreground="#0F172A"/>
                                </Grid>

                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="👥 " FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <TextBlock Text="Vai trò/Quan hệ:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedResidenceItem.RelationshipText}"
                                               FontSize="13" FontWeight="SemiBold" Foreground="#2563EB"/>
                                </Grid>

                                <!-- Divider -->
                                <Rectangle Height="1" Fill="#F1F5F9" Margin="0,14,0,14"/>

                                <!-- SECTION: QUÁ TRÌNH CƯ TRÚ (TIMELINE) -->
                                <TextBlock Text="Quá trình cư trú" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                                <ItemsControl ItemsSource="{Binding SelectedResidentTimeline}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Stepper Node (Ring & Line) -->
                                                <Grid Grid.Column="0" HorizontalAlignment="Center">
                                                    <!-- Vertical Line -->
                                                    <Rectangle Width="2" Fill="#E2E8F0" Margin="0,12,0,0"
                                                               Visibility="{Binding ShowLine, Converter={StaticResource BoolToVis}}"/>
                                                    <!-- Circle Dot -->
                                                    <Ellipse Width="12" Height="12" StrokeThickness="2" VerticalAlignment="Top" Margin="0,3,0,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Stroke" Value="#16A34A"/>
                                                                <Setter Property="Fill" Value="White"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                        <Setter Property="Stroke" Value="#94A3B8"/>
                                                                        <Setter Property="Fill" Value="#E2E8F0"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                </Grid>

                                                <!-- Step Info -->
                                                <StackPanel Grid.Column="1" Margin="6,0,0,10">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding ApartmentNumber}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                                        <TextBlock Text=" · " FontWeight="Bold" FontSize="13" Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding StatusText}" FontSize="12.5" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#16A34A"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                            <Setter Property="Foreground" Value="#64748B"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DateRangeText}" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- PLACEHOLDER KHI CHƯA CHỌN CƯ DÂN -->
                            <StackPanel Visibility="{Binding HasNoSelectedResidence, Converter={StaticResource BoolToVis}}"
                                        HorizontalAlignment="Center" Margin="0,40,0,0">
                                <Border Width="60" Height="60" CornerRadius="30" Background="#F1F5F9" HorizontalAlignment="Center">
                                    <Path Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                          Fill="#94A3B8" Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Chưa chọn cư dân" FontSize="14" FontWeight="Bold" Foreground="#475569"
                                           HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                <TextBlock Text="Vui lòng chọn một dòng trong bảng danh sách để tra cứu chi tiết thông tin và tiến trình cư trú."
                                           FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="220"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- ══════════════════════════════════════════════════════════
             5. MODAL FORM DIALOG OVERLAY (Đăng ký / Chuyển hộ / Kết thúc)
        ══════════════════════════════════════════════════════════ -->
        <Grid Background="#66000000" Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1"
                    Width="520" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Opacity="0.15" ShadowDepth="8" Color="#000000"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Form Title -->
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="{Binding FormTitle}" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                        <Button Command="{Binding CancelFormCommand}" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand" Content="✕" FontSize="14" Foreground="#94A3B8"/>
                    </Grid>

                    <!-- Error inside form -->
                    <controls:NotificationBanner Message="{Binding ErrorMessage}" Kind="Error" Margin="0,0,0,12"
                                                 Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>

                    <!-- FORM 1: ĐĂNG KÝ CƯ TRÚ -->
                    <StackPanel Visibility="{Binding IsRegisterAction, Converter={StaticResource BoolToVis}}">
                        <!-- Chọn Căn hộ -->
                        <TextBlock Text="Căn hộ cư trú:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding AvailableApartments}"
                                  SelectedItem="{Binding SelectedApartmentInput}"
                                  DisplayMemberPath="ApartmentNumber"
                                  Height="38" Margin="0,0,0,14"/>

                        <!-- Chọn Cư dân -->
                        <TextBlock Text="Cư dân đăng ký:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding AvailableResidents}"
                                  SelectedItem="{Binding SelectedResidentInput}"
                                  DisplayMemberPath="FullName"
                                  Height="38" Margin="0,0,0,14"/>

                        <!-- Chọn Loại quan hệ -->
                        <TextBlock Text="Quan hệ với căn hộ:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding RelationshipTypes}"
                                  SelectedItem="{Binding SelectedRelationshipType}"
                                  Height="38" Margin="0,0,0,14"/>

                        <!-- Ngày bắt đầu -->
                        <TextBlock Text="Ngày bắt đầu cư trú:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <DatePicker SelectedDate="{Binding StartDateInput}" Height="38" Margin="0,0,0,16"/>
                    </StackPanel>

                    <!-- FORM 2: CHUYỂN CĂN HỘ -->
                    <StackPanel Visibility="{Binding IsTransferAction, Converter={StaticResource BoolToVis}}">
                        <!-- Cư dân chuyển -->
                        <TextBlock Text="Cư dân cần chuyển hộ:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding ActiveResidencesForSelection}"
                                  SelectedItem="{Binding SelectedResidence}"
                                  Height="38" Margin="0,0,0,14">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding Resident.FullName, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text=" (Đang ở: " Foreground="#64748B"/>
                                        <Run Text="{Binding Apartment.ApartmentNumber, Mode=OneWay}" Foreground="#2563EB" FontWeight="Bold"/>
                                        <Run Text=")" Foreground="#64748B"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Chọn Căn hộ mới -->
                        <TextBlock Text="Chuyển đến Căn hộ mới:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding AvailableApartments}"
                                  SelectedItem="{Binding SelectedApartmentInput}"
                                  DisplayMemberPath="ApartmentNumber"
                                  Height="38" Margin="0,0,0,14"/>

                        <!-- Quan hệ tại căn mới -->
                        <TextBlock Text="Quan hệ tại căn hộ mới:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding RelationshipTypes}"
                                  SelectedItem="{Binding SelectedRelationshipType}"
                                  Height="38" Margin="0,0,0,14"/>

                        <!-- Ngày chuyển -->
                        <TextBlock Text="Ngày chuyển căn hộ:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <DatePicker SelectedDate="{Binding StartDateInput}" Height="38" Margin="0,0,0,16"/>
                    </StackPanel>

                    <!-- FORM 3: KẾT THÚC CƯ TRÚ -->
                    <StackPanel Visibility="{Binding IsTerminateAction, Converter={StaticResource BoolToVis}}">
                        <!-- Chọn hồ sơ kết thúc -->
                        <TextBlock Text="Hồ sơ cư trú cần kết thúc:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding ActiveResidencesForSelection}"
                                  SelectedItem="{Binding SelectedResidence}"
                                  Height="38" Margin="0,0,0,14">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding Resident.FullName, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text=" - Căn hộ: " Foreground="#64748B"/>
                                        <Run Text="{Binding Apartment.ApartmentNumber, Mode=OneWay}" Foreground="#2563EB" FontWeight="Bold"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Ngày kết thúc -->
                        <TextBlock Text="Ngày kết thúc cư trú:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <DatePicker SelectedDate="{Binding EndDateInput}" Height="38" Margin="0,0,0,16"/>
                    </StackPanel>

                    <!-- Modal Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Hủy bỏ" Command="{Binding CancelFormCommand}"
                                Style="{StaticResource RoundedSecondaryBtn}" Margin="0,0,10,0"/>
                        <Button Content="Xác nhận lưu" Command="{Binding SaveResidencyCommand}"
                                Style="{StaticResource RoundedPrimaryBtn}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
