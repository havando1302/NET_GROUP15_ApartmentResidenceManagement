<UserControl x:Class="ApartmentResidenceManagement.Wpf.Views.ResidencyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ApartmentResidenceManagement.Wpf.Controls"
             xmlns:enums="clr-namespace:ApartmentResidenceManagement.Domain.Enums;assembly=ApartmentResidenceManagement.Domain"
             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="1200"
             Background="#F8FAFC">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Tab Button Style -->
        <Style x:Key="ResidenceTabButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0,0,0,3"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Eye Action Button Style -->
        <Style x:Key="EyeActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="EyeBorder" CornerRadius="16" Background="{TemplateBinding Background}">
                            <Path Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zm0 12.5c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                                  Fill="#2563EB"
                                  Width="15" Height="15"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="EyeBorder" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pagination Page Button Style -->
        <Style x:Key="PageNavBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded Primary Action Button -->
        <Style x:Key="RoundedPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedSecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedSuccessBtn" TargetType="Button">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedDangerBtn" TargetType="Button">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Override System Highlight to prevent harsh dark blue & black selection borders -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E0F2FE"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E0F2FE"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A"/>

        <!-- DataGrid Cell Style (Loại bỏ hoàn toàn viền đen xung quanh mỗi ô) -->
        <Style x:Key="ModernDataGridCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Implicit DataGridCell Style (Áp dụng toàn view) -->
        <Style TargetType="DataGridCell" BasedOn="{StaticResource ModernDataGridCell}"/>

        <!-- DataGrid Row Style (Tự động co giãn theo chiều dọc, nền xanh dịu mắt, chữ đậm nét) -->
        <Style x:Key="ModernDataGridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#F1F5F9"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <!-- Màu xanh ngọc nhạt #E0F2FE: chữ #0F172A tương phản rất rõ, thông tin sáng sủa không bị chìm -->
                    <Setter Property="Background" Value="#E0F2FE"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernDataGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ══════════════════════════════════════════════════════════
             MAIN PAGE LAYOUT (Tự động co giãn 100% không gian màn hình)
        ══════════════════════════════════════════════════════════ -->
        <Grid Margin="24,14,24,16" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <!-- Row 0: Header Card -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: KPI Stats Cards -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: Action Buttons Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Row 3: Notification Banners -->
                <RowDefinition Height="0"/>
                <!-- Row 4: Main Content (Table + Detail) -> Stretches to fill ALL remaining space! -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════════
                 1. HEADER CARD (Tiêu đề trang)
            ══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Icon Users Group -->
                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="#2563EB" VerticalAlignment="Center">
                    <Path Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
                          Fill="White" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Title & Subtitle -->
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Quản lý Cư trú" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Quản lý đăng ký, chuyển căn hộ, kết thúc cư trú và tra cứu lịch sử cư trú."
                               FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 2. STATS KPI CARDS (3 Thẻ thống kê: Đang cư trú / Chuyển hộ / Kết thúc)
            ══════════════════════════════════════════════════════════ -->
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12">
                <!-- KPI 1: Cư dân đang cư trú (Green + Family Illustration) -->
                <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16,12" Margin="0,0,8,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" Opacity="0.04" ShadowDepth="1" Color="#000000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#DCFCE7" VerticalAlignment="Center">
                            <Path Data="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
                                  Stroke="#16A34A" StrokeThickness="2" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveResidentsCount}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Cư dân đang cư trú" FontSize="12.5" FontWeight="Medium" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                        <!-- Family Illustration -->
                        <Grid Grid.Column="2" Width="68" Height="50" VerticalAlignment="Center" Margin="0,0,4,0">
                            <Image Source="/Assets/avatar_young_man.png" Width="36" Height="36" Margin="0,0,26,10" Stretch="Uniform">
                                <RenderOptions.BitmapScalingMode>HighQuality</RenderOptions.BitmapScalingMode>
                            </Image>
                            <Image Source="/Assets/avatar_young_woman.png" Width="34" Height="34" Margin="28,2,0,10" Stretch="Uniform">
                                <RenderOptions.BitmapScalingMode>HighQuality</RenderOptions.BitmapScalingMode>
                            </Image>
                            <Image Source="/Assets/avatar_son.png" Width="28" Height="28" Margin="16,16,16,0" Stretch="Uniform">
                                <RenderOptions.BitmapScalingMode>HighQuality</RenderOptions.BitmapScalingMode>
                            </Image>
                        </Grid>
                    </Grid>
                </Border>

                <!-- KPI 2: Lượt chuyển căn hộ (Blue + Moving Boxes Illustration) -->
                <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16,12" Margin="4,0,4,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" Opacity="0.04" ShadowDepth="1" Color="#000000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#DBEAFE" VerticalAlignment="Center">
                            <Path Data="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"
                                  Stroke="#2563EB" StrokeThickness="2" StrokeLineJoin="Round" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TransferCount}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Lượt chuyển căn hộ" FontSize="12.5" FontWeight="Medium" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                        <!-- Moving Boxes Graphic -->
                        <Grid Grid.Column="2" Width="68" Height="50" VerticalAlignment="Center" Margin="0,0,4,0">
                            <Path Data="M0 40 Q30 15 70 30 L70 50 L0 50 Z" Fill="#EFF6FF"/>
                            <Border Width="24" Height="20" Background="#F59E0B" CornerRadius="3" BorderBrush="#D97706" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4,0,0,4">
                                <Rectangle Width="5" Height="18" Fill="#FDE68A" HorizontalAlignment="Center"/>
                            </Border>
                            <Border Width="22" Height="24" Background="#D97706" CornerRadius="3" BorderBrush="#B45309" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,4">
                                <Rectangle Width="5" Height="22" Fill="#FDE68A" HorizontalAlignment="Center"/>
                            </Border>
                            <Border Width="16" Height="14" Background="#FBBF24" CornerRadius="2" BorderBrush="#D97706" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,6,0,0">
                                <Rectangle Width="4" Height="12" Fill="#93C5FD" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- KPI 3: Lượt kết thúc cư trú (Red + Calendar Graphic) -->
                <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16,12" Margin="8,0,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" Opacity="0.04" ShadowDepth="1" Color="#000000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#FEE2E2" VerticalAlignment="Center">
                            <Path Data="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6 M6 18l6-6m0 6l-6-6"
                                  Stroke="#DC2626" StrokeThickness="2" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding EndedCount}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Lượt kết thúc cư trú" FontSize="12.5" FontWeight="Medium" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                        <!-- Calendar Graphic -->
                        <Grid Grid.Column="2" Width="68" Height="50" VerticalAlignment="Center" Margin="0,0,4,0">
                            <Path Data="M0 35 Q30 5 70 25 L70 50 L0 50 Z" Fill="#FFF1F2"/>
                            <Border Width="36" Height="36" Background="White" CornerRadius="6" BorderBrush="#FECACA" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="11"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#F87171" CornerRadius="4,4,0,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse Width="3" Height="3" Fill="White" Margin="2,0"/>
                                            <Ellipse Width="3" Height="3" Fill="White" Margin="2,0"/>
                                        </StackPanel>
                                    </Border>
                                    <UniformGrid Grid.Row="1" Rows="3" Columns="4" Margin="2">
                                        <Ellipse Width="2.5" Height="2.5" Fill="#FCA5A5"/>
                                        <Ellipse Width="2.5" Height="2.5" Fill="#FCA5A5"/>
                                        <Ellipse Width="2.5" Height="2.5" Fill="#F87171"/>
                                        <Ellipse Width="2.5" Height="2.5" Fill="#FCA5A5"/>
                                        <Ellipse Width="2.5" Height="2.5" Fill="#F87171"/>
                                        <Ellipse Width="2.5" Height="2.5" Fill="#EF4444"/>
                                        <Ellipse Width="2.5" Height="2.5" Fill="#FCA5A5"/>
                                        <Ellipse Width="2.5" Height="2.5" Fill="#FCA5A5"/>
                                        <Ellipse Width="2.5" Height="2.5" Fill="#F87171"/>
                                        <Ellipse Width="2.5" Height="2.5" Fill="#FCA5A5"/>
                                        <Ellipse Width="2.5" Height="2.5" Fill="#FCA5A5"/>
                                        <Ellipse Width="2.5" Height="2.5" Fill="#FCA5A5"/>
                                    </UniformGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- ══════════════════════════════════════════════════════════
                 3. ACTION BUTTONS BAR (Đăng ký / Chuyển căn / Kết thúc / Yêu cầu thành viên)
            ══════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                <!-- Button: + Đăng ký cư trú -->
                <Button Command="{Binding OpenRegisterFormCommand}"
                        Background="#2563EB" Foreground="White" BorderThickness="0"
                        Height="38" Padding="16,0" FontSize="13" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="+" FontSize="16" FontWeight="Bold" Margin="0,-2,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Đăng ký cư trú" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1D4ED8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Button: ⇄ Chuyển căn hộ -->
                <Button Command="{Binding OpenTransferFormCommand}"
                        Background="White" Foreground="#2563EB" BorderBrush="#CBD5E1" BorderThickness="1"
                        Height="38" Padding="14,0" Margin="10,0,0,0" FontSize="13" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⇄ " FontSize="14" Margin="0,-1,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Chuyển căn hộ" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="BorderBrush" Value="#94A3B8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Button: ⃠ Kết thúc cư trú (Red Prohibited Circle Icon) -->
                <Button Command="{Binding OpenTerminateFormCommand}"
                        Background="White" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1"
                        Height="38" Padding="14,0" Margin="10,0,0,0" FontSize="13" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.42 0-8-3.58-8-8 0-1.85.63-3.55 1.69-4.9L16.9 18.31C15.55 19.37 13.85 20 12 20zm6.31-3.1L7.1 5.69C8.45 4.63 10.15 4 12 4c4.42 0 8 3.58 8 8 0 1.85-.63 3.55-1.69 4.9z"
                                          Fill="#DC2626" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Kết thúc cư trú" Foreground="#DC2626" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FEF2F2"/>
                                    <Setter Property="BorderBrush" Value="#F87171"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Button: 👥 Yêu cầu thêm thành viên -->
                <Button Command="{Binding SwitchTabCommand}" CommandParameter="2"
                        Background="White" Foreground="#0F172A" BorderBrush="#E2E8F0" BorderThickness="1"
                        Height="38" Padding="14,0" Margin="10,0,0,0" FontSize="13" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
                                          Fill="#2563EB" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Yêu cầu thêm thành viên" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="BorderBrush" Value="#94A3B8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>


            <!-- ══════════════════════════════════════════════════════════
                 4. MAIN CONTENT (Split: Left = Table & Filters | Right = Detail Panel)
                 -> STRETCHES TO FILL ALL AVAILABLE VERTICAL SPACE!
            ══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="4" VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ────────────────────────────────────────────────────────
                     LEFT COLUMN: TABS, FILTERS, DATAGRID & PAGINATION
                ──────────────────────────────────────────────────────── -->
                <Grid Grid.Column="0" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Tabs Bar -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 1: Content Area (Residences or Requests) -> Stretches! -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- TABS BAR (Chỉ 2 Tab chính: Đang cư trú & Lịch sử cư trú) -->
                    <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <!-- Tab 1: Đang cư trú -->
                            <RadioButton IsChecked="{Binding IsActiveTab, Mode=TwoWay}"
                                         Style="{StaticResource ResidenceTabButtonStyle}"
                                         Command="{Binding SwitchTabCommand}" CommandParameter="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="👥 Đang cư trú (" FontSize="13.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ActiveResidentsCount}" FontSize="13.5" FontWeight="Bold"/>
                                    <TextBlock Text=")" FontSize="13.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- Tab 2: Lịch sử cư trú -->
                            <RadioButton IsChecked="{Binding IsHistoryTab, Mode=TwoWay}"
                                         Style="{StaticResource ResidenceTabButtonStyle}"
                                         Command="{Binding SwitchTabCommand}" CommandParameter="1"
                                         Margin="16,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🕒 Lịch sử cư trú (" FontSize="13.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding EndedCount}" FontSize="13.5" FontWeight="Bold"/>
                                    <TextBlock Text=")" FontSize="13.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- Tab 3 (Hiện khi đang ở view Yêu cầu thành viên để dễ nhận biết) -->
                            <RadioButton IsChecked="{Binding IsRequestsTab, Mode=TwoWay}"
                                         Style="{StaticResource ResidenceTabButtonStyle}"
                                         Command="{Binding SwitchTabCommand}" CommandParameter="2"
                                         Margin="16,0,0,0"
                                         Visibility="{Binding IsRequestsTab, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔔 Yêu cầu thêm thành viên (" FontSize="13.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Requests.Count}" FontSize="13.5" FontWeight="Bold"/>
                                    <TextBlock Text=")" FontSize="13.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- VIEW A: RESIDENCES LIST (TAB 0 & TAB 1) -->
                    <Grid Grid.Row="1" VerticalAlignment="Stretch" Visibility="{Binding IsResidencesTab, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <!-- Row 0: Filter Toolbar -->
                            <RowDefinition Height="Auto"/>
                            <!-- Row 1: DataGrid Table -> Stretches to fill vertical height! -->
                            <RowDefinition Height="*"/>
                            <!-- Row 2: Pagination Footer -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- FILTER TOOLBAR -->
                        <Border Grid.Row="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10,8" Margin="0,0,0,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" Opacity="0.03" ShadowDepth="1" Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Search Box -->
                                <Grid Grid.Column="0" Margin="0,0,10,0">
                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Height="36" FontSize="13" Padding="32,0,10,0" VerticalContentAlignment="Center"/>
                                    <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                          Fill="#94A3B8" Width="15" Height="15" Stretch="Uniform"
                                          HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                                    <TextBlock Text="Tìm theo mã cư dân, họ tên, căn hộ..."
                                               FontSize="13" Foreground="#94A3B8"
                                               VerticalAlignment="Center" Margin="32,0,0,0" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- Sort Dropdown with Calendar Icon 📅 -->
                                <Grid Grid.Column="1" Margin="0,0,10,0">
                                    <ComboBox ItemsSource="{Binding SortOrderOptions}"
                                              SelectedItem="{Binding SelectedSortOrder}"
                                              Height="36" Width="205" FontSize="13" Padding="28,0,10,0" VerticalContentAlignment="Center"/>
                                    <Path Data="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zm0-12H5V6h14v2z"
                                          Fill="#475569" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                                </Grid>

                                <!-- Filter Apartment Dropdown styled as [ Y Bộ lọc ] -->
                                <Grid Grid.Column="2" Margin="0,0,10,0">
                                    <ComboBox ItemsSource="{Binding ApartmentFilterOptions}"
                                              SelectedItem="{Binding SelectedApartmentFilter}"
                                              Height="36" Width="105" FontSize="13" Padding="26,0,8,0" VerticalContentAlignment="Center">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat='Căn: {0}'}" FontSize="12.5"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False">
                                        <Path Data="M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z"
                                              Fill="#475569" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="Bộ lọc" FontSize="13" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedApartmentFilter}" Value="Tất cả">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedApartmentFilter}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>

                                <!-- Refresh Button -->
                                <Button Grid.Column="3" Command="{Binding RefreshCommand}"
                                        Height="36" Padding="14,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                        Cursor="Hand" ToolTip="Làm mới dữ liệu">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="rfBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                                          Fill="#475569" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Làm mới" FontSize="13" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="rfBorder" Property="Background" Value="#F8FAFC"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                        <!-- DATAGRID TABLE (Fills vertical height) -->
                        <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1"
                                VerticalAlignment="Stretch">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" Opacity="0.03" ShadowDepth="1" Color="#000000"/>
                            </Border.Effect>
                            <DataGrid x:Name="ResidencesDataGrid"
                                      ItemsSource="{Binding PagedResidences}"
                                      SelectedItem="{Binding SelectedResidenceItem, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      FocusVisualStyle="{x:Null}"
                                      PreviewMouseWheel="OnDataGridPreviewMouseWheel"
                                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F1F5F9"
                                      HeadersVisibility="Column"
                                      BorderThickness="0"
                                      Background="White"
                                      VerticalAlignment="Stretch"
                                      CellStyle="{StaticResource ModernDataGridCell}"
                                      RowStyle="{StaticResource ModernDataGridRow}"
                                      ColumnHeaderStyle="{StaticResource ModernDataGridHeader}">

                                <DataGrid.Columns>
                                    <!-- Column #: STT -->
                                    <DataGridTextColumn Header="#" Binding="{Binding Stt}" Width="48">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                <Setter Property="FontWeight" Value="Medium"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Column 2: Mã cư dân (Pill Badge [ CD012 ]) -->
                                    <DataGridTemplateColumn Header="Mã cư dân" Width="1.1*" MinWidth="95">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#EFF6FF" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0">
                                                    <TextBlock Text="{Binding ResidentCode}" FontWeight="Bold" FontSize="12.5" Foreground="#2563EB"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Column 3: Họ và tên (Circular Avatar + Full Name) -->
                                    <DataGridTemplateColumn Header="Họ và tên" Width="1.8*" MinWidth="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                                    <Border Width="26" Height="26" CornerRadius="13" Margin="0,0,8,0" Background="#EFF6FF">
                                                        <Image Source="{Binding AvatarPath}" Width="26" Height="26" Stretch="UniformToFill">
                                                            <RenderOptions.BitmapScalingMode>HighQuality</RenderOptions.BitmapScalingMode>
                                                        </Image>
                                                    </Border>
                                                    <TextBlock Text="{Binding ResidentName}" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Column 4: Căn hộ (Pill Badge [ 1002 ]) -->
                                    <DataGridTemplateColumn Header="Căn hộ" Width="1.0*" MinWidth="85">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#EFF6FF" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0">
                                                    <TextBlock Text="{Binding ApartmentNumber}" FontWeight="Bold" FontSize="12.5" Foreground="#2563EB"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Column 5: Ngày bắt đầu -->
                                    <DataGridTextColumn Header="Ngày bắt đầu" Binding="{Binding FormattedStartDate}" Width="1.3*" MinWidth="110">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#334155"/>
                                                <Setter Property="FontSize" Value="13"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="10,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Column 6: Thời gian cư trú -->
                                    <DataGridTextColumn Header="Thời gian cư trú" Binding="{Binding ResidenceDuration}" Width="1.4*" MinWidth="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#475569"/>
                                                <Setter Property="FontWeight" Value="Medium"/>
                                                <Setter Property="FontSize" Value="13"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="10,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Column 7: Thao tác (Eye Detail Icon ONLY) -->
                                    <DataGridTemplateColumn Header="Thao tác" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource EyeActionButtonStyle}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        ToolTip="Xem chi tiết cư trú"
                                                        Command="{Binding DataContext.SelectResidenceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- PAGINATION FOOTER -->
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Summary text -->
                            <TextBlock Grid.Column="0" Text="{Binding PaginationSummary}"
                                       FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>

                            <!-- Page Nav Buttons -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="‹" Command="{Binding PreviousPageCommand}"
                                        Style="{StaticResource PageNavBtnStyle}" IsEnabled="{Binding CanPreviousPage}"/>

                                <ItemsControl ItemsSource="{Binding PaginationPages}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="1,0">
                                                <!-- Hiển thị dấu ba chấm nếu là ellipsis -->
                                                <TextBlock Text="{Binding DisplayText}"
                                                           FontSize="13" FontWeight="Bold" Foreground="#94A3B8"
                                                           VerticalAlignment="Center" Margin="5,0"
                                                           Visibility="{Binding IsEllipsis, Converter={StaticResource BoolToVis}}"/>

                                                <!-- Nút bấm chuyển trang -->
                                                <Button Content="{Binding DisplayText}"
                                                        Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Width="32" Height="32" Cursor="Hand">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="White"/>
                                                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Setter Property="Foreground" Value="#475569"/>
                                                            <Setter Property="FontSize" Value="12.5"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="pBd" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="pBd" Property="Background" Value="#F1F5F9"/>
                                                                                <Setter Property="Foreground" Value="#0F172A"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Background" Value="#2563EB"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                    <Setter Property="BorderThickness" Value="0"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="›" Command="{Binding NextPageCommand}"
                                        Style="{StaticResource PageNavBtnStyle}" IsEnabled="{Binding CanNextPage}"/>
                            </StackPanel>

                            <!-- Page Size Selector -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Số dòng/trang:" FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox ItemsSource="{Binding PageSizeOptions}"
                                          SelectedItem="{Binding PageSize}"
                                          Height="32" Width="68" FontSize="12.5" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- VIEW B: MEMBER REQUESTS LIST (TAB 2) -->
                    <Grid Grid.Row="1" VerticalAlignment="Stretch" Visibility="{Binding IsRequestsTab, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <!-- Row 0: Requests DataGrid Table -> Stretches to fill vertical height! -->
                            <RowDefinition Height="*"/>
                            <!-- Row 1: Pagination Footer -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Requests DataGrid Container -->
                        <Border Grid.Row="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1"
                                VerticalAlignment="Stretch">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" Opacity="0.03" ShadowDepth="1" Color="#000000"/>
                            </Border.Effect>
                            <DataGrid x:Name="RequestsDataGrid"
                                      ItemsSource="{Binding Requests}"
                                      SelectedItem="{Binding SelectedRequestItem, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      FocusVisualStyle="{x:Null}"
                                      PreviewMouseWheel="OnDataGridPreviewMouseWheel"
                                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F1F5F9"
                                      HeadersVisibility="Column"
                                      BorderThickness="0"
                                      Background="White"
                                      VerticalAlignment="Stretch"
                                      CellStyle="{StaticResource ModernDataGridCell}"
                                      ColumnHeaderStyle="{StaticResource ModernDataGridHeader}">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRow}">
                                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnRequestRowPreviewMouseLeftButtonUp"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <!-- Căn hộ -->
                                    <DataGridTextColumn Header="Căn hộ" Binding="{Binding ApartmentNumber}" Width="1.0*" MinWidth="85">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#2563EB"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="10,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Người gửi -->
                                    <DataGridTextColumn Header="Người gửi" Binding="{Binding RequesterName}" Width="1.5*" MinWidth="130">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#0F172A"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="10,0"/>
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Người cần thêm -->
                                    <DataGridTextColumn Header="Người cần thêm" Binding="{Binding FullName}" Width="1.6*" MinWidth="140">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#0F172A"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="10,0"/>
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- CCCD/CMND -->
                                    <DataGridTextColumn Header="CCCD/CMND" Binding="{Binding IdentityCardText}" Width="1.3*" MinWidth="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#475569"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="10,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Quan hệ -->
                                    <DataGridTextColumn Header="Quan hệ" Binding="{Binding RelationshipText}" Width="1.4*" MinWidth="130">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#2563EB"/>
                                                <Setter Property="FontWeight" Value="Medium"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="10,0"/>
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Trạng thái (Pill Badge: Chưa duyệt / Đã duyệt / Từ chối) -->
                                    <DataGridTemplateColumn Header="Trạng thái" Width="1.2*" MinWidth="115">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding StatusBadgeBg}"
                                                        BorderBrush="{Binding StatusBadgeBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="10,3"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Margin="10,0">
                                                    <TextBlock Text="{Binding StatusText}"
                                                               Foreground="{Binding StatusBadgeFg}"
                                                               FontWeight="SemiBold"
                                                               FontSize="12"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Thao tác: Khi chưa duyệt hiện rõ [Duyệt] & [Từ chối]; khi đã duyệt/từ chối thì ẩn nút -->
                                    <DataGridTemplateColumn Header="Thao tác" Width="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <!-- Khi Chưa duyệt: Hiện 2 nút sáng rõ cho phép duyệt -->
                                                    <StackPanel Orientation="Horizontal" Visibility="{Binding CanApprove, Converter={StaticResource BoolToVis}}">
                                                        <Button Content="Duyệt" Style="{StaticResource RoundedSuccessBtn}"
                                                                Margin="0,0,8,0"
                                                                Padding="14,6"
                                                                Command="{Binding DataContext.ApproveRequestCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Content="Từ chối" Style="{StaticResource RoundedDangerBtn}"
                                                                Padding="14,6"
                                                                Command="{Binding DataContext.OpenRejectDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>

                                                    <!-- Khi Đã duyệt hoặc Từ chối: Ô thao tác ẩn các nút đi -->
                                                    <TextBlock Text="—"
                                                               Foreground="#94A3B8"
                                                               FontWeight="Medium"
                                                               FontSize="14"
                                                               HorizontalAlignment="Center"
                                                               Visibility="{Binding IsProcessed, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- PAGINATION FOOTER CHO YÊU CẦU THÀNH VIÊN -->
                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Summary text -->
                            <TextBlock Grid.Column="0" Text="{Binding PaginationSummary}"
                                       FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>

                            <!-- Page Nav Buttons -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="‹" Command="{Binding PreviousPageCommand}"
                                        Style="{StaticResource PageNavBtnStyle}" IsEnabled="{Binding CanPreviousPage}"/>

                                <ItemsControl ItemsSource="{Binding PaginationPages}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="1,0">
                                                <!-- Hiển thị dấu ba chấm nếu là ellipsis -->
                                                <TextBlock Text="{Binding DisplayText}"
                                                           FontSize="13" FontWeight="Bold" Foreground="#94A3B8"
                                                           VerticalAlignment="Center" Margin="5,0"
                                                           Visibility="{Binding IsEllipsis, Converter={StaticResource BoolToVis}}"/>

                                                <!-- Nút bấm chuyển trang -->
                                                <Button Content="{Binding DisplayText}"
                                                        Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Width="32" Height="32" Cursor="Hand">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="White"/>
                                                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Setter Property="Foreground" Value="#475569"/>
                                                            <Setter Property="FontSize" Value="12.5"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="pBd" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="pBd" Property="Background" Value="#F1F5F9"/>
                                                                                <Setter Property="Foreground" Value="#0F172A"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Background" Value="#2563EB"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                    <Setter Property="BorderThickness" Value="0"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="›" Command="{Binding NextPageCommand}"
                                        Style="{StaticResource PageNavBtnStyle}" IsEnabled="{Binding CanNextPage}"/>
                            </StackPanel>

                            <!-- Page Size Selector -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Số dòng/trang:" FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox ItemsSource="{Binding PageSizeOptions}"
                                          SelectedItem="{Binding PageSize}"
                                          Height="32" Width="68" FontSize="12.5" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                </Grid>

                <!-- ────────────────────────────────────────────────────────
                     RIGHT COLUMN: "CHI TIẾT CƯ TRÚ" (DETAIL PANEL & TIMELINE)
                     -> STRETCHES VERTICALLY TO ALIGN WITH THE TABLE
                ──────────────────────────────────────────────────────── -->
                <Border Grid.Column="1" Width="330" Margin="16,0,0,0"
                        Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16,14"
                        VerticalAlignment="Stretch"
                        Visibility="{Binding IsDetailPanelVisible, Converter={StaticResource BoolToVis}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" Opacity="0.03" ShadowDepth="1" Color="#000000"/>
                    </Border.Effect>

                    <Grid>
                        <!-- CONTENT KHI CÓ CƯ DÂN ĐƯỢC CHỌN -->
                        <Grid Visibility="{Binding HasSelectedResidence, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <!-- Row 0: Panel Header với nút đóng ✕ -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 1: Avatar & Profile Info -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 2: Divider & Thông tin cư trú hiện tại -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 3: Divider & Tiêu đề Quá trình cư trú -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 4: Quá trình cư trú Timeline - STRETCHES to fill all remaining vertical space! -->
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: Header with close button -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="24" Height="24" CornerRadius="6" Background="#DBEAFE" Margin="0,0,8,0">
                                        <Path Data="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8l-6-6zm-1 2l5 5h-5V4zM8 12h8v2H8v-2zm0 4h8v2H8v-2z" Fill="#2563EB" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Chi tiết cư trú" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Nút Đóng Chi tiết X -->
                                <Button Command="{Binding CloseDetailPanelCommand}"
                                        HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" Padding="4" ToolTip="Đóng chi tiết">
                                    <TextBlock Text="✕" FontSize="13" FontWeight="Bold" Foreground="#94A3B8"/>
                                </Button>
                            </Grid>

                            <!-- Row 1: Avatar & Profile -->
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,4,0,10">
                                <!-- Avatar Round Circle -->
                                <Border Width="56" Height="56" CornerRadius="28" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="2" HorizontalAlignment="Center">
                                    <Image Source="{Binding SelectedResidenceItem.AvatarPath}" Width="52" Height="52" Stretch="UniformToFill">
                                        <RenderOptions.BitmapScalingMode>HighQuality</RenderOptions.BitmapScalingMode>
                                    </Image>
                                </Border>

                                <!-- Full Name -->
                                <TextBlock Text="{Binding SelectedResidenceItem.ResidentName}"
                                           FontSize="16" FontWeight="Bold" Foreground="#0F172A"
                                           HorizontalAlignment="Center" Margin="0,6,0,2"/>

                                <!-- Resident Code -->
                                <TextBlock Text="{Binding SelectedResidenceItem.ResidentCode, StringFormat='Mã cư dân: {0}'}"
                                           FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"/>

                                <!-- Status Badge (Đang cư trú vs Đã kết thúc) -->
                                <Border Margin="0,6,0,0" CornerRadius="12" Padding="10,3" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#DEF7EC"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedResidenceItem.IsActive}" Value="False">
                                                    <Setter Property="Background" Value="#F1F5F9"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="● " FontSize="8" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#059669"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedResidenceItem.IsActive}" Value="False">
                                                            <Setter Property="Foreground" Value="#64748B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock FontWeight="SemiBold" FontSize="11.5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Đang cư trú"/>
                                                    <Setter Property="Foreground" Value="#03543F"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedResidenceItem.IsActive}" Value="False">
                                                            <Setter Property="Text" Value="Đã kết thúc"/>
                                                            <Setter Property="Foreground" Value="#475569"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Row 2: SECTION: THÔNG TIN CƯ TRÚ HIỆN TẠI -->
                            <StackPanel Grid.Row="2">
                                <Rectangle Height="1" Fill="#F1F5F9" Margin="0,4,0,10"/>
                                <TextBlock Text="Thông tin cư trú hiện tại" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="⌂ " FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <TextBlock Text="Căn hộ:" FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedResidenceItem.ApartmentNumber}"
                                               FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="📅 " FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <TextBlock Text="Ngày bắt đầu:" FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedResidenceItem.FormattedStartDate}"
                                               FontSize="12.5" FontWeight="SemiBold" Foreground="#334155"/>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="⌛ " FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <TextBlock Text="Thời gian cư trú:" FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedResidenceItem.ResidenceDuration}"
                                               FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="👥 " FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <TextBlock Text="Vai trò/Quan hệ:" FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedResidenceItem.RelationshipText}"
                                               FontSize="12.5" FontWeight="SemiBold" Foreground="#2563EB"/>
                                </Grid>
                            </StackPanel>

                            <!-- Row 3: Title Quá trình cư trú -->
                            <StackPanel Grid.Row="3">
                                <Rectangle Height="1" Fill="#F1F5F9" Margin="0,8,0,8"/>
                                <TextBlock Text="Quá trình cư trú" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6"/>
                            </StackPanel>

                            <!-- Row 4: Quá trình cư trú (Timeline) - Fills remaining space, with ScrollViewer if many items -->
                            <ScrollViewer x:Name="TimelineScrollViewer" Grid.Row="4"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled"
                                          PreviewMouseWheel="OnTimelinePreviewMouseWheel">
                                <ItemsControl ItemsSource="{Binding SelectedResidentTimeline}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Stepper Node (Ring & Line) -->
                                                <Grid Grid.Column="0" HorizontalAlignment="Center">
                                                    <Rectangle Width="2" Fill="#E2E8F0" Margin="0,14,0,0"
                                                               Visibility="{Binding ShowLine, Converter={StaticResource BoolToVis}}"/>
                                                    <Ellipse Width="12" Height="12" StrokeThickness="2.5" VerticalAlignment="Top" Margin="0,4,0,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Stroke" Value="#16A34A"/>
                                                                <Setter Property="Fill" Value="White"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                        <Setter Property="Stroke" Value="#94A3B8"/>
                                                                        <Setter Property="Fill" Value="#E2E8F0"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                </Grid>

                                                <!-- Step Info -->
                                                <Border Grid.Column="1" Margin="8,0,0,8" CornerRadius="8" Padding="10,6">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Background" Value="#F0FDF4"/>
                                                                    <Setter Property="BorderBrush" Value="#DCFCE7"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <TextBlock FontWeight="Bold" FontSize="13">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{Binding ApartmentNumber, StringFormat='{}{0} – Đang cư trú'}"/>
                                                                    <Setter Property="Foreground" Value="#15803D"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                            <Setter Property="Text" Value="{Binding ApartmentNumber, StringFormat='{}{0} – Đã kết thúc'}"/>
                                                                            <Setter Property="Foreground" Value="#334155"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding DateRangeText}" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- PLACEHOLDER KHI CHƯA CHỌN CƯ DÂN -->
                        <Grid Visibility="{Binding HasNoSelectedResidence, Converter={StaticResource BoolToVis}}"
                              VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="56" Height="56" CornerRadius="28" Background="#F1F5F9" HorizontalAlignment="Center">
                                    <Path Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                          Fill="#94A3B8" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Chưa chọn cư dân" FontSize="14" FontWeight="Bold" Foreground="#475569"
                                           HorizontalAlignment="Center" Margin="0,10,0,4"/>
                                <TextBlock Text="Vui lòng chọn một dòng trong bảng danh sách để tra cứu chi tiết thông tin và tiến trình cư trú."
                                           FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="220"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

        </Grid>

        <!-- ══════════════════════════════════════════════════════════
             5. MODAL FORM DIALOG OVERLAY (Đăng ký / Chuyển hộ / Kết thúc)
        ══════════════════════════════════════════════════════════ -->
        <Grid Background="#66000000" Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1"
                    Width="520" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Opacity="0.15" ShadowDepth="8" Color="#000000"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Form Title -->
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="{Binding FormTitle}" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                        <Button Command="{Binding CancelFormCommand}" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand" Content="✕" FontSize="14" Foreground="#94A3B8"/>
                    </Grid>



                    <!-- FORM 1: ĐĂNG KÝ CƯ TRÚ -->
                    <StackPanel Visibility="{Binding IsRegisterAction, Converter={StaticResource BoolToVis}}">
                        <!-- Chọn Căn hộ -->
                        <TextBlock Text="Căn hộ cư trú:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding AvailableApartments}"
                                  SelectedItem="{Binding SelectedApartmentInput}"
                                  DisplayMemberPath="ApartmentNumber"
                                  Height="38" Margin="0,0,0,14"/>

                        <!-- Chọn Cư dân -->
                        <TextBlock Text="Cư dân đăng ký:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding AvailableResidents}"
                                  SelectedItem="{Binding SelectedResidentInput}"
                                  DisplayMemberPath="FullName"
                                  Height="38" Margin="0,0,0,14"/>

                        <!-- Chọn Loại quan hệ -->
                        <TextBlock Text="Quan hệ với căn hộ:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding RelationshipTypes}"
                                  SelectedItem="{Binding SelectedRelationshipType}"
                                  Height="38" Margin="0,0,0,14"/>

                        <!-- Ngày bắt đầu -->
                        <TextBlock Text="Ngày bắt đầu cư trú:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <DatePicker SelectedDate="{Binding StartDateInput}" Height="38" Margin="0,0,0,16"/>
                    </StackPanel>

                    <!-- FORM 2: CHUYỂN CĂN HỘ -->
                    <StackPanel Visibility="{Binding IsTransferAction, Converter={StaticResource BoolToVis}}">
                        <!-- Cư dân chuyển -->
                        <TextBlock Text="Cư dân cần chuyển hộ:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding ActiveResidencesForSelection}"
                                  SelectedItem="{Binding SelectedResidence}"
                                  Height="38" Margin="0,0,0,14">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding Resident.FullName, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text=" (Đang ở: " Foreground="#64748B"/>
                                        <Run Text="{Binding Apartment.ApartmentNumber, Mode=OneWay}" Foreground="#2563EB" FontWeight="Bold"/>
                                        <Run Text=")" Foreground="#64748B"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Chọn Căn hộ mới -->
                        <TextBlock Text="Chuyển đến Căn hộ mới:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding AvailableApartments}"
                                  SelectedItem="{Binding SelectedApartmentInput}"
                                  DisplayMemberPath="ApartmentNumber"
                                  Height="38" Margin="0,0,0,14"/>

                        <!-- Quan hệ tại căn mới -->
                        <TextBlock Text="Quan hệ tại căn hộ mới:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding RelationshipTypes}"
                                  SelectedItem="{Binding SelectedRelationshipType}"
                                  Height="38" Margin="0,0,0,14"/>

                        <!-- Ngày chuyển -->
                        <TextBlock Text="Ngày chuyển căn hộ:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <DatePicker SelectedDate="{Binding StartDateInput}" Height="38" Margin="0,0,0,16"/>
                    </StackPanel>

                    <!-- FORM 3: KẾT THÚC CƯ TRÚ -->
                    <StackPanel Visibility="{Binding IsTerminateAction, Converter={StaticResource BoolToVis}}">
                        <!-- Chọn hồ sơ kết thúc -->
                        <TextBlock Text="Hồ sơ cư trú cần kết thúc:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding ActiveResidencesForSelection}"
                                  SelectedItem="{Binding SelectedResidence}"
                                  Height="38" Margin="0,0,0,14">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding Resident.FullName, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text=" - Căn hộ: " Foreground="#64748B"/>
                                        <Run Text="{Binding Apartment.ApartmentNumber, Mode=OneWay}" Foreground="#2563EB" FontWeight="Bold"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Ngày kết thúc -->
                        <TextBlock Text="Ngày kết thúc cư trú:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <DatePicker SelectedDate="{Binding EndDateInput}" Height="38" Margin="0,0,0,16"/>
                    </StackPanel>

                    <!-- Modal Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Hủy bỏ" Command="{Binding CancelFormCommand}"
                                Style="{StaticResource RoundedSecondaryBtn}" Margin="0,0,10,0"/>
                        <Button Content="Xác nhận lưu" Command="{Binding SaveResidencyCommand}"
                                Style="{StaticResource RoundedPrimaryBtn}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════
             6. MODAL DIALOG: CHI TIẾT YÊU CẦU THÊM THÀNH VIÊN
        ══════════════════════════════════════════════════════════ -->
        <Grid Background="#66000000" Visibility="{Binding IsRequestDetailModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="16" Width="520" Padding="28,24"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="#CBD5E1" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Opacity="0.18" ShadowDepth="6" Color="#000000"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="➕" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Yêu cầu thêm thành viên" FontSize="17" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                                FontSize="16" FontWeight="Bold" Foreground="#94A3B8" Cursor="Hand"
                                Command="{Binding CloseRequestDetailModalCommand}"/>
                    </Grid>

                    <!-- Subtitle -->
                    <TextBlock Text="Gửi yêu cầu đăng ký thêm thành viên vào căn hộ đến Ban quản lý toà nhà để phê duyệt."
                               FontSize="12.5" Foreground="#64748B" Margin="0,0,0,14" TextWrapping="Wrap"/>

                    <!-- Khối thông tin đơn gửi: Căn hộ, Người tạo đơn, Ngày tạo đơn -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10"
                            Padding="14,10" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Căn hộ -->
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="CĂN HỘ" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding SelectedRequestDetail.ApartmentNumber}" FontSize="14" FontWeight="Bold" Foreground="#2563EB"/>
                            </StackPanel>

                            <!-- Người tạo đơn -->
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="NGƯỜI TẠO ĐƠN" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding SelectedRequestDetail.RequesterName}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Ngày tạo đơn -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock Text="NGÀY TẠO ĐƠN" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding SelectedRequestDetail.CreatedAtFormatted}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 1. Họ và tên thành viên -->
                    <StackPanel Margin="0,0,0,11">
                        <TextBlock Text="Họ và tên thành viên (*)" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12,8">
                            <TextBlock Text="{Binding SelectedRequestDetail.FullName}" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A"/>
                        </Border>
                    </StackPanel>

                    <!-- 2. Ngày sinh & Quan hệ cư trú -->
                    <Grid Margin="0,0,0,11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ngày sinh -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ngày sinh (*)" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                <Grid>
                                    <TextBlock Text="{Binding SelectedRequestDetail.BirthDateText}" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    <TextBlock Text="📅" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#64748B"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Quan hệ cư trú -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Quan hệ cư trú (*)" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                <TextBlock Text="{Binding SelectedRequestDetail.RelationshipText}" FontSize="13" FontWeight="SemiBold" Foreground="#2563EB" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- 3. Quan hệ cụ thể với chủ hộ -->
                    <StackPanel Margin="0,0,0,11">
                        <TextBlock Text="Quan hệ cụ thể với chủ hộ (*)" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12,8">
                            <TextBlock Text="{Binding SelectedRequestDetail.SpecificRelationshipText}" FontSize="13" Foreground="#0F172A"/>
                        </Border>
                    </StackPanel>

                    <!-- 4. Số CCCD / Mã định danh -->
                    <StackPanel Margin="0,0,0,11">
                        <TextBlock Text="Số CCCD / Mã định danh (12 số)" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12,8">
                            <TextBlock Text="{Binding SelectedRequestDetail.IdentityCardText}" FontSize="13" Foreground="#0F172A"/>
                        </Border>
                    </StackPanel>

                    <!-- 5. Số điện thoại & Email -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Số điện thoại -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Số điện thoại" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                <TextBlock Text="{Binding SelectedRequestDetail.PhoneNumberText}" FontSize="13" Foreground="#0F172A"/>
                            </Border>
                        </StackPanel>

                        <!-- Email -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Email" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                <TextBlock Text="{Binding SelectedRequestDetail.EmailText}" FontSize="13" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- 6. Trạng thái hiện tại -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Trạng thái hiện tại: " FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center"/>
                            <Border Background="{Binding SelectedRequestDetail.StatusBadgeBg}"
                                    BorderBrush="{Binding SelectedRequestDetail.StatusBadgeBorder}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,3" Margin="8,0,0,0">
                                <TextBlock Text="{Binding SelectedRequestDetail.StatusText}"
                                           Foreground="{Binding SelectedRequestDetail.StatusBadgeFg}"
                                           FontWeight="SemiBold" FontSize="12"/>
                            </Border>
                            <TextBlock Text="{Binding SelectedRequestDetail.ProcessedAtText, StringFormat='{} (Ngày xử lý: {0})'}"
                                       Foreground="#94A3B8" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding SelectedRequestDetail.IsProcessed, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Khung lý do từ chối nếu có -->
                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8"
                            Padding="12,8" Margin="0,0,0,14"
                            Visibility="{Binding SelectedRequestDetail.HasRejectReason, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Lý do từ chối:" FontSize="12" FontWeight="Bold" Foreground="#DC2626" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding SelectedRequestDetail.RejectReason}" FontSize="13" Foreground="#991B1B" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- 7. Buttons dưới cùng -->
                    <!-- Khi Chưa duyệt: Có đủ [Hủy bỏ], [Từ chối], [Duyệt yêu cầu] -->
                    <Grid Visibility="{Binding SelectedRequestDetail.CanApprove, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Nút Hủy bỏ -->
                        <Button Grid.Column="0" Content="Hủy bỏ" Height="40" Background="#F1F5F9" Foreground="#475569"
                                FontWeight="SemiBold" FontSize="13" BorderThickness="0" Cursor="Hand"
                                Command="{Binding CloseRequestDetailModalCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Nút Từ chối -->
                        <Button Grid.Column="2" Content="Từ chối" Height="40" Background="#EF4444" Foreground="White"
                                FontWeight="SemiBold" FontSize="13" BorderThickness="0" Cursor="Hand"
                                Command="{Binding OpenRejectDialogCommand}"
                                CommandParameter="{Binding SelectedRequestDetail}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Nút Duyệt yêu cầu -->
                        <Button Grid.Column="4" Content="Duyệt yêu cầu" Height="40" Background="#2563EB" Foreground="White"
                                FontWeight="SemiBold" FontSize="13" BorderThickness="0" Cursor="Hand"
                                Command="{Binding ApproveRequestCommand}"
                                CommandParameter="{Binding SelectedRequestDetail}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Khi Đã xử lý (Đã duyệt hoặc Từ chối): Chỉ hiện nút Đóng -->
                    <Grid Visibility="{Binding SelectedRequestDetail.IsProcessed, Converter={StaticResource BoolToVis}}">
                        <Button Content="Đóng" Height="40" Background="#F1F5F9" Foreground="#475569"
                                FontWeight="SemiBold" FontSize="13" BorderThickness="0" Cursor="Hand"
                                Command="{Binding CloseRequestDetailModalCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════
             7. MODAL DIALOG: TỪ CHỐI YÊU CẦU THÀNH VIÊN
        ══════════════════════════════════════════════════════════ -->
        <Grid Background="#66000000" Visibility="{Binding IsRejectDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1"
                    Width="440" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Opacity="0.15" ShadowDepth="8" Color="#000000"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Title -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="14" Background="#FEE2E2" Margin="0,0,8,0">
                                <TextBlock Text="✕" FontSize="13" FontWeight="Bold" Foreground="#DC2626"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Từ chối yêu cầu thành viên" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Command="{Binding CloseRejectDialogCommand}" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand" Content="✕" FontSize="14" Foreground="#94A3B8"/>
                    </Grid>

                    <!-- Description -->
                    <TextBlock Text="Vui lòng nhập lý do từ chối yêu cầu thêm thành viên này (thông tin sẽ được gửi đến cư dân):"
                               FontSize="13" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <!-- Reason TextBox -->
                    <TextBox Text="{Binding RejectReasonInput, UpdateSourceTrigger=PropertyChanged}"
                             Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalContentAlignment="Top" Padding="10" FontSize="13"
                             Margin="0,0,0,16"/>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Hủy bỏ" Command="{Binding CloseRejectDialogCommand}"
                                Style="{StaticResource RoundedSecondaryBtn}" Margin="0,0,10,0"/>
                        <Button Content="Xác nhận từ chối" Command="{Binding ConfirmRejectRequestCommand}"
                                Style="{StaticResource RoundedDangerBtn}" Padding="16,8" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <!-- FLOATING TOAST NOTIFICATIONS (GÓC DƯỚI BÊN PHẢI - 3S) -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,28,24" Panel.ZIndex="99999" IsHitTestVisible="True">
            <controls:NotificationBanner Message="{Binding RequestSuccessMessage}" Kind="Success" Margin="0,0,0,8"/>
            <controls:NotificationBanner Message="{Binding ErrorMessage}" Kind="Error"/>
        </StackPanel>
    </Grid>
</UserControl>