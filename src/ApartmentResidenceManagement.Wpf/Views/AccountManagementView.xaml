<UserControl x:Class="ApartmentResidenceManagement.Wpf.Views.AccountManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:ApartmentResidenceManagement.Wpf.Controls"
             xmlns:enums="clr-namespace:ApartmentResidenceManagement.Domain.Enums;assembly=ApartmentResidenceManagement.Domain"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200"
             Background="#F8FAFC">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Override System Highlight to prevent harsh selection borders -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E0F2FE"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E0F2FE"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A"/>

        <!-- Modern DataGrid Cell (Loại bỏ viền đen) -->
        <Style x:Key="ModernDataGridCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern DataGrid Row -->
        <Style x:Key="ModernDataGridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#F1F5F9"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E0F2FE"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Column Header -->
        <Style x:Key="ModernDataGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- Pagination Page Button -->
        <Style x:Key="PageNavBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Circular Action Button -->
        <Style x:Key="CircularActionButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="15" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ══════════════════════════════════════════════════════════
             MAIN PAGE LAYOUT
        ══════════════════════════════════════════════════════════ -->
        <Grid Margin="24,14,24,16" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <!-- Row 0: Header -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: KPI Stats Cards -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: Notifications -->
                <RowDefinition Height="Auto"/>
                <!-- Row 3: Main Content (List + Detail) -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════════
                 1. HEADER (Icon ⚙ + Tiêu đề Quản lý Tài khoản)
            ══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#EFF6FF" VerticalAlignment="Center">
                    <Path Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                          Fill="#2563EB" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Quản lý Tài khoản" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Quản lý tài khoản đăng nhập và phân quyền sử dụng hệ thống."
                               FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 2. STATS KPI CARDS (3 Thẻ thống kê: Tổng / Đang hoạt động / Đã khóa)
            ══════════════════════════════════════════════════════════ -->
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,14">
                <!-- KPI 1: Tổng tài khoản -->
                <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18,14" Margin="0,0,8,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" Opacity="0.03" ShadowDepth="1" Color="#000000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="46" Height="46" CornerRadius="12" Background="#EFF6FF" VerticalAlignment="Center">
                            <Path Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
                                  Fill="#2563EB" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalAccountsCount}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Tổng tài khoản" FontSize="12.5" FontWeight="Medium" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- KPI 2: Đang hoạt động -->
                <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18,14" Margin="4,0,4,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" Opacity="0.03" ShadowDepth="1" Color="#000000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="46" Height="46" CornerRadius="12" Background="#DCFCE7" VerticalAlignment="Center">
                            <Path Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z M17.8 7.3l-1.4-1.4-3.4 3.4-1.4-1.4-1.4 1.4 2.8 2.8z"
                                  Fill="#16A34A" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveAccountsCount}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Đang hoạt động" FontSize="12.5" FontWeight="Medium" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- KPI 3: Đã khóa -->
                <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18,14" Margin="8,0,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" Opacity="0.03" ShadowDepth="1" Color="#000000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="46" Height="46" CornerRadius="12" Background="#FEE2E2" VerticalAlignment="Center">
                            <Path Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"
                                  Fill="#DC2626" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LockedAccountsCount}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Đã khóa" FontSize="12.5" FontWeight="Medium" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- ══════════════════════════════════════════════════════════
                 NOTIFICATIONS
            ══════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="2" Margin="0,0,0,10">
                <controls:NotificationBanner Message="{Binding SuccessMessage}" Kind="Success" Margin="0,0,0,6"
                                             Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVis}}"/>
                <controls:NotificationBanner Message="{Binding ErrorMessage}" Kind="Error"
                                             Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <!-- ══════════════════════════════════════════════════════════
                 3. MAIN CONTENT: Left List + Right Detail Panel
            ══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="3" VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="330"/>
                </Grid.ColumnDefinitions>

                <!-- ────────────────────────────────────────────────────────
                     LEFT COLUMN: DANH SÁCH TÀI KHOẢN CARD
                ──────────────────────────────────────────────────────── -->
                <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16"
                        VerticalAlignment="Stretch">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" Opacity="0.03" ShadowDepth="1" Color="#000000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Row 0: Header with '+ Tạo tài khoản' button -->
                            <RowDefinition Height="Auto"/>
                            <!-- Row 1: Search & Filter Toolbar -->
                            <RowDefinition Height="Auto"/>
                            <!-- Row 2: Accounts DataGrid (stretches vertically) -->
                            <RowDefinition Height="*"/>
                            <!-- Row 3: Pagination Footer -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Card Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z"
                                      Fill="#2563EB" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Danh sách tài khoản" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Button + Tạo tài khoản -->
                            <Button HorizontalAlignment="Right" Command="{Binding OpenCreateAccountDialogCommand}"
                                    Background="#2563EB" Foreground="White" BorderThickness="0"
                                    Height="36" Padding="16,0" FontSize="13" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="+" FontSize="16" FontWeight="Bold" Margin="0,-2,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Tạo tài khoản" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1D4ED8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Search & Filter Toolbar -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Search Input -->
                            <Grid Grid.Column="0" Margin="0,0,10,0">
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Height="36" FontSize="13" Padding="32,0,10,0" VerticalContentAlignment="Center"/>
                                <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                      Fill="#94A3B8" Width="15" Height="15" Stretch="Uniform"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                                <TextBlock Text="Tìm theo tên đăng nhập, họ tên..."
                                           FontSize="13" Foreground="#94A3B8"
                                           VerticalAlignment="Center" Margin="32,0,0,0" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- Vai trò Filter -->
                            <Grid Grid.Column="1" Margin="0,0,10,0">
                                <ComboBox ItemsSource="{Binding RoleFilterOptions}"
                                          SelectedItem="{Binding SelectedRoleFilter}"
                                          Height="36" Width="145" FontSize="13" Padding="60,0,10,0" VerticalContentAlignment="Center"/>
                                <TextBlock Text="Vai trò:" FontSize="13" Foreground="#64748B" FontWeight="Medium"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                            </Grid>

                            <!-- Trạng thái Filter -->
                            <Grid Grid.Column="2" Margin="0,0,10,0">
                                <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                                          SelectedItem="{Binding SelectedStatusFilter}"
                                          Height="36" Width="165" FontSize="13" Padding="80,0,10,0" VerticalContentAlignment="Center"/>
                                <TextBlock Text="Trạng thái:" FontSize="13" Foreground="#64748B" FontWeight="Medium"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                            </Grid>

                            <!-- Refresh Button -->
                            <Button Grid.Column="3" Command="{Binding RefreshCommand}"
                                    Height="36" Padding="14,0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                    Cursor="Hand" ToolTip="Làm mới danh sách">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="rfBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                                      Fill="#475569" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Làm mới" FontSize="13" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="rfBorder" Property="Background" Value="#F8FAFC"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Accounts DataGrid Table -->
                        <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1"
                                VerticalAlignment="Stretch">
                            <DataGrid x:Name="AccountsDataGrid"
                                      ItemsSource="{Binding PagedAccounts}"
                                      SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      FocusVisualStyle="{x:Null}"
                                      PreviewMouseWheel="OnAccountsDataGridPreviewMouseWheel"
                                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F1F5F9"
                                      HeadersVisibility="Column"
                                      BorderThickness="0"
                                      Background="White"
                                      VerticalAlignment="Stretch"
                                      CellStyle="{StaticResource ModernDataGridCell}"
                                      RowStyle="{StaticResource ModernDataGridRow}"
                                      ColumnHeaderStyle="{StaticResource ModernDataGridHeader}">

                                <DataGrid.Columns>
                                    <!-- Column 1: STT -->
                                    <DataGridTextColumn Header="#" Binding="{Binding Stt}" Width="45">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                <Setter Property="FontWeight" Value="Medium"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Column 2: Tên đăng nhập (Bold Blue) -->
                                    <DataGridTemplateColumn Header="Tên đăng nhập" Width="1.3*" MinWidth="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Username}" FontWeight="Bold" FontSize="13" Foreground="#2563EB"
                                                           VerticalAlignment="Center" Margin="10,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Column 3: Người sử dụng -->
                                    <DataGridTextColumn Header="Người sử dụng" Binding="{Binding FullName}" Width="1.8*" MinWidth="140">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#0F172A"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="FontSize" Value="13"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="10,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Column 4: Vai trò (Pill Badge: 👑 Admin / 👤 Cư dân) -->
                                    <DataGridTemplateColumn Header="Vai trò" Width="1.2*" MinWidth="105">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding RoleBadgeBg}"
                                                        BorderBrush="{Binding RoleBadgeBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="8,3"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Margin="10,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RoleIcon}" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding RoleText}"
                                                                   Foreground="{Binding RoleBadgeFg}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="12"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Column 5: Trạng thái (● Hoạt động / ● Đã khóa) -->
                                    <DataGridTemplateColumn Header="Trạng thái" Width="1.3*" MinWidth="115">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding StatusBadgeBg}"
                                                        BorderBrush="{Binding StatusBadgeBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="8,3"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Margin="10,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="● "
                                                                   Foreground="{Binding StatusBadgeFg}"
                                                                   FontSize="8"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   Foreground="{Binding StatusBadgeFg}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="12"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Column 6: Thao tác (3 buttons: Xem 👁 / Đặt lại MK 🔑 / Khóa 🔒/🔓) -->
                                    <DataGridTemplateColumn Header="Thao tác" Width="135">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <!-- Button 1: Xem chi tiết -->
                                                    <Button Style="{StaticResource CircularActionButton}"
                                                            Background="#EFF6FF"
                                                            ToolTip="Xem chi tiết tài khoản"
                                                            Command="{Binding DataContext.SelectAccountCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}">
                                                        <Path Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zm0 12.5c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                                                              Fill="#2563EB" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Button>

                                                    <!-- Button 2: Đặt lại mật khẩu -->
                                                    <Button Style="{StaticResource CircularActionButton}"
                                                            Background="#FEF3C7"
                                                            ToolTip="Đặt lại mật khẩu"
                                                            Command="{Binding DataContext.OpenResetPasswordDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}">
                                                        <Path Data="M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v4h4v-4h2v-4H12.65zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"
                                                              Fill="#D97706" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Button>

                                                    <!-- Button 3: Khóa / Mở khóa -->
                                                    <Button Style="{StaticResource CircularActionButton}"
                                                            Background="{Binding ToggleLockBackground}"
                                                            ToolTip="{Binding ToggleLockToolTip}"
                                                            IsEnabled="{Binding CanToggle}"
                                                            Command="{Binding DataContext.ToggleAccountStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="{Binding ToggleLockIcon}" FontSize="12" Foreground="{Binding ToggleLockForeground}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Pagination Footer -->
                        <Grid Grid.Row="3" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Summary text: Hiển thị X / Y tài khoản -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Hiển thị " FontSize="13" Foreground="#64748B"/>
                                <TextBlock Text="{Binding PagedAccounts.Count}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                <TextBlock Text=" / " FontSize="13" Foreground="#64748B"/>
                                <TextBlock Text="{Binding TotalItems}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                <TextBlock Text=" tài khoản" FontSize="13" Foreground="#64748B"/>
                            </StackPanel>

                            <!-- Page Nav Buttons: < [1] 2 3 ... 11 > -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="‹" Command="{Binding PreviousPageCommand}"
                                        Style="{StaticResource PageNavBtnStyle}"/>

                                <ItemsControl ItemsSource="{Binding PaginationPages}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="1,0">
                                                <!-- Dấu ba chấm nếu là ellipsis -->
                                                <TextBlock Text="{Binding DisplayText}"
                                                           FontSize="13" FontWeight="Bold" Foreground="#94A3B8"
                                                           VerticalAlignment="Center" Margin="5,0"
                                                           Visibility="{Binding IsEllipsis, Converter={StaticResource BoolToVis}}"/>

                                                <!-- Nút bấm chuyển trang -->
                                                <Button Content="{Binding DisplayText}"
                                                        Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Width="32" Height="32" Cursor="Hand">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="White"/>
                                                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Setter Property="Foreground" Value="#475569"/>
                                                            <Setter Property="FontSize" Value="12.5"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="pBd" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="pBd" Property="Background" Value="#F1F5F9"/>
                                                                                <Setter Property="Foreground" Value="#0F172A"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Background" Value="#2563EB"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                    <Setter Property="BorderThickness" Value="0"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="›" Command="{Binding NextPageCommand}"
                                        Style="{StaticResource PageNavBtnStyle}"/>
                            </StackPanel>

                            <!-- Số dòng/trang -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Số dòng/trang:" FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox ItemsSource="{Binding PageSizeOptions}"
                                          SelectedItem="{Binding PageSize}"
                                          Height="32" Width="68" FontSize="12.5" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ────────────────────────────────────────────────────────
                     RIGHT COLUMN: CHI TIẾT TÀI KHOẢN CARD
                ──────────────────────────────────────────────────────── -->
                <Border Grid.Column="1" Margin="16,0,0,0"
                        Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="18"
                        VerticalAlignment="Stretch">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" Opacity="0.03" ShadowDepth="1" Color="#000000"/>
                    </Border.Effect>

                    <Grid>
                        <!-- Content khi có SelectedAccount -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Row 0: Header: ℹ Chi tiết tài khoản -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 1: Profile avatar & Name & Status pill -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 2: Divider & Thông tin tài khoản -->
                                <RowDefinition Height="*"/>
                                <!-- Row 3: Action Buttons (Đặt lại mật khẩu & Khóa/Mở khóa) -->
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="24" Height="24" CornerRadius="6" Background="#EFF6FF" Margin="0,0,8,0">
                                        <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"
                                              Fill="#2563EB" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Chi tiết tài khoản" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 1: Profile avatar & Name & Status -->
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,4,0,16">
                                <!-- Round Avatar -->
                                <Border Width="68" Height="68" CornerRadius="34" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="2" HorizontalAlignment="Center">
                                    <Image Source="{Binding SelectedAccount.AvatarPath}" Width="64" Height="64" Stretch="UniformToFill">
                                        <RenderOptions.BitmapScalingMode>HighQuality</RenderOptions.BitmapScalingMode>
                                    </Image>
                                </Border>

                                <!-- Full Name -->
                                <TextBlock Text="{Binding SelectedAccount.FullName}"
                                           FontSize="17" FontWeight="Bold" Foreground="#0F172A"
                                           HorizontalAlignment="Center" Margin="0,10,0,2"/>

                                <!-- Username -->
                                <TextBlock Text="{Binding SelectedAccount.Username, StringFormat='Tên đăng nhập: {0}'}"
                                           FontSize="12.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                                <!-- Status Badge -->
                                <Border Background="{Binding SelectedAccount.StatusBadgeBg}"
                                        BorderBrush="{Binding SelectedAccount.StatusBadgeBorder}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="12,4"
                                        HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="● "
                                                   Foreground="{Binding SelectedAccount.StatusBadgeFg}"
                                                   FontSize="8"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedAccount.StatusText}"
                                                   Foreground="{Binding SelectedAccount.StatusBadgeFg}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Row 2: Section: Thông tin tài khoản -->
                            <StackPanel Grid.Row="2" VerticalAlignment="Top">
                                <Rectangle Height="1" Fill="#F1F5F9" Margin="0,0,0,14"/>
                                <TextBlock Text="Thông tin tài khoản" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                                <!-- Mã tài khoản -->
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🪪 " FontSize="13" VerticalAlignment="Center" Foreground="#64748B"/>
                                        <TextBlock Text="Mã tài khoản:" FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedAccount.AccountCode}"
                                               FontSize="13" FontWeight="Bold" Foreground="#0F172A"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Mã cư dân -->
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="👥 " FontSize="13" VerticalAlignment="Center" Foreground="#64748B"/>
                                        <TextBlock Text="Mã cư dân:" FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedAccount.ResidentCode}"
                                               FontSize="13" FontWeight="Bold" Foreground="#2563EB"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Vai trò -->
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="👤 " FontSize="13" VerticalAlignment="Center" Foreground="#64748B"/>
                                        <TextBlock Text="Vai trò:" FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedAccount.RoleText}"
                                               FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Ngày tạo -->
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📅 " FontSize="13" VerticalAlignment="Center" Foreground="#64748B"/>
                                        <TextBlock Text="Ngày tạo:" FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedAccount.CreatedAtFormatted}"
                                               FontSize="13" FontWeight="Medium" Foreground="#334155"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Lần đăng nhập cuối -->
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🕒 " FontSize="13" VerticalAlignment="Center" Foreground="#64748B"/>
                                        <TextBlock Text="Lần đăng nhập cuối:" FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedAccount.LastLoginFormatted}"
                                               FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>

                            <!-- Row 3: Action Buttons at Bottom -->
                            <StackPanel Grid.Row="3" Margin="0,14,0,0">
                                <Rectangle Height="1" Fill="#F1F5F9" Margin="0,0,0,14"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Nút 1: Đặt lại mật khẩu -->
                                    <Button Grid.Column="0" Command="{Binding OpenResetPasswordDialogCommand}"
                                            CommandParameter="{Binding SelectedAccount}"
                                            Background="White" BorderBrush="#2563EB" BorderThickness="1"
                                            Foreground="#2563EB" Height="36" Margin="0,0,5,0"
                                            FontSize="12.5" FontWeight="SemiBold" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bdReset" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Path Data="M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v4h4v-4h2v-4H12.65zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"
                                                              Fill="#2563EB" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <TextBlock Text="Đặt lại mật khẩu" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bdReset" Property="Background" Value="#EFF6FF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Nút 2: Khóa tài khoản / Mở khóa tài khoản -->
                                    <Button Grid.Column="1" Command="{Binding ToggleAccountStatusCommand}"
                                            CommandParameter="{Binding SelectedAccount}"
                                            IsEnabled="{Binding SelectedAccount.CanToggle}"
                                            Background="White" BorderBrush="#DC2626" BorderThickness="1"
                                            Foreground="#DC2626" Height="36" Margin="5,0,0,0"
                                            FontSize="12.5" FontWeight="SemiBold" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="BorderBrush" Value="#DC2626"/>
                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedAccount.IsActive}" Value="False">
                                                        <Setter Property="BorderBrush" Value="#16A34A"/>
                                                        <Setter Property="Foreground" Value="#16A34A"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.4"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bdLock" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SelectedAccount.ToggleLockIcon}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding SelectedAccount.ToggleLockToolTip}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bdLock" Property="Background" Value="#FEF2F2"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════
             MODAL 1: ĐẶT LẠI MẬT KHẨU
        ══════════════════════════════════════════════════════════ -->
        <Grid Background="#80000000" Visibility="{Binding IsResetPasswordDialogOpen, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="100">
            <Border Background="White" CornerRadius="12" Width="420" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" Opacity="0.15" ShadowDepth="4"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔑 " FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Đặt lại mật khẩu" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Command="{Binding CloseResetPasswordDialogCommand}" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="#94A3B8"/>
                        </Button>
                    </Grid>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Tài khoản:" FontSize="12.5" Foreground="#64748B"/>
                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="#2563EB" Margin="0,2,0,0">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} ({1})">
                                    <Binding Path="AccountToReset.Username"/>
                                    <Binding Path="AccountToReset.FullName"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Mật khẩu mới (*):" FontSize="12.5" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding NewPasswordInput, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36" FontSize="13" VerticalContentAlignment="Center" Padding="8,0"/>
                    </StackPanel>

                    <TextBlock Text="{Binding ResetPasswordErrorMessage}" Foreground="#DC2626" FontSize="12" Margin="0,0,0,12"
                               Visibility="{Binding ResetPasswordErrorMessage, Converter={StaticResource BoolToVis}}" TextWrapping="Wrap"/>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Hủy bỏ" Command="{Binding CloseResetPasswordDialogCommand}"
                                Height="36" Margin="0,0,6,0" Background="#F1F5F9" Foreground="#475569" BorderThickness="0"
                                FontWeight="SemiBold" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="1" Content="Xác nhận đổi" Command="{Binding ConfirmResetPasswordCommand}"
                                Height="36" Margin="6,0,0,0" Background="#2563EB" Foreground="White" BorderThickness="0"
                                FontWeight="SemiBold" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════
             MODAL 2: TẠO TÀI KHOẢN MỚI
        ══════════════════════════════════════════════════════════ -->
        <Grid Background="#80000000" Visibility="{Binding IsCreateAccountDialogOpen, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="100">
            <Border Background="White" CornerRadius="12" Width="460" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" Opacity="0.15" ShadowDepth="4"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="➕ " FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Tạo tài khoản mới" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Command="{Binding CloseCreateAccountDialogCommand}" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="#94A3B8"/>
                        </Button>
                    </Grid>

                    <!-- Vai trò: Admin hoặc Cư dân -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Vai trò (*):" FontSize="12.5" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox SelectedValue="{Binding NewAccountRole}"
                                  SelectedValuePath="Tag"
                                  Height="36" FontSize="13" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="👤 Cư dân" Tag="{x:Static enums:UserRole.Resident}" IsSelected="True"/>
                            <ComboBoxItem Content="👑 Admin (Ban quản lý)" Tag="{x:Static enums:UserRole.Admin}"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Chọn Cư dân liên kết (nếu vai trò là Resident) -->
                    <StackPanel Margin="0,0,0,12" Visibility="{Binding IsCreatingResident, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Cư dân liên kết (*):" FontSize="12.5" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding AvailableResidentsWithoutAccount}"
                                  SelectedItem="{Binding SelectedResidentForNewAccount}"
                                  DisplayMemberPath="FullName"
                                  Height="36" FontSize="13" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Tên đăng nhập -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Tên đăng nhập (*):" FontSize="12.5" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding NewUsernameInput, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36" FontSize="13" VerticalContentAlignment="Center" Padding="8,0"/>
                    </StackPanel>

                    <!-- Mật khẩu ban đầu -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Mật khẩu ban đầu (*):" FontSize="12.5" Foreground="#0F172A" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding NewAccountPasswordInput, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36" FontSize="13" VerticalContentAlignment="Center" Padding="8,0"/>
                    </StackPanel>

                    <TextBlock Text="{Binding CreateAccountErrorMessage}" Foreground="#DC2626" FontSize="12" Margin="0,0,0,12"
                               Visibility="{Binding CreateAccountErrorMessage, Converter={StaticResource BoolToVis}}" TextWrapping="Wrap"/>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Hủy bỏ" Command="{Binding CloseCreateAccountDialogCommand}"
                                Height="36" Margin="0,0,6,0" Background="#F1F5F9" Foreground="#475569" BorderThickness="0"
                                FontWeight="SemiBold" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="1" Content="Tạo tài khoản" Command="{Binding ConfirmCreateAccountCommand}"
                                Height="36" Margin="6,0,0,0" Background="#2563EB" Foreground="White" BorderThickness="0"
                                FontWeight="SemiBold" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
