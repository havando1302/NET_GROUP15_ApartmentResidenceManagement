<Window x:Class="ApartmentResidenceManagement.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:ApartmentResidenceManagement.Wpf.ViewModels"
        xmlns:views="clr-namespace:ApartmentResidenceManagement.Wpf.Views"
        xmlns:helpers="clr-namespace:ApartmentResidenceManagement.Wpf.Helpers"
        xmlns:controls="clr-namespace:ApartmentResidenceManagement.Wpf.Controls"
        xmlns:enums="clr-namespace:ApartmentResidenceManagement.Domain.Enums;assembly=ApartmentResidenceManagement.Domain"
        mc:Ignorable="d"
        Title="Hệ thống Quản lý Căn hộ &amp; Cư trú - ResidenceManager"
        Height="768" Width="1366"
        MinHeight="650" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{StaticResource PageBgBrush}">

    <Window.Resources>
        <!-- DataTemplate mapping -->
        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ApartmentViewModel}"><views:ApartmentView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ResidentViewModel}"><views:ResidentView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ResidencyViewModel}"><views:ResidencyView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AccountManagementViewModel}"><views:AccountManagementView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:VehicleViewModel}"><views:VehicleView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:StatisticsViewModel}"><views:StatisticsView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ResidentHomeViewModel}"><views:ResidentHomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:MyProfileViewModel}"><views:MyProfileView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:MyApartmentViewModel}"><views:MyApartmentView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:FamilyMembersViewModel}"><views:FamilyMembersView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:MyVehiclesViewModel}"><views:MyVehiclesView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ResidencyHistoryViewModel}"><views:ResidencyHistoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:UnderDevelopmentViewModel}"><views:UnderDevelopmentView /></DataTemplate>

        <!-- Sidebar Base Button -->
        <Style x:Key="SidebarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="12,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#25FFFFFF"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#35FFFFFF"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════════
             SIDEBAR TRÁI: NAVY BLUE GRADIENT THEO MẪU (ĐẬM HƠN NHẸ)
        ══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#163A7A" Offset="0.0"/>
                    <GradientStop Color="#1A4186" Offset="0.5"/>
                    <GradientStop Color="#214E99" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Brand -->
                    <RowDefinition Height="Auto"/> <!-- User Profile Card (Cư dân) -->
                    <RowDefinition Height="*"/>    <!-- Navigation List -->
                    <RowDefinition Height="Auto"/> <!-- Đăng xuất -->
                </Grid.RowDefinitions>

                <!-- 1. Brand Header -->
                <StackPanel Grid.Row="0" Margin="20,22,20,16" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="White" Margin="0,0,12,0">
                        <TextBlock Text="🏢" Foreground="#1D4ED8" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ResidenceManager" Foreground="White" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="{Binding PortalSubtitle}" Foreground="#BFDBFE" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 2. Thẻ hồ sơ cá nhân nhanh ở sidebar (khớp bản mẫu mockup) -->
                <!-- Cho Cư dân -->
                <Border Grid.Row="1" Background="#18FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="12" Margin="14,0,14,16" Padding="12,10"
                        Visibility="{Binding IsResident, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Avatar với chấm online xanh -->
                        <Grid Grid.Column="0" Margin="0,0,10,0">
                            <Border Width="38" Height="38" CornerRadius="19" Background="#334155" ClipToBounds="True">
                                <Image Source="/Assets/resident_avatar.png" Stretch="UniformToFill"/>
                            </Border>
                            <Border Width="10" Height="10" CornerRadius="5" Background="#22C55E" BorderBrush="#163A7A" BorderThickness="1.5"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Grid>
                        <!-- Tên cư dân & Căn hộ -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ResidentDisplayName}" Foreground="White" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Text="{Binding ResidentApartmentInfo}" Foreground="#BFDBFE" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Cho Quản trị viên -->
                <Border Grid.Row="1" Background="#18FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="12" Margin="14,0,14,16" Padding="12,10"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="19" Background="#065F46" Margin="0,0,10,0">
                            <TextBlock Text="🛡️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding WelcomeMessage}" Foreground="White" FontWeight="Bold" FontSize="13"/>
                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,4,0,0" Background="#064E3B">
                                <TextBlock Text="{Binding RoleMessage}" FontSize="10" FontWeight="SemiBold" Foreground="#34D399"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3. Danh sách Menu Điều hướng -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- ADMIN MENU -->
                        <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="QUẢN TRỊ VIÊN" FontSize="11" FontWeight="Bold" Foreground="#93C5FD" Margin="24,8,0,8" />

                            <!-- Dashboard -->
                            <Button Command="{Binding ShowDashboardCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="DashboardViewModel">
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ActiveTab}" Value="DashboardViewModel"/>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ActiveTab}" Value="DashboardViewModel"/>
                                                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="#F1F5F9" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊" Margin="0,0,12,0" FontSize="16"/>
                                    <TextBlock Text="Tổng quan"/>
                                </StackPanel>
                            </Button>

                            <!-- Apartment -->
                            <Button Command="{Binding ShowApartmentCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="ApartmentViewModel">
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ActiveTab}" Value="ApartmentViewModel"/>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ActiveTab}" Value="ApartmentViewModel"/>
                                                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="#F1F5F9" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏢" Margin="0,0,12,0" FontSize="16"/>
                                    <TextBlock Text="Quản lý Căn hộ"/>
                                </StackPanel>
                            </Button>

                            <!-- Resident -->
                            <Button Command="{Binding ShowResidentCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="ResidentViewModel">
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ActiveTab}" Value="ResidentViewModel"/>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ActiveTab}" Value="ResidentViewModel"/>
                                                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="#F1F5F9" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👥" Margin="0,0,12,0" FontSize="16"/>
                                    <TextBlock Text="Quản lý Cư dân"/>
                                </StackPanel>
                            </Button>

                            <!-- Residency & Member Requests -->
                            <Button Command="{Binding ShowResidencyCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="ResidencyViewModel">
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ActiveTab}" Value="ResidencyViewModel"/>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ActiveTab}" Value="ResidencyViewModel"/>
                                                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="#F1F5F9" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📋" Margin="0,0,12,0" FontSize="16"/>
                                    <TextBlock Text="Quản lý Cư trú"/>
                                </StackPanel>
                            </Button>

                            <!-- Account Management -->
                            <Button Command="{Binding ShowAccountManagementCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="AccountManagementViewModel">
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ActiveTab}" Value="AccountManagementViewModel"/>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ActiveTab}" Value="AccountManagementViewModel"/>
                                                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="#F1F5F9" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙" Margin="0,0,12,0" FontSize="16"/>
                                    <TextBlock Text="Quản lý Tài khoản"/>
                                </StackPanel>
                            </Button>

                            <!-- Vehicle -->
                            <Button Command="{Binding ShowVehicleCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="VehicleViewModel">
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ActiveTab}" Value="VehicleViewModel"/>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ActiveTab}" Value="VehicleViewModel"/>
                                                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="#F1F5F9" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚗" Margin="0,0,12,0" FontSize="16"/>
                                    <TextBlock Text="Quản lý Phương tiện"/>
                                </StackPanel>
                            </Button>

                            <!-- Statistics -->
                            <Button Command="{Binding ShowStatisticsCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="StatisticsViewModel">
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ActiveTab}" Value="StatisticsViewModel"/>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ActiveTab}" Value="StatisticsViewModel"/>
                                                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="#F1F5F9" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📈" Margin="0,0,12,0" FontSize="16"/>
                                    <TextBlock Text="Báo cáo Thống kê"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- RESIDENT MENU (Khớp 100% 5 màn hình theo ảnh thiết kế) -->
                        <StackPanel Visibility="{Binding IsResident, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <!-- 1. Trang chủ -->
                            <Button Command="{Binding ShowResidentHomeCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="ResidentHomeViewModel">
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ActiveTab}" Value="ResidentHomeViewModel"/>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ActiveTab}" Value="ResidentHomeViewModel"/>
                                                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="#F1F5F9" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏠" Margin="0,0,12,0" FontSize="16"/>
                                    <TextBlock Text="Trang chủ"/>
                                </StackPanel>
                            </Button>

                            <!-- 2. Hồ sơ cá nhân -->
                            <Button Command="{Binding ShowMyProfileCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="MyProfileViewModel">
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ActiveTab}" Value="MyProfileViewModel"/>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ActiveTab}" Value="MyProfileViewModel"/>
                                                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="#F1F5F9" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👤" Margin="0,0,12,0" FontSize="16"/>
                                    <TextBlock Text="Hồ sơ cá nhân"/>
                                </StackPanel>
                            </Button>

                            <!-- 3. Căn hộ của tôi -->
                            <Button Command="{Binding ShowMyApartmentCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="MyApartmentViewModel">
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ActiveTab}" Value="MyApartmentViewModel"/>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ActiveTab}" Value="MyApartmentViewModel"/>
                                                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="#F1F5F9" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏢" Margin="0,0,12,0" FontSize="16"/>
                                    <TextBlock Text="Căn hộ của tôi"/>
                                </StackPanel>
                            </Button>

                            <!-- 4. Thành viên cùng căn hộ -->
                            <Button Command="{Binding ShowFamilyMembersCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="FamilyMembersViewModel">
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ActiveTab}" Value="FamilyMembersViewModel"/>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ActiveTab}" Value="FamilyMembersViewModel"/>
                                                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="#F1F5F9" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👥" Margin="0,0,12,0" FontSize="16"/>
                                    <TextBlock Text="Thành viên cùng căn hộ"/>
                                </StackPanel>
                            </Button>

                            <!-- 5. Phương tiện của tôi -->
                            <Button Command="{Binding ShowMyVehiclesCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="MyVehiclesViewModel">
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ActiveTab}" Value="MyVehiclesViewModel"/>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ActiveTab}" Value="MyVehiclesViewModel"/>
                                                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="#F1F5F9" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚗" Margin="0,0,12,0" FontSize="16"/>
                                    <TextBlock Text="Phương tiện của tôi"/>
                                </StackPanel>
                            </Button>

                            <!-- 6. Lịch sử cư trú -->
                            <Button Command="{Binding ShowResidencyHistoryCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTab}" Value="ResidencyHistoryViewModel">
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ActiveTab}" Value="ResidencyHistoryViewModel"/>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ActiveTab}" Value="ResidencyHistoryViewModel"/>
                                                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="#F1F5F9" />
                                                <Setter Property="Foreground" Value="#1D4ED8" />
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🕒" Margin="0,0,12,0" FontSize="16"/>
                                    <TextBlock Text="Lịch sử cư trú"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 4. Chân Sidebar: Ảnh tòa nhà minh họa & Nút Đăng xuất -->
                <StackPanel Grid.Row="3" Margin="14,0,14,16">
                    <!-- Ảnh tòa nhà theo yêu cầu căn chỉnh chuẩn vị trí mẫu -->
                    <Image Source="/Assets/sidebar_buildings.png"
                           Height="130"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- Nút Đăng xuất bo viền theo đúng mẫu ảnh 2 -->
                    <Button Command="{Binding LogoutCommand}" Cursor="Hand" Height="42">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#15FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#93C5FD"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="14,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="10">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="🚪" FontSize="15" Margin="0,0,8,0" Foreground="White" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Đăng xuất" Foreground="White" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#35FFFFFF"/>
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             NỘI DUNG CHÍNH (BÊN PHẢI)
        ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1" Background="#F8FAFC">
            <Grid.RowDefinitions>
                <RowDefinition Height="74"/> <!-- Topbar Header -->
                <RowDefinition Height="*"/>  <!-- Main View Content -->
            </Grid.RowDefinitions>

            <!-- Topbar: Chuẩn theo mockup với lời chào, chuông thông báo & avatar -->
            <Border Grid.Row="0" Background="White" BorderThickness="0,0,0,1" BorderBrush="#E2E8F0">
                <Grid Margin="28,0">
                    <!-- Lời chào bên trái -->
                    <StackPanel VerticalAlignment="Center" Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="HỆ THỐNG QUẢN LÝ CƯ TRÚ" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Khu vực Quản trị viên • Quản lý Căn hộ, Cư dân và Cư trú"
                                   FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Visibility="{Binding IsResident, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding ResidentGreeting}" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Chào mừng bạn đến với Cổng thông tin cư dân Chung cư ResidenceManager."
                                   FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Bên phải: Chuông thông báo & Avatar dropdown -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Chuông thông báo có badge đỏ (Hiển thị cho CẢ ADMIN VÀ CƯ DÂN cạnh logo/avatar) -->
                        <Grid Margin="0,0,18,0" Cursor="Hand">
                            <Grid.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleNotificationCenterCommand}"/>
                            </Grid.InputBindings>
                            <Border Width="40" Height="40" CornerRadius="20" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1">
                                <TextBlock Text="🔔" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- Badge số thông báo chưa đọc động từ CSDL -->
                            <Border Width="20" Height="20" CornerRadius="10" Background="#EF4444" BorderBrush="White" BorderThickness="1.5"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"
                                    Visibility="{Binding HasUnreadNotifications, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding UnreadNotificationsCountText}" FontSize="10" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Avatar góc phải -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand">
                            <StackPanel.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding ShowMyProfileCommand}"/>
                            </StackPanel.InputBindings>
                            <!-- Cho Cư dân -->
                            <Border Width="38" Height="38" CornerRadius="19" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1.5" Margin="0,0,6,0" ClipToBounds="True"
                                    Visibility="{Binding IsResident, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Image Source="/Assets/resident_avatar.png" Stretch="UniformToFill"/>
                            </Border>
                            <!-- Cho Admin -->
                            <Border Width="38" Height="38" CornerRadius="19" Background="#065F46" Margin="0,0,6,0"
                                    Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="🛡️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="⌵" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dynamic Content Control -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}"/>

            <!-- ══════════════════════════════════════════════════════════
                 TRUNG TÂM THÔNG BÁO (NOTIFICATION CENTER - XU HƯỚNG 2026)
            ══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Grid.RowSpan="2"
                  Visibility="{Binding IsNotificationCenterOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!-- Nền trong suốt click để đóng khi bấm ra ngoài -->
                <Border Background="#20000000">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding CloseNotificationCenterCommand}"/>
                    </Border.InputBindings>
                </Border>

                <!-- Panel nổi Trung tâm Thông báo ở góc trên bên phải -->
                <Border Width="560" MaxHeight="700" Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,68,24,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.18"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header -->
                            <RowDefinition Height="Auto"/> <!-- Tabs (Admin) -->
                            <RowDefinition Height="*"/>    <!-- Content (List / Compose) -->
                        </Grid.RowDefinitions>

                        <!-- Header Trung tâm thông báo -->
                        <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="16,16,0,0" BorderThickness="0,0,0,1" BorderBrush="#E2E8F0" Padding="18,14">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="34" Height="34" CornerRadius="10" Background="#EFF6FF" Margin="0,0,10,0">
                                        <TextBlock Text="🔔" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Trung tâm Thông báo" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                        <TextBlock Text="{Binding PortalSubtitle}" FontSize="11" Foreground="#64748B"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Nút thao tác nhanh bên phải -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- Làm mới -->
                                    <Button Command="{Binding RefreshNotificationsCommand}" ToolTip="Làm mới thông báo"
                                            Background="#F1F5F9" BorderThickness="0" Width="32" Height="32" Cursor="Hand" Margin="0,0,6,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                                    <TextBlock Text="🔄" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Đánh dấu đã đọc tất cả -->
                                    <Button Command="{Binding MarkAllNotificationsAsReadCommand}" ToolTip="Đánh dấu tất cả đã đọc"
                                            Background="#F1F5F9" BorderThickness="0" Padding="8,4" Cursor="Hand" Margin="0,0,8,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <TextBlock Text="✓ Đã đọc hết" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Đóng -->
                                    <Button Command="{Binding CloseNotificationCenterCommand}" ToolTip="Đóng"
                                            Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                                    <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Thanh chuyển Tab (Chỉ hiển thị cho Quản trị viên) -->
                        <Border Grid.Row="1" Background="#FFFFFF" BorderThickness="0,0,0,1" BorderBrush="#E2E8F0" Padding="16,10,16,0"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <!-- Tab 1: Thông báo & Đơn duyệt -->
                                <RadioButton Content="📥 Thông báo &amp; Đơn duyệt" GroupName="NotifTabs"
                                             IsChecked="{Binding SelectedNotificationTab, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}"
                                             Cursor="Hand" Margin="0,0,12,0" Padding="12,8">
                                    <RadioButton.Style>
                                        <Style TargetType="RadioButton">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="RadioButton">
                                                        <Border x:Name="bd" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                                                            <TextBlock x:Name="tb" Text="{TemplateBinding Content}" FontSize="13" FontWeight="SemiBold" Foreground="#64748B"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="bd" Property="BorderBrush" Value="#2563EB"/>
                                                                <Setter TargetName="tb" Property="Foreground" Value="#2563EB"/>
                                                                <Setter TargetName="tb" Property="FontWeight" Value="Bold"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </RadioButton.Style>
                                </RadioButton>

                                <!-- Tab 2: Soạn thông báo mới -->
                                <RadioButton Content="✍️ Tạo thông báo mới" GroupName="NotifTabs"
                                             IsChecked="{Binding SelectedNotificationTab, Converter={StaticResource IntToBoolConverter}, ConverterParameter=1}"
                                             Cursor="Hand" Padding="12,8">
                                    <RadioButton.Style>
                                        <Style TargetType="RadioButton">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="RadioButton">
                                                        <Border x:Name="bd" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                                                            <TextBlock x:Name="tb" Text="{TemplateBinding Content}" FontSize="13" FontWeight="SemiBold" Foreground="#64748B"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="bd" Property="BorderBrush" Value="#2563EB"/>
                                                                <Setter TargetName="tb" Property="Foreground" Value="#2563EB"/>
                                                                <Setter TargetName="tb" Property="FontWeight" Value="Bold"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </RadioButton.Style>
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <!-- Content Grid: Đổi theo Tab được chọn -->
                        <Grid Grid.Row="2">
                            <!-- ════════ TAB 1: DANH SÁCH THÔNG BÁO & ĐƠN DUYỆT ════════ -->
                            <Grid Visibility="{Binding SelectedNotificationTab, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=0}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Filter Chips -->
                                    <RowDefinition Height="*"/>    <!-- List -->
                                </Grid.RowDefinitions>

                                <!-- Bộ lọc nhanh -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,10,16,6">
                                    <Button Command="{Binding FilterNotificationsCommand}" CommandParameter="Tất cả" Content="Tất cả"
                                            Padding="10,4" Margin="0,0,6,0" Cursor="Hand" BorderThickness="0" FontSize="12" FontWeight="SemiBold">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                <Setter Property="Foreground" Value="#475569"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedNotificationFilter}" Value="Tất cả">
                                                        <Setter Property="Background" Value="#2563EB"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="12" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button Command="{Binding FilterNotificationsCommand}" CommandParameter="Chưa đọc" Content="Chưa đọc"
                                            Padding="10,4" Margin="0,0,6,0" Cursor="Hand" BorderThickness="0" FontSize="12" FontWeight="SemiBold">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                <Setter Property="Foreground" Value="#475569"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedNotificationFilter}" Value="Chưa đọc">
                                                        <Setter Property="Background" Value="#EF4444"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="12" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button Command="{Binding FilterNotificationsCommand}" CommandParameter="Đơn duyệt" Content="Đơn duyệt"
                                            Padding="10,4" Margin="0,0,6,0" Cursor="Hand" BorderThickness="0" FontSize="12" FontWeight="SemiBold"
                                            Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                <Setter Property="Foreground" Value="#475569"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedNotificationFilter}" Value="Đơn duyệt">
                                                        <Setter Property="Background" Value="#059669"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="12" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button Command="{Binding FilterNotificationsCommand}" CommandParameter="Thông báo" Content="Thông báo"
                                            Padding="10,4" Cursor="Hand" BorderThickness="0" FontSize="12" FontWeight="SemiBold">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                <Setter Property="Foreground" Value="#475569"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedNotificationFilter}" Value="Thông báo">
                                                        <Setter Property="Background" Value="#D97706"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="12" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>

                                <!-- ScrollViewer Danh sách -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,4,14,14">
                                    <StackPanel>
                                        <!-- Trạng thái trống -->
                                        <Border Visibility="{Binding FilteredNotifications.Count, Converter={StaticResource ZeroToVisibilityConverter}}"
                                                Padding="20,40" HorizontalAlignment="Center">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="📭" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                                <TextBlock Text="Không có thông báo nào" FontSize="14" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Các thông báo mới hoặc đơn duyệt sẽ hiển thị tại đây." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- ItemsControl Danh sách Thông báo -->
                                        <ItemsControl ItemsSource="{Binding FilteredNotifications}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,4" Padding="14,12" CornerRadius="12" BorderThickness="1" Cursor="Hand">
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick"
                                                                          Command="{Binding DataContext.OpenNotificationItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          CommandParameter="{Binding}"/>
                                                        </Border.InputBindings>
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="White"/>
                                                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                                                        <Setter Property="Background" Value="#F8FAFC"/>
                                                                        <Setter Property="BorderBrush" Value="#93C5FD"/>
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#F1F5F9"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Icon tròn phân loại -->
                                                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                                                                    Background="{Binding TypeBadgeBg}" Margin="0,0,12,0" VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding TypeIcon}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>

                                                            <!-- Nội dung thẻ thông báo -->
                                                            <StackPanel Grid.Column="1">
                                                                <!-- Hàng tag phân loại & Thời gian -->
                                                                <Grid Margin="0,0,0,4">
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <!-- Badge Phân loại -->
                                                                        <Border Background="{Binding TypeBadgeBg}" CornerRadius="6" Padding="6,2" Margin="0,0,6,0">
                                                                            <TextBlock Text="{Binding TypeName}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding TypeBadgeFg}"/>
                                                                        </Border>
                                                                        <!-- Badge Khẩn cấp / Quan trọng nếu có -->
                                                                        <Border Background="{Binding PriorityBadgeBg}" CornerRadius="6" Padding="6,2" Margin="0,0,6,0"
                                                                                Visibility="{Binding HasPriorityBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                            <TextBlock Text="{Binding PriorityBadgeText}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding PriorityBadgeFg}"/>
                                                                        </Border>
                                                                        <!-- Chấm xanh chưa đọc -->
                                                                        <Border Width="8" Height="8" CornerRadius="4" Background="#2563EB" Margin="0,0,6,0"
                                                                                VerticalAlignment="Center" Visibility="{Binding IsUnread, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                    </StackPanel>

                                                                    <!-- Thời gian gửi -->
                                                                    <TextBlock Text="{Binding TimeAgoText}" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                                </Grid>

                                                                <!-- Tiêu đề -->
                                                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap" Margin="0,0,0,3"/>

                                                                <!-- Người gửi -->
                                                                <TextBlock Text="{Binding SenderName, StringFormat='Gửi bởi: {0}'}" FontSize="11" Foreground="#64748B" Margin="0,0,0,6"/>

                                                                <!-- Nút điều hướng trực tiếp nếu là đơn duyệt -->
                                                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsApprovalRequest, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="10,5">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="👉 Chuyển đến đơn duyệt để xử lý" FontSize="11.5" FontWeight="SemiBold" Foreground="#1D4ED8" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <!-- ════════ TAB 2: SOẠN VÀ GỬI THÔNG BÁO MỚI (ADMIN) ════════ -->
                            <Grid Visibility="{Binding SelectedNotificationTab, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=1}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,12">
                                    <StackPanel>
                                        <!-- Tiêu đề thông báo (Đã chỉnh to rõ ràng, dễ nhìn) -->
                                        <TextBlock Text="Tiêu đề thông báo *" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding NewNotificationTitle, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="42" FontSize="14" FontWeight="Medium" Foreground="#0F172A"
                                                 Padding="12,0" VerticalContentAlignment="Center"
                                                 BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,14"/>

                                        <!-- Loại thông báo & Mức độ ưu tiên -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Loại thông báo -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Loại thông báo" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                                <ComboBox SelectedValue="{Binding NewNotificationType}" SelectedValuePath="Tag" Height="36">
                                                    <ComboBoxItem Content="📢 Thông báo chung" Tag="{x:Static enums:NotificationType.General}" IsSelected="True"/>
                                                    <ComboBoxItem Content="🛠️ Bảo trì - Kỹ thuật" Tag="{x:Static enums:NotificationType.Maintenance}"/>
                                                    <ComboBoxItem Content="💳 Phí dịch vụ" Tag="{x:Static enums:NotificationType.FeeNotice}"/>
                                                    <ComboBoxItem Content="🚨 Thông báo khẩn cấp" Tag="{x:Static enums:NotificationType.UrgentNotice}"/>
                                                </ComboBox>
                                            </StackPanel>

                                            <!-- Mức độ ưu tiên -->
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Mức độ ưu tiên" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                                <ComboBox SelectedValue="{Binding NewNotificationPriority}" SelectedValuePath="Tag" Height="36">
                                                    <ComboBoxItem Content="Bình thường" Tag="{x:Static enums:NotificationPriority.Normal}" IsSelected="True"/>
                                                    <ComboBoxItem Content="⚡ Quan trọng" Tag="{x:Static enums:NotificationPriority.Important}"/>
                                                    <ComboBoxItem Content="🔥 Khẩn cấp" Tag="{x:Static enums:NotificationPriority.Urgent}"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <!-- ══════════════════════════════════════════════════════════
                                             SOẠN THẢO WYSIWYG TRỰC TIẾP NHƯ WORD (GỘP NỘI DUNG & XEM TRƯỚC VÀO 1 TRƯỜNG)
                                        ══════════════════════════════════════════════════════════ -->
                                        <TextBlock Text="Nội dung thông báo *" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                        <controls:RichTextEditor DocumentXaml="{Binding NewNotificationContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Margin="0,0,0,16"/>

                                        <!-- Đối tượng nhận thông báo -->
                                        <TextBlock Text="Đối tượng nhận thông báo *" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                        <TextBlock Text="Chỉ các cư dân CÓ TÀI KHOẢN ĐANG HOẠT ĐỘNG mới nhận được thông báo" FontSize="11" Foreground="#059669" FontStyle="Italic" Margin="0,0,0,8"/>

                                        <!-- Radio groups -->
                                        <StackPanel Margin="0,0,0,8">
                                            <RadioButton Content="Toàn bộ cư dân có tài khoản hoạt động" GroupName="Audience"
                                                         IsChecked="{Binding SelectedTargetAudienceIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}"
                                                         Margin="0,0,0,6" Cursor="Hand"/>
                                            <RadioButton Content="Nhóm cư dân đang cư trú" GroupName="Audience"
                                                         IsChecked="{Binding SelectedTargetAudienceIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=1}"
                                                         Margin="0,0,0,6" Cursor="Hand"/>
                                            <RadioButton Content="Nhóm cư dân đã chuyển đi" GroupName="Audience"
                                                         IsChecked="{Binding SelectedTargetAudienceIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=2}"
                                                         Margin="0,0,0,6" Cursor="Hand"/>
                                            <RadioButton Content="Chọn cư dân cụ thể trong danh sách..." GroupName="Audience"
                                                         IsChecked="{Binding SelectedTargetAudienceIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=3}"
                                                         Margin="0,0,0,6" Cursor="Hand"/>
                                        </StackPanel>

                                        <!-- Bảng chọn cư dân cụ thể nếu chọn option 3 -->
                                        <Border Visibility="{Binding IsSpecificResidentsMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,12">
                                            <StackPanel>
                                                <!-- Tìm kiếm nhanh & Chọn tất cả -->
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding ResidentSearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                                             Grid.Column="0" Padding="8,5" FontSize="12" Margin="0,0,8,0"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button Command="{Binding SelectAllResidentsCommand}" Content="Chọn tất cả"
                                                                Padding="8,4" FontSize="11" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,4,0" Cursor="Hand"/>
                                                        <Button Command="{Binding DeselectAllResidentsCommand}" Content="Bỏ chọn"
                                                                Padding="8,4" FontSize="11" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Danh sách cư dân hỗ trợ lăn chuột mượt mà -->
                                                <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding FilteredSelectableResidents}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Padding="6,4" Margin="0,2" Background="White" CornerRadius="6" BorderBrush="#F1F5F9" BorderThickness="1">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding FullName}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"/>
                                                                            <TextBlock Text="{Binding Username, StringFormat='Tài khoản: @{0}'}" FontSize="10.5" Foreground="#64748B"/>
                                                                        </StackPanel>
                                                                        <Border Grid.Column="2" Background="#EFF6FF" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding ApartmentInfo}" FontSize="10.5" Foreground="#2563EB"/>
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Border>

                                        <!-- Thông báo lỗi khi gửi nếu có -->
                                        <TextBlock Text="{Binding NotificationSendError}" Foreground="#DC2626" FontSize="12" FontWeight="SemiBold"
                                                   Margin="0,0,0,8" TextWrapping="Wrap"
                                                   Visibility="{Binding NotificationSendError, Converter={StaticResource StringToVisibilityConverter}}"/>

                                        <!-- Hàng nút hành động: Xem trước & Phát hành thông báo -->
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="1.4*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Nút Xem trước thông báo -->
                                            <Button Grid.Column="0" Command="{Binding OpenPreviewNoticeCommand}" Height="42"
                                                    Background="#F1F5F9" Foreground="#1E293B" BorderBrush="#CBD5E1" BorderThickness="1"
                                                    FontSize="13" FontWeight="SemiBold" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border CornerRadius="10" Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="👁️" Margin="0,0,6,0" FontSize="14"/>
                                                                <TextBlock Text="Xem trước thông báo" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Nút Phát hành thông báo -->
                                            <Button Grid.Column="2" Command="{Binding SendAnnouncementCommand}" Height="42"
                                                    Background="#2563EB" Foreground="White" BorderThickness="0"
                                                    FontSize="13.5" FontWeight="Bold" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border CornerRadius="10" Background="{TemplateBinding Background}">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="📤" Margin="0,0,8,0" FontSize="14"/>
                                                                <TextBlock Text="Phát hành thông báo" Foreground="White" FontWeight="Bold" FontSize="13.5"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 MODAL XEM TRƯỚC THÔNG BÁO (PREVIEW TRƯỚC KHI GỬI ĐẾN CƯ DÂN)
            ══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Grid.RowSpan="2"
                  Visibility="{Binding IsPreviewNoticeModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!-- Nền mờ Backdrop -->
                <Border Background="#66000000">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding ClosePreviewNoticeCommand}"/>
                    </Border.InputBindings>
                </Border>

                <!-- Thẻ Modal Xem trước giữa màn hình -->
                <Border Width="640" MaxHeight="720" Background="White" CornerRadius="16" Padding="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.25"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header -->
                            <RowDefinition Height="*"/>    <!-- Content Preview Scroll -->
                            <RowDefinition Height="Auto"/> <!-- Footer Actions -->
                        </Grid.RowDefinitions>

                        <!-- Header Modal Xem trước -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="10" Background="#EFF6FF" Margin="0,0,12,0">
                                    <TextBlock Text="👁️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Xem trước thông báo trước khi gửi" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                    <TextBlock Text="Vui lòng kiểm tra kỹ tiêu đề, nội dung và đối tượng nhận trước khi phát hành" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Command="{Binding ClosePreviewNoticeCommand}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Hand">
                                <TextBlock Text="✕" FontSize="16" FontWeight="Bold" Foreground="#94A3B8"/>
                            </Button>
                        </Grid>

                        <!-- Khung nội dung xem trước tổng thể -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="480" Margin="0,0,0,18" Padding="0,0,8,0">
                            <StackPanel>
                                <!-- Thẻ tiêu đề & Metadata -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <!-- Hàng Badges: Loại + Mức độ ưu tiên -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Background="{Binding PreviewNoticeTypeBadgeBg}" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding PreviewNoticeTypeName}" FontSize="11.5" FontWeight="Bold" Foreground="{Binding PreviewNoticeTypeBadgeFg}"/>
                                            </Border>
                                            <Border Background="{Binding PreviewNoticePriorityBadgeBg}" CornerRadius="6" Padding="8,3">
                                                <TextBlock Text="{Binding PreviewNoticePriorityName}" FontSize="11.5" FontWeight="Bold" Foreground="{Binding PreviewNoticePriorityBadgeFg}"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Tiêu đề thông báo -->
                                        <TextBlock Text="{Binding PreviewNoticeTitle}" FontSize="16.5" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                        <!-- Đối tượng nhận -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="👥 Đối tượng nhận: " FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                            <TextBlock Text="{Binding PreviewNoticeAudienceText}" FontSize="12" Foreground="#2563EB" FontWeight="Medium" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Nội dung văn bản Rich Text (Bảng, Ảnh, Chữ đậm, Màu sắc...) -->
                                <TextBlock Text="Nội dung hiển thị thực tế tới cư dân:" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="18">
                                    <RichTextBox helpers:FlowDocumentHelper.DocumentContent="{Binding PreviewNoticeContent}"
                                                 IsReadOnly="True" IsDocumentEnabled="True" Focusable="True"
                                                 Background="Transparent" BorderThickness="0"
                                                 FontSize="13.5" FontFamily="Segoe UI" Foreground="#1E293B">
                                        <FlowDocument PagePadding="0"/>
                                    </RichTextBox>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Footer: Nút quay lại chỉnh sửa & Nút xác nhận phát hành -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1.3*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Command="{Binding ClosePreviewNoticeCommand}" Content="✕ Quay lại chỉnh sửa"
                                    Height="40" Background="#F1F5F9" Foreground="#334155" FontSize="13" FontWeight="SemiBold"
                                    Cursor="Hand" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="10" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Grid.Column="2" Command="{Binding ConfirmSendFromPreviewCommand}" Height="40"
                                    Background="#2563EB" Foreground="White" FontSize="13.5" FontWeight="Bold"
                                    Cursor="Hand" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="10" Background="{TemplateBinding Background}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="📤" Margin="0,0,8,0" FontSize="14"/>
                                                <TextBlock Text="Xác nhận phát hành ngay" Foreground="White" FontWeight="Bold" FontSize="13.5"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 MODAL XEM CHI TIẾT THÔNG BÁO (POPUP RICH TEXT 2026)
            ══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Grid.RowSpan="2"
                  Visibility="{Binding IsNotificationDetailModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!-- Nền mờ Backdrop -->
                <Border Background="#66000000">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding CloseNotificationDetailModalCommand}"/>
                    </Border.InputBindings>
                </Border>

                <!-- Thẻ Modal Chi tiết giữa màn hình -->
                <Border Width="560" MaxHeight="620" Background="White" CornerRadius="16" Padding="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.25"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header -->
                            <RowDefinition Height="*"/>    <!-- Content Scroll -->
                            <RowDefinition Height="Auto"/> <!-- Footer -->
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="42" Height="42" CornerRadius="21" Background="{Binding SelectedNotificationDetail.TypeBadgeBg}" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding SelectedNotificationDetail.TypeIcon}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedNotificationDetail.Title}" FontSize="16" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding SelectedNotificationDetail.SenderName, StringFormat='Gửi bởi: {0}'}" FontSize="12" Foreground="#64748B" Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding SelectedNotificationDetail.TimeAgoText}" FontSize="12" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <Button Command="{Binding CloseNotificationDetailModalCommand}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Hand">
                                <TextBlock Text="✕" FontSize="16" FontWeight="Bold" Foreground="#94A3B8"/>
                            </Button>
                        </Grid>

                        <!-- Nội dung Rich Text (Hỗ trợ Bảng, Hình ảnh, Màu sắc, Chữ đậm...) -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="400" Margin="0,0,0,16" Padding="0,0,8,0">
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18">
                                <RichTextBox helpers:FlowDocumentHelper.DocumentContent="{Binding SelectedNotificationDetail.Content}"
                                             IsReadOnly="True" IsDocumentEnabled="True" Focusable="True"
                                             Background="Transparent" BorderThickness="0"
                                             FontSize="13.5" FontFamily="Segoe UI" Foreground="#1E293B">
                                    <FlowDocument PagePadding="0"/>
                                </RichTextBox>
                            </Border>
                        </ScrollViewer>

                        <!-- Footer -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding CloseNotificationDetailModalCommand}" Content="Đóng"
                                    Width="100" Height="38" Background="#F1F5F9" Foreground="#334155" FontSize="13" FontWeight="SemiBold"
                                    Cursor="Hand" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 TOAST THÔNG BÁO NỔI GÓC PHẢI DƯỚI (FLOATING TOAST CARD)
            ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"
                    MaxWidth="480" Background="#16A34A" CornerRadius="10" Padding="16,12"
                    Visibility="{Binding IsToastVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.25"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="✓" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding ToastMessage}" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <Button Grid.Column="2" Command="{Binding CloseToastCommand}" Background="Transparent" BorderThickness="0" Margin="10,0,0,0" Cursor="Hand" VerticalAlignment="Center">
                        <TextBlock Text="✕" FontSize="12" Foreground="White"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
