<UserControl x:Class="ApartmentResidenceManagement.Wpf.Controls.RichTextEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="280" d:DesignWidth="600">

    <UserControl.Resources>
        <!-- Style nút bấm trên thanh công cụ -->
        <Style x:Key="ToolbarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút bảng màu nhỏ -->
        <Style x:Key="ColorSwatchBtn" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="4" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Background="#FFFFFF">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Thanh công cụ Ribbon Toolbar -->
                <RowDefinition Height="*"/>    <!-- Vùng soạn thảo RichTextBox -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════════
                 THANH CÔNG CỤ SOẠN THẢO VĂN BẢN (RICH TEXT TOOLBAR)
            ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                    CornerRadius="7,7,0,0" Padding="8,5">
                <WrapPanel VerticalAlignment="Center">
                    <!-- 1. Cỡ chữ (Font Size) -->
                    <ComboBox x:Name="FontSizeCombo" Width="72" Height="28" Margin="0,0,4,0"
                              SelectionChanged="FontSizeCombo_SelectionChanged" Focusable="False"
                              ToolTip="Cỡ chữ">
                        <ComboBoxItem Content="11 pt" Tag="11"/>
                        <ComboBoxItem Content="12 pt" Tag="12"/>
                        <ComboBoxItem Content="13 pt" Tag="13" IsSelected="True"/>
                        <ComboBoxItem Content="14 pt" Tag="14"/>
                        <ComboBoxItem Content="16 pt" Tag="16"/>
                        <ComboBoxItem Content="18 pt" Tag="18"/>
                        <ComboBoxItem Content="20 pt" Tag="20"/>
                        <ComboBoxItem Content="24 pt" Tag="24"/>
                    </ComboBox>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,2"/>

                    <!-- 2. Tô đậm (Bold) -->
                    <Button Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=EditorBox}"
                            Style="{StaticResource ToolbarBtn}" ToolTip="In đậm (Ctrl+B)">
                        <TextBlock Text="B" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                    </Button>

                    <!-- 3. In nghiêng (Italic) -->
                    <Button Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=EditorBox}"
                            Style="{StaticResource ToolbarBtn}" ToolTip="In nghiêng (Ctrl+I)">
                        <TextBlock Text="I" FontStyle="Italic" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A"/>
                    </Button>

                    <!-- 4. Gạch chân (Underline) -->
                    <Button Command="EditingCommands.ToggleUnderline" CommandTarget="{Binding ElementName=EditorBox}"
                            Style="{StaticResource ToolbarBtn}" ToolTip="Gạch chân (Ctrl+U)">
                        <TextBlock Text="U" TextDecorations="Underline" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A"/>
                    </Button>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,2"/>

                    <!-- 5. Đổi màu chữ (Text Color Picker) -->
                    <Grid>
                        <Button x:Name="TextColorBtn" Click="TextColorBtn_Click" Style="{StaticResource ToolbarBtn}" ToolTip="Đổi màu chữ">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="A" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A"/>
                                <Border x:Name="ColorBar" Width="14" Height="3.5" Background="#2563EB" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Popup Bảng chọn màu chữ & Nhập mã màu HEX -->
                        <Popup x:Name="ColorPickerPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom">
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,4,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.15"/>
                                </Border.Effect>
                                <StackPanel Width="180">
                                    <TextBlock Text="Chọn màu chữ:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,6"/>
                                    <!-- 8 ô màu thịnh hành -->
                                    <WrapPanel Margin="0,0,0,8">
                                        <Button Style="{StaticResource ColorSwatchBtn}" Background="#0F172A" Click="ApplyColorSwatch_Click" Tag="#0F172A" ToolTip="Đen"/>
                                        <Button Style="{StaticResource ColorSwatchBtn}" Background="#2563EB" Click="ApplyColorSwatch_Click" Tag="#2563EB" ToolTip="Xanh dương"/>
                                        <Button Style="{StaticResource ColorSwatchBtn}" Background="#DC2626" Click="ApplyColorSwatch_Click" Tag="#DC2626" ToolTip="Đỏ"/>
                                        <Button Style="{StaticResource ColorSwatchBtn}" Background="#059669" Click="ApplyColorSwatch_Click" Tag="#059669" ToolTip="Xanh lá"/>
                                        <Button Style="{StaticResource ColorSwatchBtn}" Background="#D97706" Click="ApplyColorSwatch_Click" Tag="#D97706" ToolTip="Cam"/>
                                        <Button Style="{StaticResource ColorSwatchBtn}" Background="#7C3AED" Click="ApplyColorSwatch_Click" Tag="#7C3AED" ToolTip="Tím"/>
                                        <Button Style="{StaticResource ColorSwatchBtn}" Background="#64748B" Click="ApplyColorSwatch_Click" Tag="#64748B" ToolTip="Xám"/>
                                        <Button Style="{StaticResource ColorSwatchBtn}" Background="#DB2777" Click="ApplyColorSwatch_Click" Tag="#DB2777" ToolTip="Hồng"/>
                                    </WrapPanel>

                                    <!-- Nhập mã màu HEX tùy ý -->
                                    <TextBlock Text="Hoặc nhập mã màu (HEX):" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="HexColorInput" Text="#2563EB" FontSize="11.5" Height="28" Padding="6,2" VerticalContentAlignment="Center" Margin="0,0,4,0"/>
                                        <Button Grid.Column="1" Content="Áp dụng" FontSize="11" Height="28" Padding="8,2" Click="ApplyHexColor_Click" Cursor="Hand" Background="#2563EB" Foreground="White" BorderThickness="0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="4" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,2"/>

                    <!-- 6. Căn lề (Align Left, Center, Right) -->
                    <Button Command="EditingCommands.AlignLeft" CommandTarget="{Binding ElementName=EditorBox}"
                            Style="{StaticResource ToolbarBtn}" ToolTip="Căn trái">
                        <TextBlock Text="⫷" FontSize="13" Foreground="#334155"/>
                    </Button>
                    <Button Command="EditingCommands.AlignCenter" CommandTarget="{Binding ElementName=EditorBox}"
                            Style="{StaticResource ToolbarBtn}" ToolTip="Căn giữa">
                        <TextBlock Text="≡" FontSize="14" FontWeight="Bold" Foreground="#334155"/>
                    </Button>
                    <Button Command="EditingCommands.AlignRight" CommandTarget="{Binding ElementName=EditorBox}"
                            Style="{StaticResource ToolbarBtn}" ToolTip="Căn phải">
                        <TextBlock Text="⫸" FontSize="13" Foreground="#334155"/>
                    </Button>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,2"/>

                    <!-- 7. Danh sách dấu đầu dòng (Bullet List) -->
                    <Button Command="EditingCommands.ToggleBullets" CommandTarget="{Binding ElementName=EditorBox}"
                            Style="{StaticResource ToolbarBtn}" ToolTip="Danh sách dấu đầu dòng (Bullets)">
                        <TextBlock Text="•≡" FontSize="13" FontWeight="Bold" Foreground="#334155"/>
                    </Button>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,2"/>

                    <!-- 8. Chèn Bảng (Insert Table) -->
                    <Button x:Name="InsertTableBtn" Click="InsertTableBtn_Click" Style="{StaticResource ToolbarBtn}" ToolTip="Chèn bảng dữ liệu mẫu">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⊞" FontSize="13" Margin="0,0,3,0" Foreground="#2563EB"/>
                            <TextBlock Text="Bảng" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155"/>
                        </StackPanel>
                    </Button>

                    <!-- 9. Chèn Ảnh (Insert Image) -->
                    <Button x:Name="InsertImageBtn" Click="InsertImageBtn_Click" Style="{StaticResource ToolbarBtn}" ToolTip="Chèn hình ảnh từ máy tính">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖼" FontSize="13" Margin="0,0,3,0"/>
                            <TextBlock Text="Ảnh" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 KHUNG SOẠN THẢO TRỰC TIẾP WYSIWYG NHƯ WORD (RICHTEXTBOX)
            ══════════════════════════════════════════════════════════ -->
            <RichTextBox Grid.Row="1" x:Name="EditorBox"
                         AcceptsReturn="True" AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         MinHeight="170" MaxHeight="270"
                         FontSize="13.5" FontFamily="Segoe UI" Foreground="#0F172A"
                         Padding="14,10" BorderThickness="0" Background="White"
                         TextChanged="EditorBox_TextChanged">
                <FlowDocument PagePadding="0">
                    <Paragraph Margin="0,0,0,4">
                        <Run Text=""/>
                    </Paragraph>
                </FlowDocument>
            </RichTextBox>
        </Grid>
    </Border>
</UserControl>
